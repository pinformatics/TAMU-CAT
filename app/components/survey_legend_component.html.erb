<aside class="c-sticky-aside" aria-label="Rating scale reference">
  <div class="c-card c-card--flush u-overflow-hidden">
    <div class="c-panel-header c-panel-header--with-border">
      <p class="c-eyebrow">Reference</p>
      <h3 class="c-panel-title"><%= title %></h3>
    </div>
    <div class="c-panel-body u-sticky-scroll u-overflow-y-auto">
      <%= helpers.render_guidance_text(@legend.body, heading_tag: :h3, wrapper_class: "c-rich-text c-rich-text--sm") %>
    </div>
  </div>
</aside>
