<% visible_sources = @payload[:visible_sources] || [] %>
<% show_self = visible_sources.include?("self") %>
<% show_course = visible_sources.include?("course") %>
<% show_target = visible_sources.include?("target") %>
<% show_advisor = @payload[:show_advisor] %>
<% selected_semester_value = @payload.dig(:filters, :semester).presence || @payload[:all_semesters_value] %>
<% selected_semester = @payload.dig(:filters, :semester).presence || "All semesters" %>
<% page_title = @competency_page_title.presence || "My Competencies" %>
<% page_subtitle = @competency_page_subtitle.presence || "Self, course, advisor, and target levels across the selected semester view." %>
<% back_path = @competency_back_path %>
<% form_path = @competency_form_path.presence || student_competencies_path %>
<% filter_params = { semester: selected_semester_value, sources: visible_sources } %>
<% export_path = @competency_export_path.presence || student_competencies_path(filter_params.merge(format: :csv)) %>
<% pdf_path = @competency_pdf_path.presence || student_competencies_path(filter_params.merge(format: :pdf)) %>
<% staff_export_confirm = (current_user&.role_admin? || current_user&.role_advisor?) ? "FERPA reminder: this export includes student-level competency data. Continue only for a legitimate educational interest." : nil %>
<% staff_competency_view = current_user&.role_admin? || current_user&.role_advisor? %>
<% semester_options = [["All semesters", @payload[:all_semesters_value]]] + @payload[:semesters].map { |semester| [semester, semester] } %>
<% change_summary = @payload[:change_summary] || {} %>
<% status_labels = {
  "present" => "Updated",
  "missing" => "Missing data",
  "embargoed" => "Not yet released",
  "no_evidence" => "No course evidence"
} %>
<% guide_items = [
  {
    title: "Self-assessment",
    short_title: "Self",
    body: staff_competency_view ? "The student's survey rating for how confident they feel in a competency." : "Your own survey rating for how confident you feel in a competency."
  },
  {
    title: "Course result",
    short_title: "Course",
    body: "A course-derived rating from released course evidence. It may be missing when no course has contributed evidence yet, or hidden until the release date."
  },
  {
    title: "Course target",
    short_title: "Course target",
    body: "The expected level for a specific course evidence item. It appears inside course source details and answers, \"What was this course aiming for?\""
  },
  {
    title: "End-of-program target",
    short_title: "Program target",
    body: staff_competency_view ? "The program benchmark for the student's track and cohort. Below-target highlighting compares self and course scores against this program-level expectation." : "The program benchmark for your track and cohort. Below-target highlighting compares self and course scores against this program-level expectation."
  }
] %>
<% if staff_competency_view || show_advisor %>
  <% guide_items << {
    title: "Advisor legacy rating",
    short_title: "Advisor",
    body: "Historical advisor-entered competency evidence. Keep it visible for context, but use course-derived evidence as the primary input going forward."
  } %>
<% end %>

<main class="c-main c-page c-competency-page">
  <header class="c-card c-page-header">
    <div class="u-stack u-stack--sm">
      <span class="c-eyebrow"><%= selected_semester %></span>
      <h1 class="c-page-title"><%= page_title %></h1>
      <p class="c-page-subtitle"><%= page_subtitle %></p>
    </div>

    <div class="u-actions no-print">
      <% if back_path.present? %>
        <%= link_to "Back",
              back_path,
              class: button_classes(:ghost),
              data: { turbo: false } %>
      <% end %>

      <%= link_to "Download PDF",
            pdf_path,
            class: button_classes(:secondary),
            data: { turbo: false, turbo_confirm: staff_export_confirm }.compact %>

      <%= link_to "Export CSV",
            export_path,
            class: button_classes(:secondary),
            data: { turbo: false, turbo_confirm: staff_export_confirm }.compact %>
    </div>
  </header>

  <section class="c-card c-card--tight no-print">
    <%= form_with url: form_path, method: :get, local: true, data: { turbo: false }, class: "c-filter-bar c-filter-bar--competencies" do %>
      <div class="c-filter-bar__field">
        <label class="c-label" for="semester">Semester</label>
        <%= select_tag :semester,
              options_for_select(semester_options, selected_semester_value),
              class: "c-select" %>
      </div>

      <fieldset class="c-source-filter">
        <legend>Sources</legend>
        <% @payload[:source_options].each do |source_key, source_label| %>
          <label class="c-check-pill">
            <%= check_box_tag "sources[]", source_key, visible_sources.include?(source_key), id: "source_#{source_key}" %>
            <span><%= source_label %></span>
          </label>
        <% end %>
      </fieldset>

      <%= submit_tag "Apply", class: button_classes(:primary) %>
      <span class="c-status-pill <%= @payload[:course_released] ? 'c-status-pill--success' : 'c-status-pill--warning' %>">
        Course results: <%= @payload[:release_label] %>
      </span>
    <% end %>

    <% if staff_competency_view %>
      <div class="c-competency-guide-tips" aria-label="Competency source guide">
        <span class="c-competency-guide-tips__label">Guide</span>
        <% guide_items.each do |guide| %>
          <span class="c-guide-tip">
            <span><%= guide[:short_title] %></span>
            <%= render "shared/question_tooltip",
                  label: "#{guide[:title]} guide",
                  panel_label: guide[:title],
                  text: guide[:body],
                  width: "20rem",
                  panel_classes: "standard-tooltip-panel--compact" %>
          </span>
        <% end %>
      </div>
    <% end %>
  </section>

  <% if staff_competency_view %>
    <div class="c-staff-competency-workspace">
  <% end %>

  <% unless staff_competency_view %>
    <section class="c-card c-card--tight c-interpretation-guide">
      <div class="c-panel-header">
        <h2 class="c-section-title c-heading-inline">How To Read This Page</h2>
        <span class="c-muted">Plain-language guide</span>
      </div>

      <p class="c-guide-intro">
        Competency scores are meant to show patterns over time. One score is a signal, while repeated scores across semesters and sources give the clearest picture.
      </p>

      <div class="c-guide-grid">
        <% guide_items.each do |guide| %>
          <article class="c-guide-item">
            <h3 class="c-h3"><%= guide[:title] %></h3>
            <p><%= guide[:body] %></p>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="c-card c-card--tight c-change-summary">
    <div class="c-panel-header">
      <h2 class="c-section-title c-heading-inline">What Changed Since Last Semester?</h2>
      <span class="c-muted"><%= change_summary[:current_semester] %></span>
    </div>

    <p class="c-change-headline"><%= change_summary[:headline] %></p>

    <div class="c-change-grid">
      <article class="c-change-panel">
        <h3 class="c-h3">Source Averages</h3>
        <% if change_summary[:source_changes].present? %>
          <ul class="c-change-list">
            <% change_summary[:source_changes].each do |change| %>
              <li class="c-change-list__item c-change-list__item--<%= change[:direction].to_s.parameterize %>">
                <span><%= change[:sentence] %></span>
                <strong><%= number_with_precision(change[:delta], precision: 2, strip_insignificant_zeros: true) %></strong>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="c-muted">No source-level comparison is available yet.</p>
        <% end %>
      </article>

      <article class="c-change-panel">
        <h3 class="c-h3">Largest Competency Moves</h3>
        <% if change_summary[:competency_changes].present? %>
          <ul class="c-change-list">
            <% change_summary[:competency_changes].each do |change| %>
              <li class="c-change-list__item c-change-list__item--<%= change[:direction].to_s.parameterize %>">
                <span><%= change[:label] %>: <%= change[:title] %></span>
                <strong>
                  <%= change[:direction].capitalize %>
                  <%= number_with_precision(change[:delta].abs, precision: 2, strip_insignificant_zeros: true) %>
                </strong>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="c-muted">No competency-level changes were found for the selected sources.</p>
        <% end %>
      </article>
    </div>
  </section>

  <section class="c-card c-card--tight c-competency-summary">
    <div class="c-panel-header">
      <h2 class="c-section-title c-heading-inline">Student Summary</h2>
      <span class="c-muted"><%= selected_semester %></span>
    </div>

    <div class="c-summary-grid">
      <article class="c-summary-item">
        <h3 class="c-h3">Strongest Domains</h3>
        <% if @payload.dig(:summary, :strongest_domains).present? %>
          <ul>
            <% @payload.dig(:summary, :strongest_domains).each do |domain| %>
              <li><%= domain[:name] %> <span><%= number_with_precision(domain[:score], precision: 2, strip_insignificant_zeros: true) %></span></li>
            <% end %>
          </ul>
        <% else %>
          <p>No score data yet.</p>
        <% end %>
      </article>

      <article class="c-summary-item">
        <h3 class="c-h3">Lowest Domains</h3>
        <% if @payload.dig(:summary, :lowest_domains).present? %>
          <ul>
            <% @payload.dig(:summary, :lowest_domains).each do |domain| %>
              <li><%= domain[:name] %> <span><%= number_with_precision(domain[:score], precision: 2, strip_insignificant_zeros: true) %></span></li>
            <% end %>
          </ul>
        <% else %>
          <p>No score data yet.</p>
        <% end %>
      </article>

      <article class="c-summary-item">
        <h3 class="c-h3">Biggest Growth Areas</h3>
        <% if @payload.dig(:summary, :growth_areas).present? %>
          <ul>
            <% @payload.dig(:summary, :growth_areas).each do |area| %>
              <li><%= area[:title] %> <span><%= number_with_precision(area[:current], precision: 2, strip_insignificant_zeros: true) %> / <%= area[:target] %></span></li>
            <% end %>
          </ul>
        <% else %>
          <p>No below-target gaps found.</p>
        <% end %>
      </article>

      <article class="c-summary-item">
        <h3 class="c-h3">Data Status</h3>
        <ul>
          <% if show_self %>
            <li>Missing self ratings <span><%= @payload.dig(:summary, :missing_self_count) %></span></li>
          <% end %>
          <% if show_course %>
            <li>No course evidence <span><%= @payload.dig(:summary, :no_course_evidence_count) %></span></li>
            <li>Not yet released <span><%= @payload.dig(:summary, :embargoed_course_count) %></span></li>
          <% end %>
          <li>Below target <span><%= @payload.dig(:summary, :below_target_count) %></span></li>
        </ul>
      </article>
    </div>
  </section>

  <section class="c-card c-card--tight c-competency-graphs no-print">
    <div class="c-panel-header">
      <h2 class="c-section-title c-heading-inline">Graphs</h2>
      <div class="c-tabs" role="tablist" aria-label="Competency graph views">
        <button type="button" class="c-tab is-active" id="competencySnapshotTab" role="tab" aria-selected="true" aria-controls="competencySnapshotPanel" data-competency-chart-tab="snapshot">
          Competency Snapshot
        </button>
        <button type="button" class="c-tab" id="semesterTrendTab" role="tab" aria-selected="false" aria-controls="semesterTrendPanel" data-competency-chart-tab="trend">
          Semester Trend
        </button>
      </div>
    </div>

    <div class="c-chart-panels">
      <div class="c-chart-panel is-active" id="competencySnapshotPanel" role="tabpanel" aria-labelledby="competencySnapshotTab" data-competency-chart-panel="snapshot">
        <div class="c-chart-frame c-chart-frame--lg">
          <canvas id="competencyRadarChart"></canvas>
        </div>
      </div>

      <div class="c-chart-panel" id="semesterTrendPanel" role="tabpanel" aria-labelledby="semesterTrendTab" data-competency-chart-panel="trend" hidden>
        <div class="c-chart-frame c-chart-frame--lg">
          <canvas id="competencyTrendChart"></canvas>
        </div>
      </div>
    </div>
  </section>

  <% if staff_competency_view %>
    <section class="c-print-section">
      <%= render "staff/competencies/comparison", domains: @payload[:domains] %>
    </section>
  <% else %>
    <section class="u-stack u-stack--lg c-print-section">
      <% @payload[:domains].each do |domain| %>
        <section class="c-card c-card--flush c-section-group">
          <header class="c-section-group__header c-domain-header">
            <div>
              <h2 class="c-section-title"><%= domain[:name] %></h2>
              <span><%= pluralize(domain[:competencies].size, "competency") %></span>
            </div>
            <div class="c-domain-averages" aria-label="<%= domain[:name] %> averages">
              <% if show_self %>
                <span>Self avg <strong><%= domain[:averages][:self].presence || "—" %></strong></span>
              <% end %>
              <% if show_advisor %>
                <span>Advisor avg <strong><%= domain[:averages][:advisor].presence || "—" %></strong></span>
              <% end %>
              <% if show_course %>
                <span>Course avg <strong><%= domain[:averages][:course].presence || "—" %></strong></span>
              <% end %>
              <% if show_target %>
                <span>Target avg <strong><%= domain[:averages][:target].presence || "—" %></strong></span>
              <% end %>
            </div>
          </header>

          <div class="c-table-wrapper">
            <table class="c-table c-matrix-table">
              <thead>
                <tr>
                  <th>Competency</th>
                  <% if show_self %>
                    <th>Self</th>
                  <% end %>
                  <% if show_advisor %>
                    <th>Advisor</th>
                  <% end %>
                  <% if show_course %>
                    <th>Course</th>
                  <% end %>
                  <% if show_target %>
                    <th>End-of-Program Target</th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% domain[:competencies].each do |competency| %>
                  <tr class="<%= 'is-below-target' if competency[:self_below_target] || competency[:course_below_target] %>">
                    <td class="c-table__title"><%= competency[:title] %></td>

                    <% if show_self %>
                      <td>
                        <% self_classes = ["c-score-pill", "c-score-pill--self"] %>
                        <% self_classes << "c-score-pill--below" if competency[:self_below_target] %>
                        <% self_classes << "c-score-pill--empty" if competency[:self_rating].blank? %>
                        <span class="<%= self_classes.join(' ') %>">
                          <%= competency[:self_rating].presence || "—" %>
                        </span>
                        <span class="c-data-status c-data-status--<%= competency[:self_status] %>">
                          <%= status_labels[competency[:self_status]] %>
                        </span>
                        <% if competency[:self_updated_at].present? %>
                          <span class="c-last-updated">Updated <%= l(competency[:self_updated_at], format: :short) %></span>
                        <% end %>
                      </td>
                    <% end %>

                    <% if show_advisor %>
                      <td>
                        <% advisor_classes = ["c-score-pill", "c-score-pill--advisor"] %>
                        <% advisor_classes << "c-score-pill--empty" if competency[:advisor_rating].blank? %>
                        <span class="<%= advisor_classes.join(' ') %>">
                          <%= competency[:advisor_rating].presence || "—" %>
                        </span>
                        <span class="c-data-status c-data-status--<%= competency[:advisor_status] %>">
                          <%= status_labels[competency[:advisor_status]] %>
                        </span>
                        <% if competency[:advisor_updated_at].present? %>
                          <span class="c-last-updated">Updated <%= l(competency[:advisor_updated_at], format: :short) %></span>
                        <% end %>
                      </td>
                    <% end %>

                    <% if show_course %>
                      <td>
                        <% course_value = competency[:course_status] == "embargoed" ? "Embargoed" : competency[:course_rating].presence %>
                        <% if competency[:course_sources].present? %>
                          <details class="c-cell-details">
                            <summary class="c-cell-details__summary">
                              <% course_classes = ["c-score-pill", "c-score-pill--course"] %>
                              <% course_classes << "c-score-pill--below" if competency[:course_below_target] %>
                              <% course_classes << "c-score-pill--empty" if course_value.blank? %>
                              <span class="<%= course_classes.join(' ') %>">
                                <%= course_value.presence || "—" %>
                              </span>
                            </summary>
                            <div class="c-source-list">
                              <span class="c-source-count"><%= pluralize(competency[:course_sources].size, "source") %></span>
                              <% competency[:course_sources].each do |source| %>
                                <div class="c-source-chip">
                                  <strong><%= source[:course_code] %></strong>
                                  <% if source[:semester].present? %>
                                    <span><%= source[:semester] %></span>
                                  <% end %>
                                  <span>Competency level <%= source[:mapped_level].presence || "—" %></span>
                                  <span>Course target level <%= source[:course_target_level].presence || "—" %></span>
                                </div>
                              <% end %>
                            </div>
                          </details>
                        <% else %>
                          <% course_classes = ["c-score-pill"] %>
                          <% course_classes << (competency[:course_status] == "embargoed" ? "c-score-pill--empty" : "c-score-pill--course") %>
                          <% course_classes << "c-score-pill--empty" if course_value.blank? %>
                          <span class="<%= course_classes.join(' ') %>"><%= course_value.presence || "—" %></span>
                        <% end %>
                        <span class="c-data-status c-data-status--<%= competency[:course_status] %>">
                          <%= status_labels[competency[:course_status]] %>
                        </span>
                        <% if competency[:course_updated_at].present? %>
                          <span class="c-last-updated">Updated <%= l(competency[:course_updated_at], format: :short) %></span>
                        <% end %>
                      </td>
                    <% end %>

                    <% if show_target %>
                      <td>
                        <% target_classes = ["c-score-pill", "c-score-pill--program"] %>
                        <% target_classes << "c-score-pill--empty" if competency[:end_program_target].blank? %>
                        <span class="<%= target_classes.join(' ') %>">
                          <%= competency[:end_program_target].presence || "—" %>
                        </span>
                        <span class="c-data-status c-data-status--<%= competency[:target_status] %>">
                          <%= competency[:target_status] == "present" ? "End-of-program expectation" : "Missing end-of-program target" %>
                        </span>
                        <% if competency[:target_updated_at].present? %>
                          <span class="c-last-updated">Updated <%= l(competency[:target_updated_at], format: :short) %></span>
                        <% end %>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>
    </section>
  <% end %>

  <% if staff_competency_view %>
    </div>
  <% end %>
</main>

<script type="module">
  import Chart from "chart.js/auto"

  const radarPayload = <%= raw @payload[:radar_chart].to_json %>
  const trendPayload = <%= raw @payload[:trend_chart].to_json %>
  const colors = {
    Self: ["rgba(80, 0, 0, 0.18)", "#500000"],
    "Self average": ["rgba(80, 0, 0, 0.18)", "#500000"],
    Advisor: ["rgba(37, 99, 235, 0.16)", "#2563eb"],
    "Advisor average": ["rgba(37, 99, 235, 0.16)", "#2563eb"],
    Course: ["rgba(5, 150, 105, 0.16)", "#059669"],
    "Course average": ["rgba(5, 150, 105, 0.16)", "#059669"],
    "End Program Target": ["rgba(124, 58, 237, 0.1)", "#7c3aed"],
    "Target average": ["rgba(124, 58, 237, 0.1)", "#7c3aed"]
  }

  const decorate = (dataset) => {
    const [backgroundColor, borderColor] = colors[dataset.label] || ["rgba(15, 23, 42, 0.1)", "#0f172a"]
    return { ...dataset, backgroundColor, borderColor, borderWidth: 2, pointRadius: 2, spanGaps: true }
  }

  const radarElement = document.getElementById("competencyRadarChart")
  const trendElement = document.getElementById("competencyTrendChart")
  const radarChart = radarElement ? new Chart(radarElement, {
    type: "radar",
    data: { labels: radarPayload.labels, datasets: radarPayload.datasets.map(decorate) },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: { r: { min: 0, max: 5, ticks: { stepSize: 1 } } },
      plugins: { legend: { position: "bottom" } }
    }
  }) : null

  const trendChart = trendElement ? new Chart(trendElement, {
    type: "line",
    data: { labels: trendPayload.labels, datasets: trendPayload.datasets.map(decorate) },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: { y: { min: 0, max: 5, ticks: { stepSize: 1 } } },
      plugins: { legend: { position: "bottom" } }
    }
  }) : null

  const charts = { snapshot: radarChart, trend: trendChart }
  const tabs = document.querySelectorAll("[data-competency-chart-tab]")
  const panels = document.querySelectorAll("[data-competency-chart-panel]")

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const activeView = tab.dataset.competencyChartTab

      tabs.forEach((candidate) => {
        const selected = candidate.dataset.competencyChartTab === activeView
        candidate.classList.toggle("is-active", selected)
        candidate.setAttribute("aria-selected", selected ? "true" : "false")
      })

      panels.forEach((panel) => {
        const selected = panel.dataset.competencyChartPanel === activeView
        panel.classList.toggle("is-active", selected)
        panel.hidden = !selected
      })

      window.requestAnimationFrame(() => charts[activeView]?.resize())
    })
  })
</script>
