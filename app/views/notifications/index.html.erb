<% content_for :title, "Notifications" %>

<% back_path =
  if current_user&.role_admin?
    admin_dashboard_path
  elsif current_user&.role_advisor?
    advisor_dashboard_path
  else
    student_dashboard_path
  end %>

<main class="c-main c-page">
  <div class="u-stack u-stack--md">
    <header class="c-card c-card--compact c-card--brand">
      <div class="c-page-header c-page-header--compact">
        <div>
          <p class="c-eyebrow">Inbox</p>
          <h1 class="c-page-title c-page-title--brand">Notifications</h1>
          <dl class="c-key-value-grid u-mt-sm">
            <div class="c-key-value">
              <dt>Unread</dt>
              <dd><%= @unread_notification_count %></dd>
            </div>
            <div class="c-key-value">
              <dt>Total</dt>
              <dd><%= @total_notifications %></dd>
            </div>
          </dl>
        </div>

        <div class="u-actions">
          <%= link_to "Dashboard", back_path, class: button_classes(:secondary, extra_classes: "btn-sm"), data: { turbo: false } %>
          <% if @unread_notification_count.to_i.positive? %>
            <%= button_to "Mark all read",
                          mark_all_read_notifications_path,
                          method: :patch,
                          class: button_classes(:secondary, extra_classes: "btn-sm") %>
          <% end %>
        </div>
      </div>
    </header>

    <% if @notifications_disabled %>
      <div class="c-card c-card--compact c-card--dashed c-list-item--empty u-stack u-stack--sm">
        <p class="c-strong">In-app notifications are turned off.</p>
        <p class="c-help">Turn them back on from Settings when you want unread items to appear in the navbar and notification center.</p>
        <div class="u-actions u-actions--start">
          <%= link_to "Edit settings", edit_settings_path, class: button_classes(:primary, extra_classes: "btn-sm") %>
        </div>
      </div>
    <% elsif @notifications.blank? %>
      <div class="c-card c-card--compact c-card--dashed c-list-item--empty">
        You're all caught up. New notifications will appear here when something needs attention.
      </div>
    <% else %>
      <div class="c-card c-card--flush c-table-wrapper">
        <table class="c-table c-table--sm c-table--divide">
          <thead>
            <tr>
              <th scope="col">Notification</th>
              <th scope="col">Status</th>
              <th scope="col">Received</th>
              <th scope="col"><span class="sr-only">Action</span></th>
            </tr>
          </thead>
          <tbody>
            <% @notifications.each do |notification| %>
              <% unread = !notification.read? %>
              <% target_path = notification.target_path_for(current_user) %>
              <tr class="c-table-row <%= unread ? 'c-table-row--unread' : 'c-table-row--read' %>">
                <th scope="row">
                  <%= link_to notification.title, notification_path(notification), class: "c-table__title u-link" %>
                  <span class="c-table__meta"><%= truncate(notification.display_message, length: 110) %></span>
                </th>
                <td>
                  <span class="c-status-badge <%= unread ? 'c-status-badge--info' : 'c-status-badge--muted' %>">
                    <%= unread ? "Unread" : "Read" %>
                  </span>
                </td>
                <td class="u-whitespace-nowrap">
                  <time class="c-table__meta" datetime="<%= notification.created_at.iso8601 %>">
                    <%= time_ago_in_words(notification.created_at) %> ago
                  </time>
                </td>
                <td class="u-text-right">
                  <% if target_path.present? %>
                    <%= link_to "Open",
                                notification_path(notification),
                                class: button_classes(:subtle, extra_classes: "btn-sm") %>
                  <% elsif unread %>
                    <%= link_to "Mark read",
                                notification_path(notification),
                                class: button_classes(:subtle, extra_classes: "btn-sm") %>
                  <% else %>
                    <span class="sr-only">No action available</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @total_pages > 1 %>
        <nav class="c-card c-card--compact u-actions u-actions--split">
          <% prev_page = @page - 1 %>
          <% next_page = @page + 1 %>
          <div>
            <% if prev_page >= 1 %>
              <%= link_to "Previous", notifications_path(page: prev_page), class: button_classes(:secondary, extra_classes: "btn-sm") %>
            <% end %>
          </div>
          <p class="c-eyebrow">Page <%= @page %> of <%= @total_pages %></p>
          <div>
            <% if next_page <= @total_pages %>
              <%= link_to "Next", notifications_path(page: next_page), class: button_classes(:secondary, extra_classes: "btn-sm") %>
            <% end %>
          </div>
        </nav>
      <% end %>
    <% end %>
  </div>
</main>
