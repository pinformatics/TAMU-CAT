<% content_for :title, @notification.title %>

<% unread = !@notification.read? %>

<main class="c-main c-page">
  <div class="u-stack u-stack--xl">
    <header class="c-card c-card--spacious c-card--muted <%= 'is-unread' if unread %>">
      <div class="u-responsive-split">
        <div class="u-flex u-flex-1 u-items-start u-gap-lg">
          <div class="u-flex u-size-xl u-shrink-0 u-items-center u-justify-center u-rounded-full c-icon-circle">
            <svg aria-hidden="true" class="u-size-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <% if unread %>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 10-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m1 0v1a2 2 0 004 0v-1m-4 0h4" />
              <% else %>
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              <% end %>
            </svg>
          </div>

          <div class="u-stack u-stack--md">
            <div class="u-actions u-actions--start">
              <p class="c-eyebrow">Notification</p>
              <span class="c-pill <%= unread ? 'c-pill--primary' : 'c-pill--muted' %>"><%= unread ? 'Unread' : 'Read' %></span>
            </div>
            <h1 class="c-h1"><%= @notification.title %></h1>
            <p class="c-help">
              <time datetime="<%= @notification.created_at.iso8601 %>"><%= @notification.created_at.to_fs(:long) %></time>
              <% if @notification.read_at.present? %>
                · Read <%= @notification.read_at.to_fs(:long) %>
              <% end %>
            </p>
          </div>
        </div>

        <div class="u-grid u-w-full u-max-w-sm">
          <div class="c-stat c-stat--muted">
            <p class="c-stat__label">Created</p>
            <p class="c-stat__subtext"><%= @notification.created_at.to_fs(:long) %></p>
          </div>
          <% if @notification.read_at.present? %>
            <div class="c-stat">
              <p class="c-stat__label">Read</p>
              <p class="c-stat__subtext"><%= @notification.read_at.to_fs(:long) %></p>
            </div>
          <% end %>
        </div>
      </div>

      <div class="u-actions u-actions--start mt-xl">
        <%= link_to notifications_path, class: button_classes(:secondary) do %>
          <svg aria-hidden="true" class="u-size-sm" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
          </svg>
          Back to notifications
        <% end %>
        <% if (target_path = @notification.target_path_for(current_user)).present? %>
          <%= link_to target_path, class: button_classes(:primary) do %>
            Open related record
            <svg aria-hidden="true" class="u-size-sm" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L13.586 11H4a1 1 0 110-2h9.586l-3.293-3.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          <% end %>
        <% end %>
      </div>
    </header>

    <section class="u-stack u-stack--xl">
      <div class="c-card c-card--spacious">
        <div class="u-flex u-items-center u-gap-md">
          <div class="u-flex u-size-lg u-items-center u-justify-center u-rounded-full c-icon-circle">
            <svg aria-hidden="true" class="u-size-md" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd" />
            </svg>
          </div>
          <h2 class="c-h2">Message</h2>
        </div>
        <div class="c-surface c-card--muted mt-xl">
          <p class="c-rich-text u-whitespace-pre-line"><%= @notification.display_message %></p>
        </div>
      </div>

      <% if (target_path = @notification.target_path_for(current_user)).present? %>
        <div class="c-card c-card--spacious">
          <div class="u-responsive-row u-justify-between">
            <div class="u-flex u-items-center u-gap-lg">
              <div class="u-flex u-size-xl u-items-center u-justify-center u-rounded-full c-icon-circle">
                <svg aria-hidden="true" class="u-size-md" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L13.586 11H4a1 1 0 110-2h9.586l-3.293-3.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </div>
              <div>
                <h3 class="c-h3">Related record</h3>
                <p class="c-help">Jump to the connected record for additional context and follow-up.</p>
              </div>
            </div>
            <%= link_to target_path, class: button_classes(:primary) do %>
              Open Record
              <svg aria-hidden="true" class="u-size-sm" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L13.586 11H4a1 1 0 110-2h9.586l-3.293-3.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>
  </div>
</main>
