<% content_for :title, "Settings" %>

<% lang_code = (@user&.language.presence || "en") %>
<% lang_labels = {
  "en" => "English", "es" => "Spanish", "fr" => "French", "de" => "German",
  "zh-CN" => "Chinese (Simplified)", "zh-TW" => "Chinese (Traditional)",
  "ja" => "Japanese", "ko" => "Korean", "pt" => "Portuguese", "ru" => "Russian"
} %>
<% current_language_label = lang_labels[lang_code] || lang_code %>
<% text_scale = @user.text_scale_percent || 100 %>
<% notifications_enabled = @user.notifications_enabled.nil? ? true : @user.notifications_enabled %>
<% in_app_notifications_enabled = @user.in_app_notifications_enabled.nil? ? true : @user.in_app_notifications_enabled %>
<% email_delivery_enabled = NotificationEmailDeliveryJob.email_notifications_enabled? %>
<% full_name = @user.full_name.presence || @user.email || "User" %>
<% updated_text = @user.updated_at ? "#{time_ago_in_words(@user.updated_at)} ago" : "Just now" %>
<% initials = full_name.split.first(2).map { |part| part.first&.upcase }.join.presence || "U" %>
<% avatar_url = @user.avatar_url.presence %>
<% back_path = if current_user&.role_admin?
                 admin_dashboard_path
               elsif current_user&.role_advisor?
                 advisor_dashboard_path
               elsif current_user&.role_student?
                 student_dashboard_path
               else
                 root_path
               end %>

<main class="c-main c-page">
  <section class="c-card c-card--brand c-card--spacious u-stack u-stack--lg">
    <header class="c-page-header">
      <div class="u-stack u-stack--md">
        <div>
          <p class="c-eyebrow">Settings</p>
          <h1 class="c-page-title c-page-title--brand">Workspace preferences</h1>
          <p class="c-page-subtitle">Review your saved language, accessibility, and notification preferences.</p>
        </div>

        <div class="u-actions u-actions--start u-gap-xs">
          <span class="c-status-pill c-status-pill--success">Preferences active</span>
          <span class="c-pill c-pill--muted">Language: <%= current_language_label %></span>
          <span class="c-pill c-pill--muted">Text scale: <%= text_scale %>%</span>
          <span class="c-pill c-pill--muted">In-app alerts: <%= in_app_notifications_enabled ? "On" : "Off" %></span>
        </div>
      </div>

      <div class="u-responsive-row u-items-center">
        <div class="c-avatar-tile u-size-2xl text-xl" <%= "role=\"img\" aria-label=\"#{avatar_aria_label(@user)}\"" unless avatar_url %>>
          <% if avatar_url %>
            <img src="<%= avatar_url %>" alt="<%= avatar_aria_label(@user) %>" loading="lazy">
          <% else %>
            <span aria-hidden="true"><%= initials %></span>
            <span class="sr-only"><%= avatar_aria_label(@user) %></span>
          <% end %>
        </div>
      </div>
    </header>

    <div class="u-grid u-grid--stats">
      <article class="c-kv c-kv--compact">
        <p class="c-eyebrow">Language</p>
        <p class="c-value c-value--lg"><%= current_language_label %></p>
      </article>
      <article class="c-kv c-kv--compact">
        <p class="c-eyebrow">Text scale</p>
        <p class="c-value c-value--lg"><%= text_scale %>%</p>
      </article>
      <article class="c-kv c-kv--compact">
        <p class="c-eyebrow">In-app alerts</p>
        <p class="c-value c-value--lg"><%= in_app_notifications_enabled ? "On" : "Off" %></p>
      </article>
      <article class="c-kv c-kv--compact">
        <p class="c-eyebrow">Last updated</p>
        <p class="c-value c-value--lg"><%= updated_text %></p>
      </article>
    </div>
  </section>

  <section class="c-student-overview-layout">
    <aside class="c-student-overview-sidebar c-card c-card--tight u-stack u-stack--lg">
      <%= render "shared/account_settings_tabs", active: :settings %>
    </aside>

    <div class="c-student-overview-main u-stack u-stack--lg">
      <section class="c-card c-card--tight u-stack u-stack--lg">
        <header class="u-stack u-stack--sm">
          <p class="c-eyebrow">Preferences</p>
          <h2 class="c-section-title">Saved Settings</h2>
          <p class="c-help">Use Edit for language and text preferences. In-app notifications can be toggled below.</p>
        </header>

        <div class="u-grid u-grid--2">
          <article class="c-kv c-kv--compact">
            <p class="c-eyebrow">Language</p>
            <p class="c-value"><%= current_language_label %></p>
            <p class="c-help">Used with the translation tools across the app.</p>
          </article>

          <article class="c-kv c-kv--compact">
            <p class="c-eyebrow">Text size</p>
            <p class="c-value"><%= text_scale %>%</p>
            <p class="c-help">Applied to dashboards, surveys, reports, and navigation.</p>
          </article>

          <article class="c-kv c-kv--compact">
            <p class="c-eyebrow">Read Aloud speed</p>
            <p class="c-value">Device setting</p>
            <p class="c-help">Stored in this browser from the edit page.</p>
          </article>

        </div>
      </section>

      <section class="c-card c-card--tight u-stack u-stack--lg">
        <header class="u-stack u-stack--sm">
          <p class="c-eyebrow">Notifications</p>
          <h2 class="c-section-title">Delivery Settings</h2>
          <p class="c-help">Email delivery is controlled by the app-level feature flag. In-app notifications are controlled by your saved preference.</p>
        </header>

        <div class="u-grid u-grid--2">
          <div class="c-field">
            <label class="c-toggle">
              <input type="checkbox"
                     class="c-toggle__input"
                     <%= "checked" if email_delivery_enabled %>
                     disabled>
              <span class="c-toggle__track" aria-hidden="true"><span class="c-toggle__thumb"></span></span>
              <span>
                <span class="c-toggle__label">System email delivery</span>
                <span class="c-help u-block">
                  <%= email_delivery_enabled ? "Email jobs can send through the configured SMTP service." : "Email notifications are hidden until EMAIL_NOTIFICATIONS_ENABLED is turned on." %>
                </span>
              </span>
            </label>
          </div>

          <% if email_delivery_enabled %>
            <div class="c-field">
              <label class="c-toggle">
                <input type="checkbox"
                       class="c-toggle__input"
                       <%= "checked" if notifications_enabled %>
                       disabled>
                <span class="c-toggle__track" aria-hidden="true"><span class="c-toggle__thumb"></span></span>
                <span>
                  <span class="c-toggle__label">Email notifications</span>
                  <span class="c-help u-block">Your saved preference for survey, competency, and advisor alerts.</span>
                </span>
              </label>
            </div>
          <% end %>

          <div class="c-field">
            <%= form_with model: @user, url: settings_path, method: :patch, local: true do |f| %>
              <label class="c-toggle u-cursor-pointer" for="settings_in_app_notifications_enabled">
                <%= f.check_box :in_app_notifications_enabled,
                                id: "settings_in_app_notifications_enabled",
                                class: "c-toggle__input",
                                onchange: "this.form.requestSubmit()" %>
                <span class="c-toggle__track" aria-hidden="true"><span class="c-toggle__thumb"></span></span>
                <span>
                  <span class="c-toggle__label">In-app notifications</span>
                  <span class="c-help u-block">Controls unread notifications in the top navigation and notification center.</span>
                </span>
              </label>
              <noscript>
                <div class="u-actions u-actions--start u-mt-sm">
                  <%= f.submit "Save notification preference", class: button_classes(:secondary, extra_classes: "btn-sm") %>
                </div>
              </noscript>
            <% end %>
          </div>
        </div>
      </section>

      <section class="c-card c-card--tight">
        <div class="u-actions u-actions--split">
          <%= link_to "Cancel", back_path, class: button_classes(:secondary) %>
          <%= link_to "Edit", edit_settings_path, class: button_classes(:primary) %>
        </div>
      </section>
    </div>
  </section>
</main>
