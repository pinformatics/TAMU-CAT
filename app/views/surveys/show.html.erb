<% survey_title = @survey.title.presence || "Survey ##{@survey.id}" %>

<div data-survey-scroll-scope class="c-document-shell">

  <div class="c-two-column-layout">
    <div class="u-stack u-stack--xl u-min-w-0">

  <% cancel_path = @return_to.presence || student_dashboard_path %>
  <% available_until_for_edit = @survey_assignment&.available_until %>
  <% can_edit_by_availability = available_until_for_edit.blank? || available_until_for_edit >= Time.current %>
  <% editing_mode = @return_to.present? || (@survey_assignment&.completed_at? && can_edit_by_availability) %>

  <% if editing_mode %>
    <div class="c-card c-card--tight">
      <div class="u-actions u-actions--start">
        <%= link_to "Cancel", cancel_path, class: button_classes(:secondary) %>
      </div>
    </div>
  <% end %>

  <header class="c-document-hero">
    <div class="u-stack u-stack--md">
      <p class="c-eyebrow">TAMU Competency Assessment Tool survey</p>
      <h1 class="c-h1"><%= @survey.title %></h1>
      <div class="u-actions u-actions--start">
        <span class="c-pill c-pill--muted">Semester: <%= @survey.semester.presence || "TBD" %></span>
        <span class="c-pill c-pill--muted">Tracks: <%= @survey.track_list.presence&.join(", ") || "Unassigned" %></span>
        <span class="c-pill c-pill--primary"><%= survey_availability_note(@survey_assignment&.available_until) %></span>
      </div>
      <p class="c-help u-max-w-xl">
        Questions marked with an asterisk (*) are required.
      </p>
    </div>
  </header>

  <% flash_alert_present = flash[:alert].present? || flash.now[:alert].present? %>
  <% if @invalid_evidence.present? && !flash_alert_present %>
    <div class="c-callout c-callout--warning">
      <p class="c-callout__title">Please fix the highlighted items:</p>
      <ul>
        <li>Use a published Google Sites link only (sites.google.com).</li>
      </ul>
    </div>
  <% end %>

  <% if @invalid_integer.present? && !flash_alert_present %>
    <div class="c-callout c-callout--warning">
      <p class="c-callout__title">Please fix the highlighted items:</p>
      <ul>
        <li>Integer responses must be whole numbers within the allowed range.</li>
      </ul>
    </div>
  <% end %>

  <%= form_with url: submit_survey_path(@survey), method: :post, local: true, data: { turbo: false }, class: "u-stack u-stack--xl survey-form" do |form| %>
    <% rendered_section_ids = [] %>
    <% section_question_numbers = Hash.new(0) %>
    <% invalid_evidence_ids = Array(@invalid_evidence).map(&:to_s) %>
    <% invalid_integer_ids = Array(@invalid_integer).map(&:to_s) %>
    <% @category_groups.each do |category| %>
      <% section = category.section %>
      <% section_anchor_id = section.present? ? "survey-section-#{section.id}" : nil %>
      <div class="u-stack u-stack--md">
        <% if section.present? && !rendered_section_ids.include?(section.id) %>
          <div id="<%= section_anchor_id %>" class="c-form-section__intro u-stack u-stack--sm">
            <p class="c-eyebrow">Section</p>
            <h2 class="c-h2"><%= section.title %></h2>
            <% if section.description.present? && !section.mha_competency? %>
              <p class="c-help"><%= section.description %></p>
            <% end %>

            <% if section.mha_competency? %>
              <p class="c-help"><%= section.description %></p>
            <% end %>
          </div>
          <% rendered_section_ids << section.id %>
        <% end %>

        <section id="survey-category-<%= category.id %>" class="c-form-section">
        <header class="c-form-section__header">
          <h2 class="c-h2"><%= category.name %></h2>
          <% category_desc = category.description.to_s.strip.presence %>
          <% if category_desc.present? %>
            <p class="c-indent-note c-help"><%= category_desc.gsub(/\r?\n/, '<br>').html_safe %></p>
          <% end %>
        </header>

        <div class="c-form-section__body">
          <% number_key = section&.id || category.id %>
          <% ordered_questions = category.questions.ordered.to_a %>
          <% branch_parent_ids = ordered_questions.select(&:sub_question?).map(&:parent_question_id).compact.uniq %>
          <% ordered_questions.each do |question| %>
            <% is_sub_question = question.sub_question? %>
            <% question_number = section_question_numbers[number_key] %>
            <% question_number = (section_question_numbers[number_key] += 1) unless is_sub_question %>
            <% field_name = "answers[#{question.id}]" %>
            <% current_value = @existing_answers[question.id.to_s] %>
            <% required = @computed_required[question.id] %>
            <% evidence_value = if question.question_type == "evidence"
                                  current_value.is_a?(Hash) ? current_value["link"] : current_value
                                else
                                  nil
                                end %>
            <% missing_required_error = false %>
            <% if request.post? && required %>
              <% if question.question_type == "evidence" %>
                <% missing_required_error = evidence_value.to_s.strip.blank? %>
              <% else %>
                <% missing_required_error = current_value.to_s.strip.blank? %>
              <% end %>
            <% end %>
            <% invalid_evidence_error = question.question_type == "evidence" && invalid_evidence_ids.include?(question.id.to_s) %>
            <% invalid_integer_error = question.question_type == "integer" && invalid_integer_ids.include?(question.id.to_s) %>
            <% has_error = missing_required_error || invalid_evidence_error || invalid_integer_error %>
            <% article_classes = ["c-question-card"] %>
            <% article_classes << "c-question-card--nested" if question.sub_question? %>
            <% article_classes << "c-question-card--error" if has_error %>

            <% is_branch_parent = !is_sub_question && question.question_type == "multiple_choice" && branch_parent_ids.include?(question.id) %>
            <% if is_branch_parent %>
              <% option_values = question.answer_options_list.map { |opt| opt.to_s.strip.downcase } %>
              <% is_branch_parent = option_values.include?("yes") && option_values.include?("no") %>
            <% end %>
            <% branch_target_value = is_branch_parent ? "Yes" : nil %>
            <% branch_child_of = is_sub_question ? question.parent_question_id : nil %>

            <article id="question-block-<%= question.id %>"
                     class="<%= article_classes.join(' ') %>"
                     data-question-id="<%= question.id %>"
                     <% if is_branch_parent %>
                       data-branch-parent="true"
                       data-branch-parent-id="<%= question.id %>"
                       data-branch-target-value="<%= branch_target_value %>"
                     <% end %>
                     <% if branch_child_of.present? %>
                       data-branch-child-of="<%= branch_child_of %>"
                     <% end %>>
            <% desc_text = question.description.to_s.strip.presence %>
            <% formatted_desc = desc_text.present? ? render_markdown(desc_text) : nil %>

            <label class="c-question-card__header" for="question-<%= question.id %>">
              <% question_prefix = section&.mha_competency? ? "#" : "Q" %>
              <span class="c-question-card__main">
                <% if is_sub_question %>
                  <span class="c-question-number c-question-number--sub" aria-label="Sub-question">↳</span>
                <% else %>
                  <span class="c-question-number"><%= question_prefix %><%= question_number %></span>
                <% end %>
                <span class="c-question-card__content">
                  <span class="c-question-card__prompt-row">
                    <span class="c-question-card__prompt"><%= render_question_prompt(question) %></span>
                    <% if required %>
                      <span class="u-danger" aria-hidden="true">*</span>
                    <% end %>
                  </span>
                  <% if formatted_desc.present? %>
                    <div class="c-indent-note c-help"><%= formatted_desc %></div>
                  <% end %>
                </span>
              </span>

              <% effective_target_level = effective_competency_target_level(question: question, survey: @survey, student: current_student) %>
              <% course_context = @survey.show_course_competencies_with_survey? ? course_competency_context_for(question: question, survey: @survey, student: current_student, viewer: current_user) : nil %>
              <% if question.question_type_dropdown? && effective_target_level.present? %>
                <span class="c-question-card__meta">
                  <span class="c-level-badge">End-of-program target level: <%= effective_target_level %>/5</span>
                </span>
              <% end %>
            </label>

            <%= render_course_competency_context(course_context) if @survey.show_course_competencies_with_survey? %>

            <% case question.question_type %>
            <% when "short_answer" %>
              <div data-controller="character-counter">
                <%= text_area_tag field_name,
                                  current_value,
                                  rows: 3,
                                  maxlength: StudentQuestion::TEXT_MAX_LENGTH,
                                  id: "question-#{question.id}",
                                  data: { "character-counter-target": "input", action: "input->character-counter#input" },
                                  class: "c-input u-w-full" %>
                <div class="c-help" data-character-counter-target="counter"><%= current_value.to_s.length %>/<%= StudentQuestion::TEXT_MAX_LENGTH %> characters</div>
              </div>

            <% when "integer" %>
              <% integer_min = question.respond_to?(:integer_min_value) ? question.integer_min_value : 1 %>
              <% integer_max = question.respond_to?(:integer_max_value) ? question.integer_max_value : nil %>
              <%= number_field_tag field_name,
                                   current_value,
                                   id: "question-#{question.id}",
                                   min: integer_min,
                                   max: integer_max,
                                   step: 1,
                                   inputmode: "numeric",
                                   pattern: "\\d+",
                                   class: "c-input u-w-full u-max-w-sm" %>
              
            <% when "multiple_choice" %>
              <% option_pairs = question.answer_option_pairs.presence || [] %>
              <div class="u-stack u-stack--sm" role="radiogroup">
                <% option_pairs.each do |label, value| %>
                  <label class="c-choice-label">
                    <%= radio_button_tag field_name,
                                         value,
                                         (current_value.is_a?(Hash) ? current_value["answer"].to_s : current_value.to_s) == value.to_s,
                                         id: "question-#{question.id}-#{label.parameterize}",
                                         class: "c-choice" %>
                    <span><%= label %></span>
                  </label>

                  <% requires_text = question.answer_option_requires_text?(value) %>
                  <% if requires_text %>
                    <% other_value = (@other_answers || {})[question.id.to_s] %>
                    <% selected_value = (current_value.is_a?(Hash) ? current_value["answer"].to_s : current_value.to_s) %>
                    <% show_other = selected_value.to_s == value.to_s %>
                    <div class="u-ml-xl <%= show_other ? "" : "hidden" %>" data-other-input-wrapper data-other-for-question-id="<%= question.id %>" data-other-choice-value="<%= value %>" aria-hidden="<%= show_other ? "false" : "true" %>" data-controller="character-counter">
                      <%= text_field_tag "other_answers[#{question.id}]",
                                         other_value,
                                         id: "question-#{question.id}-other-#{value.to_s.parameterize}",
                                         placeholder: "Please describe...",
                                         maxlength: StudentQuestion::TEXT_MAX_LENGTH,
                                         data: { "character-counter-target": "input", action: "input->character-counter#input" },
                                         class: "c-input u-w-full u-max-w-xl",
                                         disabled: !show_other %>
                      <div class="c-help" data-character-counter-target="counter"><%= other_value.to_s.length %>/<%= StudentQuestion::TEXT_MAX_LENGTH %> characters</div>
                    </div>
                  <% end %>
                <% end %>
              </div>

            <% when "dropdown" %>
              <% option_pairs = question.answer_option_pairs %>
              <%= select_tag field_name,
                             options_for_select(option_pairs.map { |label, value| [label, value] }, current_value.to_s),
                             include_blank: true,
                             id: "question-#{question.id}",
                             class: "c-select u-w-full u-max-w-sm" %>

              <% option_pairs.each do |_label, value| %>
                <% next unless question.answer_option_requires_text?(value) %>
                <% other_value = (@other_answers || {})[question.id.to_s] %>
                <% selected_value = current_value.to_s %>
                <% show_other = selected_value.to_s == value.to_s %>
                <div class="u-mt-sm u-max-w-xl <%= show_other ? "" : "hidden" %>" data-other-input-wrapper data-other-for-question-id="<%= question.id %>" data-other-choice-value="<%= value %>" aria-hidden="<%= show_other ? "false" : "true" %>" data-controller="character-counter">
                  <%= text_field_tag "other_answers[#{question.id}]",
                                     other_value,
                                     id: "question-#{question.id}-other-#{value.to_s.parameterize}",
                                     placeholder: "Please describe...",
                                     maxlength: StudentQuestion::TEXT_MAX_LENGTH,
                                     data: { "character-counter-target": "input", action: "input->character-counter#input" },
                                     class: "c-input u-w-full",
                                     disabled: !show_other %>
                  <div class="c-help" data-character-counter-target="counter"><%= other_value.to_s.length %>/<%= StudentQuestion::TEXT_MAX_LENGTH %> characters</div>
                </div>
              <% end %>
              
            <% when "evidence" %>
              <div data-controller="character-counter">
                <%= text_field_tag field_name,
                                   evidence_value,
                                   maxlength: StudentQuestion::TEXT_MAX_LENGTH,
                                   id: "question-#{question.id}",
                                   placeholder: "https://sites.google.com/tamu.edu/...",
                                   data: { "character-counter-target": "input", action: "input->character-counter#input" },
                                   class: "c-input u-w-full" %>
                <div class="c-help" data-character-counter-target="counter"><%= evidence_value.to_s.length %>/<%= StudentQuestion::TEXT_MAX_LENGTH %> characters</div>
              </div>
              <% if invalid_evidence_error %>
                <div class="c-help u-danger">
                  This link is not publicly accessible, so the survey cannot verify your evidence.
                  Fix: In Google Sites, open your site and go to Publish → Manage (Who can view) → select "Anyone with the link" → Publish again, then resubmit.
                </div>
              <% elsif missing_required_error %>
                <div class="c-help u-danger">This question is required</div>
              <% end %>
              
            <% else %>
              <div data-controller="character-counter">
                <%= text_field_tag field_name,
                                   current_value,
                                   maxlength: StudentQuestion::TEXT_MAX_LENGTH,
                                   id: "question-#{question.id}",
                                   data: { "character-counter-target": "input", action: "input->character-counter#input" },
                                   class: "c-input u-w-full" %>
                <div class="c-help" data-character-counter-target="counter"><%= current_value.to_s.length %>/<%= StudentQuestion::TEXT_MAX_LENGTH %> characters</div>
              </div>
              
            <% end %>

            <% if missing_required_error && question.question_type != "evidence" %>
              <div class="c-help u-danger">This question is required</div>
            <% end %>

            </article>
          <% end %>
        </div>
        </section>
      </div>
    <% end %>

    <%# Ensure newly added sections appear even if they have no categories yet. %>
    <% SurveySection.where(survey_id: @survey.id).ordered.each do |section| %>
      <% next if rendered_section_ids.include?(section.id) %>
      <div class="u-stack u-stack--md u-mt-xl">
        <div id="survey-section-<%= section.id %>" class="c-form-section__intro u-stack u-stack--sm">
          <p class="c-eyebrow">Section</p>
          <h2 class="c-h2"><%= section.title %></h2>
          <% if section.description.present? && !section.mha_competency? %>
            <p class="c-help"><%= section.description %></p>
          <% end %>

          <% if section.mha_competency? %>
            <div class="c-callout c-callout--info">
              <p>
                <%= section.description %>
              </p>
            </div>
          <% end %>
        </div>

        <div class="c-card c-card--tight c-card--dashed c-muted">
          No competencies are configured in this section yet.
        </div>
      </div>
    <% end %>

    <% allow_save_progress = !(@survey_assignment&.completed_at?) %>
    <div class="c-form-actions-bar">
      <div class="u-actions u-actions--split u-w-full">
        <div class="u-actions u-actions--start">
          <%= link_to "Cancel", cancel_path, class: button_classes(:secondary) %>
          <% if allow_save_progress %>
            <%= button_tag "Save Progress", type: "button", class: button_classes(:secondary), onclick: "saveSurveyProgress()" %>
          <% end %>
        </div>
        <%= form.submit "Submit Survey", class: button_classes(:primary) %>
      </div>
    </div>
  <% end %>

  <% if request.post? && (@first_error_question_id.present? || @scroll_to_form_top) %>
    <script>
      (function() {
        var scrolled = false;
        function runScroll() {
          if (scrolled) return;
          scrolled = true;
          <% if @scroll_to_form_top %>
            window.scrollTo({ top: 0, behavior: "smooth" });
          <% end %>
          <% if @first_error_question_id.present? %>
            var field = document.getElementById("question-<%= @first_error_question_id %>");
            var block = document.getElementById("question-block-<%= @first_error_question_id %>");
            if (!block) {
              block = document.querySelector('[data-question-id="<%= @first_error_question_id %>"]');
            }
            var sectionTargetId = "<%= j(@first_error_section_dom_id.to_s) %>";
            var sectionBlock = sectionTargetId ? document.getElementById(sectionTargetId) : null;
            var target = block || field || sectionBlock;
            if (target && target.scrollIntoView) {
              var blockOption = (target === sectionBlock) ? "start" : "center";
              var performScroll = function() {
                target.scrollIntoView({ behavior: "smooth", block: blockOption });
              };
              if (window.requestAnimationFrame) {
                window.requestAnimationFrame(performScroll);
              } else {
                setTimeout(performScroll, 0);
              }
            }
            if (field && typeof field.focus === "function") {
              try { field.focus({ preventScroll: true }); } catch (err) {}
            } else if (block && typeof block.focus === "function") {
              if (!block.hasAttribute('tabindex')) { block.setAttribute('tabindex', '-1'); }
              try { block.focus({ preventScroll: true }); } catch (err) {}
            }
          <% end %>
        }
        if (document.readyState === "complete" || document.readyState === "interactive") {
          runScroll();
        } else {
          document.addEventListener("DOMContentLoaded", runScroll, { once: true });
        }
        document.addEventListener("turbo:load", runScroll, { once: true });
      })();
    </script>
  <% end %>

  <script>
    function saveSurveyProgress() {
      const form = document.querySelector('.survey-form');
      const originalAction = form.action;
      
      // Change to save_progress endpoint
      form.action = '<%= save_progress_survey_path(@survey) %>';
      
      // Submit the form
      form.submit();
    }
  </script>

    </div>

    <%= render ::SurveyLegendComponent.new(legend: @survey.legend) %>
  </div>
</div>
