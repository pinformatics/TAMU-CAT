<% content_for :title, "Account Information" %>

<% role_label = if @user.respond_to?(:role_admin?) && @user.role_admin?
                  "Administrator"
                elsif @user.respond_to?(:role_advisor?) && @user.role_advisor?
                  "Advisor"
                elsif @user.respond_to?(:role_student?) && @user.role_student?
                  "Student"
                else
                  "User"
                end %>

<% full_name = @user.name.presence || @user.email || "User" %>
<% email = @user.email.presence || "Not provided" %>
<% member_since = @user.created_at ? @user.created_at.strftime("%b %-d, %Y") : "Recently" %>
<% updated_text = @user.updated_at ? "#{time_ago_in_words(@user.updated_at)} ago" : "Just now" %>
<% initials = full_name.to_s.split.first(2).map { |part| part.first&.upcase }.join.presence || "U" %>
<% avatar_url = @user.respond_to?(:avatar_url) ? @user.avatar_url.presence : nil %>

<main class="c-main c-page">
  <section class="c-card c-card--brand c-card--spacious u-stack u-stack--lg">
    <header class="c-page-header">
      <div class="u-stack u-stack--md">
        <div>
          <p class="c-eyebrow">Account settings</p>
          <h1 class="c-page-title c-page-title--brand"><%= full_name %></h1>
          <p class="c-page-subtitle">Review the identity details connected to your sign-in account.</p>
        </div>

        <div class="u-actions u-actions--start u-gap-xs">
          <span class="c-status-pill c-status-pill--success">Account active</span>
          <span class="c-pill c-pill--muted"><%= role_label %></span>
          <span class="c-pill c-pill--muted">Updated <%= updated_text %></span>
        </div>
      </div>

      <div class="u-responsive-row u-items-center">
        <div class="c-avatar-tile u-size-2xl text-xl" <%= "role=\"img\" aria-label=\"#{avatar_aria_label(@user)}\"" unless avatar_url %>>
          <% if avatar_url %>
            <img src="<%= avatar_url %>" alt="<%= avatar_aria_label(@user) %>" loading="lazy">
          <% else %>
            <span aria-hidden="true"><%= initials %></span>
            <span class="sr-only"><%= avatar_aria_label(@user) %></span>
          <% end %>
        </div>
      </div>
    </header>

    <div class="u-grid u-grid--stats">
      <article class="c-kv c-kv--compact">
        <p class="c-eyebrow">Primary email</p>
        <p class="c-value c-value--lg"><%= email %></p>
      </article>
      <article class="c-kv c-kv--compact">
        <p class="c-eyebrow">Role</p>
        <p class="c-value c-value--lg"><%= role_label %></p>
      </article>
      <article class="c-kv c-kv--compact">
        <p class="c-eyebrow">Member since</p>
        <p class="c-value c-value--lg"><%= member_since %></p>
      </article>
      <article class="c-kv c-kv--compact">
        <p class="c-eyebrow">Last updated</p>
        <p class="c-value c-value--lg"><%= updated_text %></p>
      </article>
    </div>
  </section>

  <section class="c-student-overview-layout">
    <aside class="c-student-overview-sidebar c-card c-card--tight u-stack u-stack--lg">
      <header class="u-stack u-stack--sm">
        <p class="c-eyebrow">Account</p>
        <h2 class="c-section-title">Identity</h2>
      </header>

      <dl class="c-key-value-list">
        <div>
          <dt>Full name</dt>
          <dd><%= full_name %></dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><%= email %></dd>
        </div>
        <div>
          <dt>Role</dt>
          <dd><%= role_label %></dd>
        </div>
        <div>
          <dt>Member since</dt>
          <dd><%= member_since %></dd>
        </div>
      </dl>
    </aside>

    <section class="c-student-overview-main c-card c-card--tight u-stack u-stack--lg">
      <header class="u-stack u-stack--sm">
        <p class="c-eyebrow">Profile</p>
        <h2 class="c-section-title">Account Information</h2>
        <p class="c-help">Account information is read-only here and comes from your authenticated sign-in account.</p>
      </header>

      <dl class="c-key-value-list">
        <div>
          <dt>Display name</dt>
          <dd><%= full_name %></dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><%= email %></dd>
        </div>
        <div>
          <dt>Role</dt>
          <dd><%= role_label %></dd>
        </div>
        <div>
          <dt>Last updated</dt>
          <dd><%= updated_text %></dd>
        </div>
      </dl>

      <div class="u-actions u-actions--start u-section-divider">
        <%= link_to dashboard_path, class: button_classes(:secondary) do %>
          Back to dashboard
        <% end %>
      </div>
    </section>
  </section>
</main>
