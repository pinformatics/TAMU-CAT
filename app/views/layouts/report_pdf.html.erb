<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Health Program Analytics</title>
    <style>
      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        margin: 24px;
        color: #222;
        font-size: 14px;
      }

      h1, h2 {
        color: #500000;
        margin-bottom: 8px;
      }

      h1 {
        font-size: 28px;
      }

      h2 {
        font-size: 20px;
        margin-top: 24px;
      }

      p {
        margin: 0 0 16px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 16px;
      }

      th, td {
        border: 1px solid #ccc;
        padding: 8px 10px;
        text-align: left;
      }

      th {
        background-color: #f5f5f5;
      }

      .report-export__header {
        border-bottom: 2px solid #500000;
        margin-bottom: 16px;
        padding-bottom: 8px;
      }

      .chart-block {
        margin: 16px 0 24px;
      }

      .chart-block h3 {
        margin: 0 0 8px;
        font-size: 16px;
        color: #0f172a;
      }

      .chart-legend {
        display: block;
        margin-bottom: 12px;
        font-size: 12px;
        color: #475569;
      }

      .chart-legend__item {
        display: inline-block;
        margin-right: 14px;
        margin-bottom: 6px;
      }

      .chart-legend__swatch {
        width: 12px;
        height: 12px;
        border-radius: 2px;
        background-color: #94a3b8;
      }

      .chart-vertical {
        display: flex;
        align-items: flex-end;
        gap: 16px;
        flex-wrap: wrap;
        justify-content: flex-start;
      }

      .chart-vertical__column {
        flex: 0 0 120px;
        max-width: 140px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        font-size: 11px;
        text-align: center;
        color: #334155;
      }

      .chart-vertical__column strong {
        display: block;
        word-break: break-word;
      }

      .chart-vertical__bar {
        width: 100%;
        height: 180px;
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        overflow: hidden;
        background-color: #e2e8f0;
      }

      .chart-horizontal {
        display: block;
      }

      .chart-horizontal__row {
        display: table;
        width: 100%;
        table-layout: fixed;
        margin-bottom: 12px;
        font-size: 12px;
        color: #334155;
      }

      .chart-horizontal__label {
        display: table-cell;
        width: 180px;
        font-weight: 600;
        word-break: break-word;
        padding-right: 12px;
        vertical-align: middle;
        color: #0f172a;
      }

      .chart-horizontal__bar {
        display: table-cell;
        height: 18px;
        border-radius: 6px;
        overflow: hidden;
        background-color: #e2e8f0;
        vertical-align: middle;
      }

      .chart-horizontal__value {
        display: table-cell;
        width: 70px;
        text-align: right;
        padding-left: 12px;
        vertical-align: middle;
        font-size: 12px;
        color: #0f172a;
      }

      .chart-comparison {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .chart-comparison__row {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 12px;
        color: #334155;
      }

      .chart-comparison__label {
        width: 180px;
        font-weight: 600;
      }

      .chart-comparison__bars {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
      }

      .chart-comparison__series {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
      }

      .chart-comparison__bar {
        height: 14px;
        border-radius: 6px;
        min-width: 6px;
        max-width: 100%;
      }

      .chart-comparison__value {
        width: 48px;
        text-align: right;
      }

      .chart-segment--achieved {
        background-color: #16a34a;
      }

      .chart-segment--not-met {
        background-color: #dc2626;
      }

      .chart-segment--not-assessed {
        background-color: #94a3b8;
      }

      .chart-segment--student {
        background-color: #500000;
      }

      .chart-segment--advisor {
        background-color: #2563eb;
      }

      .chart-segment {
        display: block;
        width: 100%;
      }

      /*
        wkhtmltopdf renders with a very old WebKit that doesn't support the
        CSS flexbox `gap` property -- flex rows using `gap` for spacing
        collapse their spacing entirely, causing labels/bars/values to
        overlap. Use table/table-cell display instead (like
        .chart-horizontal above), which renders reliably.
      */
      .chart-metric-card {
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
        padding: 0.75rem;
        margin-bottom: 0.75rem;
      }

      .chart-metric-card__title {
        font-weight: 600;
        margin-bottom: 0.35rem;
        color: #0f172a;
      }

      .chart-metric-row {
        display: table;
        width: 100%;
        table-layout: fixed;
        margin-bottom: 0.35rem;
      }

      .chart-metric-row__label {
        display: table-cell;
        width: 110px;
        font-size: 0.85rem;
        color: #475569;
        vertical-align: middle;
        padding-right: 0.5rem;
      }

      .chart-metric-row__track {
        display: table-cell;
        background-color: #e2e8f0;
        border-radius: 999px;
        overflow: hidden;
        vertical-align: middle;
      }

      .chart-metric-row__fill {
        display: block;
        color: #fff;
        padding: 0.15rem 0.6rem;
        font-size: 0.85rem;
        white-space: nowrap;
      }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
