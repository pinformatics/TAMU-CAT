<%# Render a read-only survey layout similar to app/views/surveys/show.html.erb %>
<% sr = local_assigns[:survey_response] || (defined?(@survey_response) && @survey_response) %>
<% survey = sr&.survey %>
<% editable = local_assigns.key?(:editable) ? !!local_assigns[:editable] : false %>
<% answer_param_key = editable ? "answers" : "readonly_answers" %>
<% other_param_key = editable ? "other_answers" : "readonly_other_answers" %>
<% input_disabled = !editable %>
<% viewer_is_student_owner = local_assigns.fetch(:viewer_is_student_owner) do
     defined?(current_user) && current_user.present? && current_user.role == 'student' && sr&.student.present? && (current_user.id == sr.student.user&.id)
   end %>

<div class="u-stack u-stack--xl" data-survey-scroll-scope>

  <% survey_name = survey&.title.presence || "Survey ##{survey&.id}" %>
  <% student_name = sr&.student&.full_name.to_s.strip.presence || sr&.student&.user&.display_name.to_s.strip.presence || sr&.student&.user&.name.to_s.strip.presence || sr&.student&.user&.email.to_s.strip.presence %>

  <header class="c-card c-card--brand">
    <div class="u-stack u-stack--sm">
      <h1 class="c-h1"><%= survey_name %></h1>
      <% if student_name.present? && !viewer_is_student_owner %>
        <p class="c-help">Student: <span class="font-semibold"><%= student_name %></span></p>
      <% end %>
      <p class="c-help">
        Semester: <%= survey&.semester.presence || "TBD" %> · Tracks: <%= survey&.track_list.presence&.join(", ") || "Unassigned" %>
      </p>
      <p class="c-help">
        Questions marked with an asterisk (*) are required.
      </p>
    </div>
  </header>

  <% existing_answers = (local_assigns[:existing_answers].presence || sr&.answers || {}) %>
  <% other_answers = (local_assigns[:other_answers] || {}).transform_keys(&:to_s) %>
  <% evidence_history = sr&.evidence_history_by_category || {} %>

  <% include_feedback_form = local_assigns.key?(:include_feedback_form) ? local_assigns[:include_feedback_form] : false %>
  <% passed_existing_feedbacks = local_assigns.key?(:existing_feedbacks_by_question) ? local_assigns[:existing_feedbacks_by_question] : @existing_feedbacks_by_question %>
  <% missing_feedback_question_ids = Array(local_assigns[:missing_feedback_question_ids] || @missing_rating_question_ids).map(&:to_i) %>
  <%# Avoid relying on a potentially partially-loaded association proxy.
      This ensures newly-added categories/questions show up immediately in preview/read-only.
  %>
  <% categories = survey.present? ? Category.where(survey_id: survey.id).includes(:section, :questions).order(:id).to_a : [] %>

  <%# Read-only survey response pages should show advisor feedback directly under the
      parent + sub-question group (when feedback exists). %>
  <% feedback_scope = Feedback.where(student_id: sr&.student_id, survey_id: survey&.id) %>
  <% if viewer_is_student_owner %>
    <% submitted_advisor_ids = AdvisorFeedbackSubmission
                                .submitted
                                .where(student_id: sr&.student_id, survey_id: survey&.id)
                                .pluck(:advisor_id) %>
    <% feedback_scope = feedback_scope.where(advisor_id: submitted_advisor_ids) %>
  <% end %>
  <% feedbacks = feedback_scope
                   .includes(:question, :advisor)
                   .order(updated_at: :desc, created_at: :desc) %>
  <% feedback_submissions_by_advisor = AdvisorFeedbackSubmission
                                        .where(student_id: sr&.student_id, survey_id: survey&.id)
                                        .index_by(&:advisor_id) %>
  <% per_question_map = {} %>
  <% per_category_legacy = {} %>
  <% feedbacks.each do |fb| %>
    <% if fb.question_id.present? %>
      <% per_question_map[fb.question_id] ||= fb %>
    <% elsif fb.category_id.present? %>
      <% per_category_legacy[fb.category_id] ||= fb %>
    <% end %>
    <%# Try parse legacy JSON in comments if present for category-level legacy entries %>
    <% if fb.comments.present? && fb.category_id.present? %>
      <% begin %>
        <% parsed = JSON.parse(fb.comments) rescue nil %>
        <% if parsed.is_a?(Hash) %>
          <% parsed.each do |k, v| %>
            <% cid = k.to_i %>
            <% per_category_legacy[cid] ||= {} %>
            <% per_category_legacy[cid] = v %>
          <% end %>
        <% end %>
      <% rescue StandardError %>
      <% end %>
    <% end %>
  <% end %>

  <% if categories.any? %>
    <div class="u-stack u-stack--xl" data-survey-scroll-scope>
      <% rendered_section_ids = [] %>
      <% section_question_numbers = Hash.new(0) %>
      <% categories.each do |category| %>
        <% section = category.section %>
        <% if section.present? && !rendered_section_ids.include?(section.id) %>
          <% section_anchor_id = "survey-section-#{section.id}" %>
          <div class="c-card c-card--student u-stack u-stack--sm text-left">
            <p class="c-eyebrow">Section</p>
            <h2 class="c-h2"><%= section.title %></h2>
            <% if section.description.present? && !section.mha_competency? %>
              <div class="c-rich-text text-sm"><%= render_markdown(section.description) %></div>
            <% end %>

            <% if section.mha_competency? %>
              <div class="c-rich-text text-sm"><%= render_markdown(section.description) %></div>
            <% end %>
          </div>
          <% rendered_section_ids << section.id %>
        <% end %>
        <div class="u-stack u-stack--md">
        <section id="survey-category-<%= category.id %>" class="c-card u-stack u-stack--lg">
          <header class="u-stack u-stack--sm">
            <h2 class="c-h2"><%= category.name %></h2>
            <% category_desc = category.description.to_s.strip.presence %>
            <% if category_desc.present? %>
              <div class="c-indent-note c-rich-text text-sm"><%= render_markdown(category_desc) %></div>
            <% end %>
          </header>

          <% if category.questions.any? %>
            <div class="c-question-list">
              <% number_key = section&.id || category.id %>
                <% ordered_questions = category.questions.ordered.to_a %>
                <% questions_by_id = ordered_questions.index_by(&:id) %>
                <% branch_parent_ids = SurveyQuestionRules.branch_parent_ids(ordered_questions) %>
                <% branch_parent_target_by_id = SurveyQuestionRules.branch_parent_target_by_id(ordered_questions) %>
                <% ordered_questions.each_with_index do |question, q_index| %>
                  <% is_sub_question = question.sub_question? %>
                  <% next_question = ordered_questions[q_index + 1] %>

                  <% branch_child_of = SurveyQuestionRules.branch_child_parent_id(question, branch_parent_target_by_id:) %>
                  <% conditional_branch_child = branch_child_of.present? %>
                  <% hide_branch_child = conditional_branch_child && !SurveyQuestionRules.branch_child_visible?(question, answers: existing_answers, branch_parent_target_by_id:) %>
                  <% reflection_source_question = SurveyQuestionRules.reflection_source_question(question, ordered_questions) %>
                  <% conditional_reflection_child = reflection_source_question.present? %>
                  <% hide_reflection_child = conditional_reflection_child && !SurveyQuestionRules.reflection_visible?(question, answers: existing_answers, questions: ordered_questions) %>
                  <% hide_question_card = hide_branch_child || hide_reflection_child %>

                  <% question_number = section_question_numbers[number_key] %>
                  <% question_number = (section_question_numbers[number_key] += 1) unless is_sub_question %>
                  <% raw_answer = existing_answers[question.id] || existing_answers[question.id.to_s] %>
                  <%# Normalize stored shapes: prefer explicit `answer` for selection and `text`/`link` for display %>
                  <% answer_value = nil %>
                  <% answer_text = nil %>
                  <% rating_val = nil %>
                  <% if raw_answer.is_a?(Hash) %>
                    <% answer_value = raw_answer["answer"] || raw_answer["value"] || raw_answer[:answer] || raw_answer[:value] %>
                    <% answer_text = raw_answer["text"] || raw_answer[:text] || raw_answer["link"] || raw_answer[:link] || answer_value %>
                    <% rating_val = raw_answer["rating"] || raw_answer[:rating] %>
                  <% elsif raw_answer.is_a?(Array) %>
                    <% answer_value = raw_answer %>
                    <% answer_text = raw_answer.join(", ") %>
                  <% else %>
                    <% answer_value = raw_answer %>
                    <% answer_text = raw_answer %>
                  <% end %>
                  <% desc_text = question.description.to_s.strip.presence %>
                  <% formatted_desc = desc_text.present? ? render_markdown(desc_text) : nil %>

                <% required = SurveyQuestionRules.required_indicator?(question, branch_parent_ids:) %>
                <% is_branch_parent = branch_parent_target_by_id.key?(question.id) %>
                <% branch_target_value = branch_parent_target_by_id[question.id] %>

                <article id="question-block-<%= question.id %>"
                         class="c-question-card <%= question.sub_question? ? 'c-question-card--nested' : '' %> <%= hide_question_card ? 'hidden' : '' %>"
                         data-question-id="<%= question.id %>"
                         data-question-type="<%= question.question_type %>"
                         <% if include_feedback_form && !editable %>
                           data-feedback-readonly-response="true"
                         <% end %>
                         data-survey-required="<%= required ? "true" : "false" %>"
                         data-preview-required="<%= required ? "true" : "false" %>"
                         <% if conditional_branch_child || conditional_reflection_child %>
                           aria-hidden="<%= hide_question_card ? "true" : "false" %>"
                         <% end %>
                         <% if is_branch_parent %>
                           data-branch-parent="true"
                           data-branch-parent-id="<%= question.id %>"
                           data-branch-target-value="<%= branch_target_value %>"
                         <% end %>
                         <% if branch_child_of.present? %>
                           data-branch-child-of="<%= branch_child_of %>"
                         <% end %>
                         <% if reflection_source_question.present? %>
                           data-reflection-question="true"
                           data-reflection-source-id="<%= reflection_source_question.id %>"
                         <% end %>>
                  <% question_prefix = section&.mha_competency? ? "#" : "Q" %>

                  <label class="c-question-card__header" for="question-<%= question.id %>">
                    <span class="c-question-card__main">
                      <% if is_sub_question %>
                        <span class="c-question-number c-question-number--sub" aria-label="Sub-question">↳</span>
                      <% else %>
                        <span class="c-question-number"><%= question_prefix %><%= question_number %></span>
                      <% end %>

                      <span class="c-question-card__content">
                        <span class="c-question-card__prompt-row">
                          <span class="c-question-card__prompt">
                            <%= render_question_prompt(question) %>
                          </span>
                          <% if required %>
                            <span class="u-danger" aria-hidden="true">*</span>
                          <% end %>
                        </span>

                        <% if formatted_desc.present? %>
                          <div class="c-indent-note c-help"><%= formatted_desc %></div>
                        <% end %>
                      </span>
                    </span>

                    <% effective_target_level = effective_competency_target_level(question: question, survey: survey, student: sr&.student) %>
                    <% course_context = course_competency_context_for(question: question, survey: survey, student: sr&.student, viewer: current_user) %>
                    <% if question.question_type_dropdown? && effective_target_level.present? %>
                      <span class="c-question-card__meta">
                        <span class="c-level-badge">End-of-program target level: <%= effective_target_level %>/5</span>
                      </span>
                    <% end %>
                  </label>

                  <%= render_course_competency_context(course_context) %>

                  <% case question.question_type %>
                  <% when "integer" %>
                    <%= number_field_tag "#{answer_param_key}[#{question.id}]",
                                         answer_text.to_s.strip,
                                         id: "question-#{question.id}",
                                         min: question.integer_min_value,
                                         max: question.integer_max_value,
                                         step: 1,
                                         inputmode: "numeric",
                                         pattern: "\\d+",
                                         placeholder: "Enter a whole number",
                                         class: "c-input u-w-full u-max-w-sm",
                                         disabled: input_disabled %>
                  <% when "short_answer" %>
                    <div data-controller="character-counter">
                      <%= text_area_tag "#{answer_param_key}[#{question.id}]",
                                        (answer_text || ""),
                                        rows: 3,
                                        id: "question-#{question.id}",
                                        maxlength: StudentQuestion::TEXT_MAX_LENGTH,
                                        data: { "character-counter-target": "input", action: "input->character-counter#input" },
                                        class: "c-input u-w-full",
                                          disabled: input_disabled %>
                      <div class="c-help" data-character-counter-target="counter"><%= (answer_text || "").to_s.length %>/<%= StudentQuestion::TEXT_MAX_LENGTH %> characters</div>
                    </div>
                  <% when "multiple_choice" %>
                    <% option_pairs = question.answer_option_pairs.presence || [] %>
                    <% selected = answer_value.to_s %>
                    <div class="u-stack u-stack--sm" role="radiogroup">
                      <% option_pairs.each do |label, value| %>
                        <label class="c-choice-label">
                            <%= radio_button_tag "#{answer_param_key}[#{question.id}]",
                                               value,
                                               (selected == value.to_s || selected.casecmp?(label.to_s)),
                                               id: "question-#{question.id}-#{label.parameterize}",
                                               class: "c-choice",
                                                 disabled: input_disabled %>
                          <span><%= label %></span>
                        </label>

                        <% requires_text = question.answer_option_requires_text?(value) %>
                        <% if requires_text %>
                          <% other_text = if editable
                                            other_answers[question.id.to_s].to_s
                                          else
                                            if raw_answer.is_a?(Hash)
                                              (raw_answer["text"] || raw_answer[:text] || raw_answer["other_text"] || raw_answer[:other_text]).to_s
                                            else
                                              ""
                                            end
                                          end %>
                          <% show_other = (selected == value.to_s) || selected.casecmp?(label.to_s) || selected.casecmp?("Other") || other_text.present? %>
                          <div class="u-ml-xl <%= show_other ? "" : "hidden" %>" data-other-input-wrapper data-other-for-question-id="<%= question.id %>" data-other-choice-value="<%= value %>" aria-hidden="<%= show_other ? "false" : "true" %>" data-controller="character-counter">
                            <%= text_field_tag "#{other_param_key}[#{question.id}]",
                                               other_text,
                                               id: "question-#{question.id}-other",
                                               placeholder: "Please describe...",
                                               maxlength: StudentQuestion::TEXT_MAX_LENGTH,
                                               data: { "character-counter-target": "input", action: "input->character-counter#input" },
                                               class: "c-input u-w-full u-max-w-xl",
                                               disabled: (input_disabled || !show_other) %>
                            <div class="c-help" data-character-counter-target="counter"><%= other_text.to_s.length %>/<%= StudentQuestion::TEXT_MAX_LENGTH %> characters</div>
                          </div>
                        <% end %>
                      <% end %>
                    </div>
                  <% when "dropdown" %>
                    <% option_pairs = question.answer_option_pairs %>
                    <% selected_value = answer_value.to_s %>
                    <%= select_tag "#{answer_param_key}[#{question.id}]",
                                   options_for_select(option_pairs.map { |label, value| [label, value] }, selected_value),
                                   include_blank: true,
                                   disabled: input_disabled,
                                   id: "question-#{question.id}",
                                   class: "c-select u-w-full u-max-w-sm" %>

                    <% option_pairs.each do |label, value| %>
                      <% next unless question.answer_option_requires_text?(value) %>
                      <% other_text = if editable
                                        other_answers[question.id.to_s].to_s
                                      else
                                        if raw_answer.is_a?(Hash)
                                          (raw_answer["text"] || raw_answer[:text] || raw_answer["other_text"] || raw_answer[:other_text]).to_s
                                        else
                                          ""
                                        end
                                      end %>
                      <% show_other = (selected_value.to_s == value.to_s) || selected_value.casecmp?(label.to_s) || selected_value.casecmp?("Other") || other_text.present? %>
                      <div class="mt-sm u-max-w-xl <%= show_other ? "" : "hidden" %>" data-other-input-wrapper data-other-for-question-id="<%= question.id %>" data-other-choice-value="<%= value %>" aria-hidden="<%= show_other ? "false" : "true" %>" data-controller="character-counter">
                        <%= text_field_tag "#{other_param_key}[#{question.id}]",
                                           other_text,
                                           id: "question-#{question.id}-other-#{value.to_s.parameterize}",
                                           placeholder: "Please describe...",
                                           maxlength: StudentQuestion::TEXT_MAX_LENGTH,
                                           data: { "character-counter-target": "input", action: "input->character-counter#input" },
                                           class: "c-input u-w-full",
                                           disabled: (input_disabled || !show_other) %>
                        <div class="c-help" data-character-counter-target="counter"><%= other_text.to_s.length %>/<%= StudentQuestion::TEXT_MAX_LENGTH %> characters</div>
                      </div>
                    <% end %>
                  <% when "evidence" %>
                    <% link_value = answer_text.to_s.strip.presence %>
                    <% if editable %>
                      <div data-controller="character-counter">
                        <%= text_field_tag "#{answer_param_key}[#{question.id}]",
                                           link_value.to_s,
                                           id: "question-#{question.id}",
                                           placeholder: "https://sites.google.com/tamu.edu/...",
                                           maxlength: StudentQuestion::TEXT_MAX_LENGTH,
                                           data: { "character-counter-target": "input", action: "input->character-counter#input" },
                                           class: "c-input u-w-full",
                                           disabled: input_disabled %>
                        <div class="c-help" data-character-counter-target="counter"><%= link_value.to_s.length %>/<%= StudentQuestion::TEXT_MAX_LENGTH %> characters</div>
                      </div>
                    <% elsif link_value.present? %>
                      <%= link_to link_value,
                                  link_value,
                                  class: "c-input u-block u-w-full u-break-anywhere",
                                  target: "_blank",
                                  rel: "noopener noreferrer" %>
                    <% else %>
                      <div data-controller="character-counter">
                        <%= text_field_tag "#{answer_param_key}[#{question.id}]",
                                           "",
                                           id: "question-#{question.id}",
                                           placeholder: "https://sites.google.com/tamu.edu/...",
                                           maxlength: StudentQuestion::TEXT_MAX_LENGTH,
                                           data: { "character-counter-target": "input", action: "input->character-counter#input" },
                                           class: "c-input u-w-full",
                                           disabled: input_disabled %>
                        <div class="c-help" data-character-counter-target="counter">0/<%= StudentQuestion::TEXT_MAX_LENGTH %> characters</div>
                      </div>
                    <% end %>
                  <% else %>
                    <div data-controller="character-counter">
                      <%= text_field_tag "#{answer_param_key}[#{question.id}]",
                                         (answer_text || ""),
                                         id: "question-#{question.id}",
                                         maxlength: StudentQuestion::TEXT_MAX_LENGTH,
                                         data: { "character-counter-target": "input", action: "input->character-counter#input" },
                                         class: "c-input u-w-full",
                                         disabled: input_disabled %>
                      <div class="c-help" data-character-counter-target="counter"><%= (answer_text || "").to_s.length %>/<%= StudentQuestion::TEXT_MAX_LENGTH %> characters</div>
                    </div>
                  <% end %>

                </article>

                <%# Read-only: render existing advisor feedback under the end of each
                    parent question group (parent + any sub-questions). %>
                <% if !include_feedback_form %>
                  <% end_of_parent_group = if is_sub_question
                                             next_question.nil? || !next_question.sub_question? || next_question.parent_question_id != question.parent_question_id
                                           else
                                             next_question.nil? || !next_question.sub_question?
                                           end %>

                  <% if end_of_parent_group %>
                    <% feedback_question = is_sub_question ? questions_by_id[question.parent_question_id] : question %>
                    <% feedback_question_id = feedback_question&.id %>
                    <% supports_feedback = feedback_question && (!feedback_question.respond_to?(:has_feedback?) || feedback_question.has_feedback?) %>

                    <% if supports_feedback %>
                      <% next if viewer_is_student_owner && category.name.to_s.strip.downcase == 'employment information' %>
                      <% fb = feedback_question_id ? per_question_map[feedback_question_id] : nil %>
                      <% if fb.present? %>
                        <% feedback_submission = fb.advisor_id.present? ? feedback_submissions_by_advisor[fb.advisor_id] : nil %>
                        <% feedback_submitted = feedback_submission&.submitted_at.present? %>
                        <% feedback_is_draft = !feedback_submitted %>
                        <article class="c-question-card c-card--advisor u-stack u-stack--sm">
                          <div class="u-actions u-actions--split">
                            <h5 class="c-h3 u-min-w-0">Advisor feedback — #<%= question_number %></h5>
                            <div class="u-actions u-actions--start u-min-w-0">
                              <% if !viewer_is_student_owner && feedback_is_draft %>
                                <span class="<%= feedback_status_badge_classes('Draft') %>">Draft</span>
                              <% end %>
                              <p class="c-help u-break-anywhere">Score: <%= fb.average_score != nil ? proficiency_label_for(fb.average_score, feedback_question) : '—' %></p>
                            </div>
                          </div>
                          <% if fb.comments.present? %>
                            <div class="c-rich-text text-sm u-break-anywhere"><%= fb.comments %></div>
                          <% end %>
                          <% if !viewer_is_student_owner && feedback_is_draft %>
                            <p class="c-help">Draft feedback is only visible to advisors/admins until submitted.</p>
                          <% end %>
                          <div class="c-help">By: <%= fb&.advisor&.user&.name || '—' %></div>
                        </article>
                      <% end %>
                    <% end %>
                  <% end %>
                <% end %>

                <%# Advisor feedback entry is only collected for parent questions in the
                    "MHA Competency Self-Assessment" section (mirrors the completing-survey experience). %>
                <% if include_feedback_form %>
                  <% end_of_parent_group = if is_sub_question
                                             next_question.nil? || !next_question.sub_question? || next_question.parent_question_id != question.parent_question_id
                                           else
                                             next_question.nil? || !next_question.sub_question?
                                           end %>

                  <% if end_of_parent_group %>
                    <% feedback_question = is_sub_question ? questions_by_id[question.parent_question_id] : question %>
                    <% feedback_question_id = feedback_question&.id %>
                    <% supports_feedback = feedback_question && (!feedback_question.respond_to?(:has_feedback?) || feedback_question.has_feedback?) %>
                    <% existing_q = (feedback_question_id && passed_existing_feedbacks) ? passed_existing_feedbacks[feedback_question_id] : nil %>
                    <% question_prefix = section&.mha_competency? ? "#" : "Q" %>
                    <% if supports_feedback %>
                    <% advisor_numeric_enabled = survey&.advisor_numeric_feedback_enabled? %>
                    <% missing_score = advisor_numeric_enabled && missing_feedback_question_ids.include?(feedback_question_id.to_i) %>
                    <article class="c-question-card c-card--advisor u-stack u-stack--md"
                             data-advisor-feedback-block
                             data-feedback-question-id="<%= feedback_question_id %>">
                    <div class="u-actions u-actions--split">
                      <h5 class="c-h3">Advisor feedback — <%= question_prefix %><%= question_number %></h5>
                      <p class="c-help"><%= advisor_numeric_enabled ? "Score 0-5, feedback optional" : "Written feedback optional; numeric ratings are retired for this survey" %></p>
                    </div>

                      <div class="u-grid u-grid--stats">
                      <% if advisor_numeric_enabled %>
                        <div class="c-field">
                          <label class="c-label" for="ratings_<%= feedback_question_id %>_average_score">Score (0-5)</label>
                          <%= render "shared/proficiency_select",
                                     id: "ratings_#{feedback_question_id}_average_score",
                                     name: "ratings[#{feedback_question_id}][average_score]",
                                     question: feedback_question,
                                     selected: normalize_proficiency_value(existing_q&.average_score),
                                     data: {
                                       advisor_feedback_score: true,
                                       required_advisor_rating: true,
                                       feedback_question_id: feedback_question_id,
                                       program_target_level: effective_competency_target_level(question: feedback_question, survey: survey, student: sr&.student)
                                     },
                                     class_name: "c-select u-w-full u-max-w-sm #{missing_score ? 'c-question-card--error' : ''}" %>
                          <% if missing_score %>
                            <p class="c-help u-danger">Advisor Rating is required before submission.</p>
                          <% end %>
                        </div>
                      <% end %>

                      <div class="c-field <%= advisor_numeric_enabled ? '' : 'u-col-span-all' %>" data-controller="character-counter">
                        <label class="c-label" for="ratings_<%= feedback_question_id %>_comments">Feedback (optional)</label>
                        <textarea id="ratings_<%= feedback_question_id %>_comments"
                                  name="ratings[<%= feedback_question_id %>][comments]"
                                  rows="3"
                                  maxlength="<%= Feedback::COMMENTS_MAX_LENGTH %>"
                                  data-character-counter-target="input"
                                  data-action="input->character-counter#input"
                                  class="c-input u-w-full"><%= existing_q&.comments.to_s %></textarea>
                        <div class="c-help" data-character-counter-target="counter"><%= existing_q&.comments.to_s.length %>/<%= Feedback::COMMENTS_MAX_LENGTH %> characters</div>
                      </div>
                    </div>

                    <% if existing_q %>
                      <input type="hidden" name="ratings[<%= feedback_question_id %>][id]" value="<%= existing_q.id %>" />
                      <input type="hidden" name="ratings[<%= feedback_question_id %>][lock_version]" value="<%= existing_q.lock_version %>" />
                    <% end %>
                  </article>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <p class="c-card c-card--tight c-card--dashed c-muted text-sm">No questions for this competency.</p>
          <% end %>
        </section>
        </div>
        <%# per-question feedback inputs are rendered inline with each question above %>
      <% end %>
    </div>
  <% else %>
    <div class="c-card c-card--tight c-field">
      <label class="c-label">Response</label>
      <%= text_area_tag nil,
                        (sr&.question_responses&.first&.answer || ""),
                        maxlength: StudentQuestion::TEXT_MAX_LENGTH,
                        class: "c-input u-w-full", disabled: true %>
    </div>
  <% end %>

  <%# Ensure newly added sections appear even if they have no categories yet. %>
  <% if survey.present? %>
    <% SurveySection.where(survey_id: survey.id).ordered.each do |section| %>
      <% next if rendered_section_ids.include?(section.id) %>
      <div class="u-stack u-stack--md">
        <div id="survey-section-<%= section.id %>" class="c-card c-card--student u-stack u-stack--sm text-left">
          <p class="c-eyebrow">Section</p>
          <h2 class="c-h2"><%= section.title %></h2>
          <% if section.description.present? && !section.mha_competency? %>
            <div class="c-rich-text text-sm"><%= render_markdown(section.description) %></div>
          <% end %>

          <% if section.mha_competency? %>
            <div class="c-card c-card--warning c-card--tight c-rich-text text-sm">
              <%= render_markdown(section.description) %>
            </div>
          <% end %>
        </div>

        <div class="c-card c-card--tight c-card--dashed c-muted text-sm">
          No competencies are configured in this section yet.
        </div>
      </div>
    <% end %>
  <% end %>

  <%# Legacy fallback: if there are only category-level legacy feedback entries, keep a minimal
      section at the bottom so older data doesn't disappear entirely. %>
  <% if !include_feedback_form && per_category_legacy.any? %>
    <section class="c-card c-card--warning u-stack u-stack--sm">
      <h3 class="c-h3">Advisor feedback (legacy)</h3>
      <p class="c-help">This survey response contains older feedback entries that are not attached to individual questions.</p>
    </section>
  <% end %>
  
</div>
