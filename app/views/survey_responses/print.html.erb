<%# Print view: render a header and the existing survey_response partial for printing or client-side PDF export %>
<% sr = local_assigns[:survey_response] || @survey_response %>
<% survey = sr&.survey %>

<%- content_for :header do -%>
  <div class="u-actions u-actions--split">
    <div>
      <div class="c-item-title"><%= survey&.title.presence || "Survey ##{survey&.id}" %></div>
      <div class="c-help">Student: <%= sr&.student&.user&.name.presence || "Student ##{sr&.student_id}" %></div>
    </div>
    <div class="c-help u-text-right">
      <div>Printed: <%= Time.current.strftime('%Y-%m-%d') %></div>
    </div>
  </div>
<%- end -%>

<div class="u-actions u-actions--split">
  <div>
    <a href="<%= student_dashboard_path %>" class="<%= button_classes(:secondary) %>">← Back</a>
  </div>
  <div>
    <button onclick="window.print();" class="<%= button_classes(:primary) %>">Print</button>
  </div>
</div>

<%= render partial: 'survey_response', locals: { survey_response: sr } %>
