<% content_for :title, "Edit Student Profile" %>

<% full_name = @student.full_name.presence || @student.user&.name || "Student" %>
<% email = @student.email.presence || "Not provided" %>
<% uin = @student.uin.presence || "Not provided" %>
<% track = @student.track.present? ? @student.track.to_s.titleize : "Not assigned" %>
<% program_year = @student.program_year.presence || "Not set" %>
<% major = @student.major.presence || "Program TBD" %>
<% advisor_name = @student.advisor&.display_name || @student.advisor&.name || "Advisor pending" %>
<% member_since = @student.created_at ? @student.created_at.strftime("%b %-d, %Y") : "Recently" %>
<% updated_text = @student.updated_at ? "#{time_ago_in_words(@student.updated_at)} ago" : "Just now" %>
<% initials = full_name.split.first(2).map { |part| part.first&.upcase }.join.presence || "ST" %>
<% avatar_url = @student.avatar_url.presence %>
<% profile_complete = @student.profile_complete? %>

<main class="c-main c-page">
  <section class="c-card c-card--brand c-card--spacious u-stack u-stack--lg">
    <header class="c-page-header">
      <div class="u-stack u-stack--md">
        <div>
          <p class="c-eyebrow">Edit student profile</p>
          <h1 class="c-page-title c-page-title--brand"><%= full_name %></h1>
          <p class="c-page-subtitle">Update your program information, advisor, and account details.</p>
        </div>

        <div class="u-actions u-actions--start u-gap-xs">
          <span class="c-status-pill <%= profile_complete ? 'c-status-pill--success' : 'c-status-pill--warning' %>">
            <%= profile_complete ? "Profile complete" : "Profile needs updates" %>
          </span>
          <span class="c-pill c-pill--muted"><%= track %></span>
          <span class="c-pill c-pill--muted"><%= program_year %></span>
        </div>
      </div>

      <div class="u-responsive-row u-items-center">
        <div class="c-avatar-tile u-size-2xl text-xl" <%= "role=\"img\" aria-label=\"#{avatar_aria_label(@student.user)}\"" unless avatar_url %>>
          <% if avatar_url %>
            <img src="<%= avatar_url %>" alt="<%= avatar_aria_label(@student.user) %>" loading="lazy">
          <% else %>
            <span aria-hidden="true"><%= initials %></span>
            <span class="sr-only"><%= avatar_aria_label(@student.user) %></span>
          <% end %>
        </div>
      </div>
    </header>

    <div class="u-grid u-grid--stats">
      <article class="c-kv c-kv--compact">
        <p class="c-eyebrow">Major / Program</p>
        <p class="c-value c-value--lg"><%= major %></p>
      </article>
      <article class="c-kv c-kv--compact">
        <p class="c-eyebrow">Program year</p>
        <p class="c-value c-value--lg"><%= program_year %></p>
      </article>
      <article class="c-kv c-kv--compact">
        <p class="c-eyebrow">Advisor</p>
        <p class="c-value c-value--lg"><%= advisor_name %></p>
      </article>
      <article class="c-kv c-kv--compact">
        <p class="c-eyebrow">Last updated</p>
        <p class="c-value c-value--lg"><%= updated_text %></p>
      </article>
    </div>
  </section>

  <%= form_with model: @student, url: student_profile_path, method: :patch, local: true do |form| %>
    <section class="c-student-overview-layout">
      <aside class="c-student-overview-sidebar c-card c-card--tight u-stack u-stack--lg">
        <header class="u-stack u-stack--sm">
          <p class="c-eyebrow">Account</p>
          <h2 class="c-section-title">Identity</h2>
        </header>

        <dl class="c-key-value-list">
          <div>
            <dt>Full name</dt>
            <dd><%= full_name %></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><%= email %></dd>
          </div>
          <div>
            <dt>UIN</dt>
            <dd><%= uin %></dd>
          </div>
          <div>
            <dt>Member since</dt>
            <dd><%= member_since %></dd>
          </div>
        </dl>
      </aside>

      <section class="c-student-overview-main c-card c-card--tight u-stack u-stack--lg">
        <header class="u-stack u-stack--sm">
          <p class="c-eyebrow">Program</p>
          <h2 class="c-section-title">Academic Details</h2>
        </header>

        <% if @student.errors.any? %>
          <div class="c-card c-card--tight c-card--danger u-shadow-none">
            <h3 class="c-h3">
              <%= pluralize(@student.errors.count, "error") %> need your attention before saving
            </h3>
            <ul class="c-rich-text">
              <% @student.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="u-grid u-grid--form">
          <div class="c-kv c-kv--compact">
            <div class="c-field">
              <%= form.label :uin, "UIN", class: "c-label" %>
              <%= form.text_field :uin,
                                  placeholder: "Enter your 9-digit UIN",
                                  required: true,
                                  inputmode: "numeric",
                                  autocomplete: "off",
                                  maxlength: 9,
                                  pattern: "\\d{9}",
                                  class: "c-input" %>
              <small class="c-help">Your 9-digit University ID</small>
            </div>
          </div>

          <div class="c-kv c-kv--compact">
            <div class="c-field">
              <%= form.label :program_year, "Program year", class: "c-label" %>
              <% program_year_options = ProgramYear.values.map { |year| [ year.to_s, year ] } %>
              <%= form.select :program_year,
                              options_for_select(program_year_options, @student.program_year.to_i.presence),
                              { prompt: "Select your graduation year" },
                              { required: true, class: "c-select u-w-full" } %>
              <small class="c-help">Select your graduation year used for survey assignment.</small>
            </div>
          </div>

          <div class="c-kv c-kv--compact">
            <div class="c-field">
              <%= form.label :major, "Major / Program", class: "c-label" %>
              <%= form.select :major,
                              options_for_select(@majors.map { |m| [ m.name, m.name ] }, @student.major.to_s),
                              { prompt: "Select your major" },
                              { required: true, class: "c-select u-w-full" } %>
            </div>
          </div>

          <div class="c-kv c-kv--compact">
            <div class="c-field">
              <%= form.label :track, "Program track", class: "c-label" %>
              <% track_options = Student.tracks.map { |key, label| [ label, key ] } %>
              <%= form.select :track,
                              options_for_select(track_options, @student.track_key.to_s),
                              { prompt: "Select your track" },
                              { required: true, class: "c-select u-w-full" } %>
              <small class="c-help">Pick the program track you belong to.</small>
            </div>
          </div>

          <div class="c-kv c-kv--compact u-col-span-all">
            <div class="c-field">
              <%= form.label :advisor_id, "Advisor", class: "c-label" %>
              <%= form.select :advisor_id,
                              options_from_collection_for_select(@advisors, :advisor_id, :name, @student.advisor_id),
                              { prompt: "Select your advisor (optional)" },
                              { class: "c-select u-w-full" } %>
            </div>
          </div>
        </div>

        <div class="u-actions u-actions--split u-section-divider">
          <%= link_to student_profile_path, class: button_classes(:secondary) do %>
            Cancel
          <% end %>

          <%= form.submit "Save profile", class: button_classes(:primary) %>
        </div>
      </section>
    </section>
  <% end %>
</main>
