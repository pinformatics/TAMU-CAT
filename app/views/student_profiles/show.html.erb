<% content_for :title, "Student Profile" %>

<% full_name = @student.full_name.presence || @student.user&.name || "Student" %>
<% email = @student.email.presence || "Not provided" %>
<% uin = @student.uin.presence || "Not provided" %>
<% track = @student.track.present? ? @student.track.to_s.titleize : "Not assigned" %>
<% program_year = @student.program_year.presence || "Not set" %>
<% major = @student.major.presence || "Program TBD" %>
<% advisor_name = @student.advisor&.display_name || @student.advisor&.name || "Advisor pending" %>
<% member_since = @student.created_at ? @student.created_at.strftime("%b %-d, %Y") : "Recently" %>
<% updated_text = @student.updated_at ? "#{time_ago_in_words(@student.updated_at)} ago" : "Just now" %>
<% initials = full_name.split.first(2).map { |part| part.first&.upcase }.join.presence || "ST" %>
<% avatar_url = @student.avatar_url.presence %>
<% profile_complete = @student.profile_complete? %>

<main class="c-main c-page">
  <section class="c-card c-card--brand c-card--spacious u-stack u-stack--lg">
    <header class="c-page-header">
      <div class="u-stack u-stack--md">
        <div>
          <p class="c-eyebrow">Student profile</p>
          <h1 class="c-page-title c-page-title--brand"><%= full_name %></h1>
          <p class="c-page-subtitle">Review your program information, advisor, and account details.</p>
        </div>

        <div class="u-actions u-actions--start u-gap-xs">
          <span class="c-status-pill <%= profile_complete ? 'c-status-pill--success' : 'c-status-pill--warning' %>">
            <%= profile_complete ? "Profile complete" : "Profile needs updates" %>
          </span>
          <span class="c-pill c-pill--muted"><%= track %></span>
          <span class="c-pill c-pill--muted"><%= program_year %></span>
        </div>
      </div>

      <div class="u-responsive-row u-items-center">
        <div class="c-avatar-tile u-size-2xl text-xl" <%= "role=\"img\" aria-label=\"#{avatar_aria_label(@student.user)}\"" unless avatar_url %>>
          <% if avatar_url %>
            <img src="<%= avatar_url %>" alt="<%= avatar_aria_label(@student.user) %>" loading="lazy">
          <% else %>
            <span aria-hidden="true"><%= initials %></span>
            <span class="sr-only"><%= avatar_aria_label(@student.user) %></span>
          <% end %>
        </div>
      </div>
    </header>

    <div class="u-grid u-grid--stats">
      <article class="c-kv c-kv--compact">
        <p class="c-eyebrow">Major / Program</p>
        <p class="c-value c-value--lg"><%= major %></p>
      </article>
      <article class="c-kv c-kv--compact">
        <p class="c-eyebrow">Program year</p>
        <p class="c-value c-value--lg"><%= program_year %></p>
      </article>
      <article class="c-kv c-kv--compact">
        <p class="c-eyebrow">Advisor</p>
        <p class="c-value c-value--lg"><%= advisor_name %></p>
      </article>
      <article class="c-kv c-kv--compact">
        <p class="c-eyebrow">Last updated</p>
        <p class="c-value c-value--lg"><%= updated_text %></p>
      </article>
    </div>
  </section>

  <section class="c-student-overview-layout">
    <aside class="c-student-overview-sidebar c-card c-card--tight u-stack u-stack--lg">
      <header class="u-stack u-stack--sm">
        <p class="c-eyebrow">Account</p>
        <h2 class="c-section-title">Identity</h2>
      </header>

      <dl class="c-key-value-list">
        <div>
          <dt>Full name</dt>
          <dd><%= full_name %></dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><%= email %></dd>
        </div>
        <div>
          <dt>UIN</dt>
          <dd><%= uin %></dd>
        </div>
        <div>
          <dt>Member since</dt>
          <dd><%= member_since %></dd>
        </div>
      </dl>
    </aside>

    <section class="c-student-overview-main c-card c-card--tight u-stack u-stack--lg">
      <header class="u-stack u-stack--sm">
        <p class="c-eyebrow">Program</p>
        <h2 class="c-section-title">Academic Details</h2>
      </header>

      <dl class="c-key-value-list">
        <div>
          <dt>Major / Program</dt>
          <dd><%= major %></dd>
        </div>
        <div>
          <dt>Program year</dt>
          <dd><%= program_year %></dd>
        </div>
        <div>
          <dt>Program track</dt>
          <dd><%= track %></dd>
        </div>
        <div>
          <dt>Advisor</dt>
          <dd><%= advisor_name %></dd>
        </div>
      </dl>

      <div class="u-actions u-actions--split u-section-divider">
        <%= link_to student_dashboard_path, class: button_classes(:secondary) do %>
          Back to dashboard
        <% end %>

        <%= link_to edit_student_profile_path, class: button_classes(:primary) do %>
          Edit profile
        <% end %>
      </div>
    </section>
  </section>
</main>
