<main class="c-main c-main--dashboard">
  <div class="c-page">
    <section class="c-card c-card--brand">
      <header class="c-page-header">
        <div>
          <p class="c-eyebrow">Admin tools</p>
          <h1 class="c-page-title c-page-title--brand">Maintenance Mode</h1>
          <p class="c-page-subtitle">Redirect the site to the public maintenance page for non-admin users.</p>
        </div>

        <div class="u-actions">
          <%= link_to "Back", admin_dashboard_path, class: button_classes(:secondary), data: { turbo: false } %>
          <span class="c-status-badge <%= @maintenance_enabled ? 'c-status-badge--success' : 'c-status-badge--muted' %>">
            <%= @maintenance_enabled ? "Enabled" : "Disabled" %>
          </span>
        </div>
      </header>
    </section>

    <section class="u-stack u-stack--lg">
      <section class="c-card c-card--spacious u-stack u-stack--lg">
        <div class="u-responsive-split u-items-start">
          <div class="u-stack u-stack--sm">
            <p class="c-eyebrow">Current status</p>
            <h2 class="c-section-title c-heading-inline">
              <%= @maintenance_enabled ? "Maintenance redirect is active" : "Normal access is active" %>
            </h2>
            <p class="c-lede">
              <% if @maintenance_enabled %>
                Non-admin users are redirected to the public maintenance page. Admins can still sign in and manage the portal.
              <% else %>
                Students and advisors can access the portal normally. Turn this on only when the site should be unavailable during support work.
              <% end %>
            </p>
          </div>

          <%= form_with url: admin_maintenance_path, method: :patch, data: { turbo: true } do %>
            <%= hidden_field_tag :enabled, "0" %>
            <%= render ToggleSwitchComponent.new(
              id: "maintenance-mode-toggle",
              name: "enabled",
              checked: @maintenance_enabled,
              label: nil,
              confirm_on: "Turn ON maintenance mode? Non-admin users will be redirected to the maintenance page.",
              confirm_off: "Turn OFF maintenance mode? Users will regain access immediately."
            ) %>
          <% end %>
        </div>

        <div class="c-callout <%= @maintenance_enabled ? 'c-callout--warning' : 'c-callout--info' %>">
          <div class="c-callout__title">
            <%= @maintenance_enabled ? "Students and advisors are redirected" : "Maintenance mode is off" %>
          </div>
          <p>
            Public page:
            <%= link_to maintenance_path, class: "u-link" do %>
              <strong>/maintenance</strong>
            <% end %>
          </p>
        </div>
      </section>

      <section class="c-card c-card--spacious u-stack u-stack--md">
        <div>
          <p class="c-eyebrow">Availability</p>
          <h2 class="c-section-title c-heading-inline">What stays available</h2>
        </div>

        <div class="c-timeline" role="list">
          <div class="c-timeline__item" role="listitem">
            <span class="c-dot c-dot--brand" aria-hidden="true"></span>
            <div class="u-stack u-stack--sm">
              <div class="c-h3">Admin access</div>
              <p class="c-lede">Admins can browse and manage the portal normally.</p>
            </div>
          </div>

          <div class="c-timeline__item" role="listitem">
            <span class="c-dot c-dot--muted" aria-hidden="true"></span>
            <div class="u-stack u-stack--sm">
              <div class="c-h3">Sign-in flow</div>
              <p class="c-lede">Authentication endpoints remain reachable so you can always get back in.</p>
            </div>
          </div>

          <div class="c-timeline__item" role="listitem">
            <span class="c-dot c-dot--muted" aria-hidden="true"></span>
            <div class="u-stack u-stack--sm">
              <div class="c-h3">Public maintenance page</div>
              <p class="c-lede">Users will land on a friendly status page with support contact info.</p>
            </div>
          </div>
        </div>
      </section>
    </section>
  </div>
</main>
