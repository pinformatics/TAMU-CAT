<main class="c-main c-main--dashboard">
  <% tabs = [
    ["Tracks", "tracks", "Manage the available program tracks across the portal."],
    ["Majors", "majors", "Control the degree and major options students can select."],
    ["Cohorts", "years", "Maintain class-year options used for reporting and assignment."],
    ["Semesters", "semesters", "Define survey terms and choose the current active semester."],
    ["Competency Targets", "targets", "Set benchmark proficiency targets by semester, track, and class."]
  ] %>

  <div class="c-page">
    <section class="c-card c-card--brand">
      <header class="c-page-header">
        <div>
          <p class="c-eyebrow">Academic setup</p>
          <h1 class="c-page-title c-page-title--brand">Program Configuration</h1>
          <p class="c-page-subtitle">Manage program structure and competency targets in one place.</p>
        </div>
        <%= link_to "Back", admin_dashboard_path, class: button_classes(:secondary), data: { turbo: false } %>
      </header>
    </section>

    <section class="c-card c-card--spacious u-stack u-stack--md">
      <div class="u-stack u-stack--sm">
        <h2 class="c-section-title c-heading-inline">Workspace</h2>
        <p class="c-lede">Choose the area you want to manage.</p>
      </div>

      <nav class="u-grid" style="--u-grid-min: 220px;" aria-label="Program setup tabs">
        <% tabs.each do |label, value, description| %>
          <% active = (@tab == value) %>
          <%= link_to admin_program_setup_path(tab: value), class: "c-card c-card--tight #{active ? '' : 'c-card--muted'}", aria: (active ? { current: "page" } : {}) do %>
            <div class="u-stack u-stack--sm">
              <div class="c-h3"><%= label %></div>
              <p class="c-lede"><%= description %></p>
            </div>
          <% end %>
        <% end %>
      </nav>
    </section>

    <% if @tab == "tracks" %>
      <section class="c-card c-card--spacious u-stack u-stack--md">
        <header class="c-toolbar__row c-toolbar__row--airy u-justify-between">
          <div>
            <h2 class="c-panel-title">Tracks</h2>
            <p class="c-panel-subtitle">View and manage the track options available across the app.</p>
          </div>
        </header>

        <div class="c-two-column-layout">
          <div class="u-stack u-stack--md">
            <% if @program_tracks.blank? %>
              <div class="c-empty-state"><p class="c-empty-state__body">No tracks yet. Use the form to create your first entry.</p></div>
            <% else %>
              <ul class="c-compact-list">
                <% @program_tracks.each do |track| %>
                  <li class="c-card c-card--tight">
                    <div class="u-responsive-split u-items-start">
                      <div class="u-stack u-stack--sm">
                        <p class="c-table__title"><%= track.name %></p>
                      </div>

                      <details>
                        <summary class="u-cursor-pointer u-list-none <%= button_classes(:secondary, extra_classes: 'btn-sm') %>">Edit</summary>
                        <div class="c-card c-card--tight c-card--muted u-mt-sm">
                          <%= form_with model: [:admin, track], local: true, class: "u-stack u-stack--md" do |form| %>
                            <div class="u-grid u-grid--2">
                              <div class="c-field"><%= form.label :name, "Name", class: "c-label" %><%= form.text_field :name, required: true, class: "c-input" %></div>
                              <div class="c-field"><%= form.label :key, "Key", class: "c-label" %><%= form.text_field :key, class: "c-input" %></div>
                              <div class="c-field"><%= form.label :position, "Position", class: "c-label" %><%= form.number_field :position, min: 0, step: 1, class: "c-input" %></div>
                              <label class="c-choice-label"><%= form.check_box :active, class: "c-choice" %><span>Active</span></label>
                            </div>
                            <div class="u-actions u-actions--start">
                              <%= form.submit "Save changes", class: button_classes(:primary, extra_classes: "btn-sm") %>
                            </div>
                          <% end %>
                          <div class="u-actions u-actions--start u-mt-sm">
                            <%= button_to "Delete", admin_program_track_path(track), method: :delete, data: { turbo_confirm: "Delete #{track.name}?" }, class: button_classes(:danger, extra_classes: "btn-sm") %>
                          </div>
                        </div>
                      </details>
                    </div>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </div>

          <div class="c-card c-card--tight c-card--muted">
            <h3 class="c-panel-title">Add Track</h3>
            <p class="c-panel-subtitle">Name tracks consistently, for example Residential.</p>
            <%= form_with model: [:admin, @new_program_track], url: admin_program_tracks_path, local: true, class: "u-stack u-stack--md" do |form| %>
              <div class="c-field"><%= form.label :name, "Track name", class: "c-label" %><%= form.text_field :name, required: true, class: "c-input", placeholder: "Residential" %></div>
              <%= form.submit "Save track", class: button_classes(:primary) %>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>

    <% if @tab == "majors" %>
      <section class="c-card c-card--spacious u-stack u-stack--md">
        <header class="c-toolbar__row c-toolbar__row--airy u-justify-between">
          <div>
            <h2 class="c-panel-title">Majors</h2>
            <p class="c-panel-subtitle">View and manage majors available for student profiles.</p>
          </div>
        </header>

        <div class="c-two-column-layout">
          <div class="u-stack u-stack--md">
            <% if @majors.blank? %>
              <div class="c-empty-state"><p class="c-empty-state__body">No majors yet. Use the form to create your first entry.</p></div>
            <% else %>
              <ul class="c-compact-list">
                <% @majors.each do |major| %>
                  <li class="c-card c-card--tight">
                    <div class="u-responsive-split u-items-start">
                      <div class="u-stack u-stack--sm">
                        <p class="c-table__title"><%= major.name %></p>
                      </div>

                      <details>
                        <summary class="u-cursor-pointer u-list-none <%= button_classes(:secondary, extra_classes: 'btn-sm') %>">Edit</summary>
                        <div class="c-card c-card--tight c-card--muted u-mt-sm">
                          <%= form_with model: [:admin, major], local: true, class: "u-stack u-stack--md" do |form| %>
                            <div class="c-field"><%= form.label :name, "Name", class: "c-label" %><%= form.text_field :name, required: true, class: "c-input" %></div>
                            <div class="u-actions u-actions--start"><%= form.submit "Save changes", class: button_classes(:primary, extra_classes: "btn-sm") %></div>
                          <% end %>
                          <div class="u-actions u-actions--start u-mt-sm">
                            <%= button_to "Delete", admin_major_path(major), method: :delete, data: { turbo_confirm: "Delete #{major.name}?" }, class: button_classes(:danger, extra_classes: "btn-sm") %>
                          </div>
                        </div>
                      </details>
                    </div>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </div>

          <div class="c-card c-card--tight c-card--muted">
            <h3 class="c-panel-title">Add Major</h3>
            <p class="c-panel-subtitle">Example: Health Administration.</p>
            <%= form_with model: [:admin, @new_major], url: admin_majors_path, local: true, class: "u-stack u-stack--md" do |form| %>
              <div class="c-field"><%= form.label :name, "Major / Program name", class: "c-label" %><%= form.text_field :name, required: true, class: "c-input" %></div>
              <%= form.submit "Save major", class: button_classes(:primary) %>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>

    <% if @tab == "years" %>
      <section class="c-card c-card--compact u-stack u-stack--md">
        <header class="c-toolbar__row c-toolbar__row--airy u-justify-between">
          <div>
            <h2 class="c-panel-title">Cohort Years</h2>
            <p class="c-panel-subtitle">Manage class-year options used for assignments and reports.</p>
          </div>
        </header>

        <div class="c-management-layout">
          <div class="u-stack u-stack--sm">
            <% if @program_years.blank? %>
              <div class="c-empty-state c-empty-state--compact"><p class="c-empty-state__body">No cohorts yet. Add the first class year.</p></div>
            <% else %>
              <div class="c-management-list">
                <% @program_years.each do |year| %>
                  <details class="c-management-item">
                    <summary class="c-management-item__summary">
                      <span class="c-table__title">Class of <%= year.value %></span>
                      <span class="<%= button_classes(:secondary, extra_classes: 'btn-sm') %>">Edit</span>
                    </summary>

                    <div class="c-management-item__body u-stack u-stack--md">
                      <%= form_with model: [:admin, year], local: true, class: "u-stack u-stack--md" do |form| %>
                        <div class="u-grid u-grid--2">
                          <div class="c-field"><%= form.label :value, "Class of year", class: "c-label" %><%= form.number_field :value, required: true, min: 2026, max: 3000, step: 1, class: "c-input" %></div>
                          <div class="c-field"><%= form.label :position, "Position", class: "c-label" %><%= form.number_field :position, min: 0, step: 1, class: "c-input" %></div>
                          <label class="c-choice-label"><%= form.check_box :active, class: "c-choice" %><span>Active</span></label>
                        </div>
                        <div class="u-actions u-actions--start"><%= form.submit "Save changes", class: button_classes(:primary, extra_classes: "btn-sm") %></div>
                      <% end %>
                      <div class="u-actions u-actions--start">
                        <%= button_to "Delete", admin_program_year_path(year), method: :delete, data: { turbo_confirm: "Delete Class of #{year.value}?" }, class: button_classes(:danger, extra_classes: "btn-sm") %>
                      </div>
                    </div>
                  </details>
                <% end %>
              </div>
            <% end %>
          </div>

          <aside class="c-card c-card--compact c-card--muted u-stack u-stack--md">
            <h3 class="c-panel-title">Add Cohort Year</h3>
            <%= form_with model: [:admin, @new_program_year], url: admin_program_years_path, local: true, class: "u-stack u-stack--md" do |form| %>
              <div class="c-field"><%= form.label :value, "Class of year", class: "c-label" %><%= form.number_field :value, required: true, min: 2026, max: 3000, step: 1, class: "c-input" %></div>
              <%= form.submit "Save cohort", class: button_classes(:primary) %>
            <% end %>
          </aside>
        </div>
      </section>
    <% end %>

    <% if @tab == "semesters" %>
      <section class="c-card c-card--spacious u-stack u-stack--md">
        <header class="c-toolbar__row c-toolbar__row--airy u-justify-between">
          <div>
            <h2 class="c-panel-title">Program Semesters</h2>
            <p class="c-panel-subtitle">View and manage semesters used for survey assignment windows.</p>
          </div>
          <% if @current_program_semester.present? %>
            <span class="c-status-badge c-status-badge--success">Current: <%= @current_program_semester.name %></span>
          <% else %>
            <span class="c-status-pill c-status-pill--warning">No current semester set</span>
          <% end %>
        </header>

        <div class="c-two-column-layout">
          <div class="u-stack u-stack--md">
            <% if @program_semesters.blank? %>
              <div class="c-empty-state"><p class="c-empty-state__body">No semesters yet. Use the form to create your first entry.</p></div>
            <% else %>
              <ul class="c-compact-list">
                <% @program_semesters.each do |semester| %>
                  <li class="c-card c-card--tight">
                    <div class="u-responsive-split u-items-start">
                      <div class="u-stack u-stack--sm">
                        <p class="c-table__title"><%= semester.name %></p>
                      </div>

                      <div class="u-actions">
                        <details>
                          <summary class="u-cursor-pointer u-list-none <%= button_classes(:secondary, extra_classes: 'btn-sm') %>">Edit</summary>
                          <div class="c-card c-card--tight c-card--muted u-mt-sm">
                            <% unless semester.current? %>
                              <div class="u-actions u-actions--start">
                                <%= button_to "Make current", make_current_admin_program_semester_path(semester), method: :patch, class: button_classes(:subtle, extra_classes: "btn-sm") %>
                              </div>
                            <% end %>
                            <%= form_with model: [:admin, semester], local: true, class: "u-stack u-stack--md" do |form| %>
                              <div class="c-field"><%= form.label :name, "Semester name", class: "c-label" %><%= form.text_field :name, required: true, class: "c-input" %></div>
                              <div class="u-actions u-actions--start"><%= form.submit "Save changes", class: button_classes(:primary, extra_classes: "btn-sm") %></div>
                            <% end %>
                            <div class="u-actions u-actions--start u-mt-sm">
                              <%= button_to "Delete", admin_program_semester_path(semester), method: :delete, data: { turbo_confirm: "Delete #{semester.name}?" }, class: button_classes(:danger, extra_classes: "btn-sm") %>
                            </div>
                          </div>
                        </details>
                      </div>
                    </div>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </div>

          <div class="c-card c-card--tight c-card--muted">
            <h3 class="c-panel-title">Add Semester</h3>
            <p class="c-panel-subtitle">Name semesters consistently, for example Fall 2026.</p>
            <%= form_with model: [:admin, @new_program_semester], url: admin_program_semesters_path, local: true, class: "u-stack u-stack--md" do |form| %>
              <div class="c-field"><%= form.label :name, "Semester name", class: "c-label" %><%= form.text_field :name, required: true, class: "c-input", placeholder: "Fall 2026" %></div>
              <label class="c-choice-label c-choice-label--top">
                <%= form.check_box :current, class: "c-choice" %>
                <span>
                  <span class="c-table__title">Set as current semester</span>
                  <span class="c-help">Existing current semester will be turned off automatically.</span>
                </span>
              </label>
              <%= form.submit "Save semester", class: button_classes(:primary) %>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>

    <% if @tab == "targets" %>
      <%= render "target_levels_tab" %>
    <% end %>
  </div>
</main>
