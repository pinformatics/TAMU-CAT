<% button_help = {
  back_to_batches: "Return to the grade import batch history without changing this batch.",
  commit_preview: "Publish this preview so its imported course competency ratings appear in student, admin, and report views.",
  approve_preview: "Confirm an admin reviewed failed, pending, or target-warning rows and allow this preview to be committed.",
  recommit_batch: "Restore this rolled-back batch so its preserved competency data becomes visible again.",
  export_evidence_csv: "Download one row per imported course competency result with assessed level, target level, and target-met status.",
  correction_file: "Download failed and pending rows in a correction-friendly CSV.",
  reupload_files: "Upload corrected files into this preview. Matching filenames replace previous rows in this batch.",
  rebuild_ratings: "Recalculate derived competency ratings from the current imported evidence rows.",
  finalize_batch: "Lock this committed batch after review so rows, ratings, semester, and rollback/delete actions are protected.",
  rollback_batch: "Hide this committed batch from downstream competency views while preserving its rows.",
  delete_batch: "Permanently remove this batch and its imported rows, including duplicate fingerprints.",
  update_semester: "Apply the selected semester to this batch so semester filters include it correctly.",
  new_batch: "Start a new grade import batch upload."
} %>
<% target_review_required = @batch.dry_run? && @target_warning_summary[:requires_review] %>
<% has_file_issues = @failed_row_count.positive? || @duplicate_upload_warnings.positive? || @duplicate_warnings.positive? || target_review_required %>
<% has_pending_matches = @pending_row_count.positive? %>
<% has_evidence_rows = @evidences.any? %>

<main class="c-main c-main--dashboard">
  <div class="c-page">
    <section class="c-card c-card--brand">
      <header class="c-page-header">
        <div>
          <p class="c-eyebrow">Faculty imports</p>
          <h1 class="c-page-title c-page-title--brand">Grade Import Batch #<%= @batch.id %></h1>
          <p class="c-page-subtitle">
            <%= @batch.dry_run? ? "Preview batch" : "Committed batch" %>
            uploaded by <%= @batch.uploaded_by&.email || "unknown user" %>
            <% if @batch.program_semester.present? %>
              for <%= @batch.program_semester.name %>
            <% end %>
          </p>
        </div>

        <div class="u-actions">
          <%= link_to "Back to batches",
                admin_grade_import_batches_path,
                class: button_classes(:secondary),
                title: button_help[:back_to_batches],
                aria: { label: button_help[:back_to_batches] } %>
        </div>
      </header>
    </section>

    <section class="c-card u-stack u-stack--xl">
      <% if @batch.summary["rolled_back_at"].present? %>
        <div class="c-callout">
          Rolled back at <%= @batch.summary["rolled_back_at"] %>.
        </div>
      <% end %>

      <% if @batch.finalized? %>
        <div class="c-callout c-callout--info">
          <strong>Finalized and locked:</strong>
          <%= @batch.summary["finalized_by"].presence || "Admin" %>
          finalized this batch at <%= @batch.summary["finalized_at"] %>. Imported rows, derived ratings, semester assignment, rollback, and delete actions are locked.
        </div>
      <% end %>

      <div class="c-callout c-callout--info">
        <% if @batch.program_semester.present? %>
          Course-derived ratings from this batch are reportable for <strong><%= @batch.program_semester.name %></strong>.
        <% else %>
          This batch has no semester assigned, so semester-filtered competency views will not include its course-derived ratings.
        <% end %>
        Pending rows need student identifier reconciliation before they contribute to derived ratings. Duplicate rows are suppressed by import fingerprint and remain available in the file diagnostics.
      </div>

      <% if @batch.summary["import_notes"].present? %>
        <div class="c-callout">
          <strong>Import notes:</strong> <%= @batch.summary["import_notes"] %>
        </div>
      <% end %>

      <% if @batch.needs_admin_approval? || target_review_required %>
        <% if @batch.admin_approved? %>
          <div class="c-callout c-callout--info">
            <strong>Admin approved:</strong>
            <%= @batch.summary["admin_approved_by"].presence || "Admin" %>
            approved this preview at <%= @batch.summary["admin_approved_at"] %>. It can now be committed.
          </div>
        <% else %>
          <div class="c-callout c-callout--warning">
            <strong>Admin review required:</strong>
            This preview has failed rows, pending student matches, or course target warnings. Review the diagnostics and correction file before approving it for commit.
          </div>
        <% end %>
      <% end %>

      <% if @duplicate_upload_warnings.positive? %>
        <div class="c-callout c-callout--warning">
          <strong>Possible duplicate upload:</strong>
          <%= pluralize(@duplicate_upload_warnings, "file") %> in this batch matches a file uploaded in an earlier batch. Duplicate rows are suppressed, but review the source and batch notes before committing.
        </div>
      <% end %>

      <section class="u-stack u-stack--md">
        <div>
          <p class="c-eyebrow">Batch actions</p>
          <h2 class="c-section-title c-heading-inline">Next Steps</h2>
        </div>

        <div class="u-grid" style="--u-grid-min: 260px">
          <section class="u-stack u-stack--sm">
            <div>
              <p class="c-table__title">Review Workflow</p>
              <p class="c-help">Use these after diagnostics, corrections, and target warnings have been reviewed.</p>
            </div>
            <div class="u-actions u-actions--start">
              <% workflow_action_rendered = false %>
              <% if @batch.committable_dry_run? && (!target_review_required || @batch.admin_approved?) %>
                <% workflow_action_rendered = true %>
                <%= button_to "Commit preview",
                      commit_admin_grade_import_batch_path(@batch),
                      method: :post,
                      class: button_classes(:primary),
                      title: button_help[:commit_preview],
                      aria: { label: button_help[:commit_preview] },
                      form: { data: { turbo_confirm: "Commit this preview and publish its course competency ratings in the app?" } } %>
              <% end %>
              <% if @batch.dry_run? && (@batch.needs_admin_approval? || target_review_required) && !@batch.admin_approved? %>
                <% workflow_action_rendered = true %>
                <%= button_to "Approve preview",
                      approve_admin_grade_import_batch_path(@batch),
                      method: :post,
                      class: button_classes(:primary),
                      title: button_help[:approve_preview],
                      aria: { label: button_help[:approve_preview] },
                      form: {
                        data: {
                          controller: "modal-confirm",
                          action: "submit->modal-confirm#submit",
                          "modal-confirm-title-value": "Approve preview?",
                          "modal-confirm-message-value": @approval_confirmation_message,
                          "modal-confirm-sections-value": @approval_confirmation_sections.to_json,
                          "modal-confirm-confirm-label-value": "Approve preview",
                          "modal-confirm-cancel-label-value": "Keep reviewing"
                        }
                      } %>
              <% end %>
              <% if @batch.recommittable_rollback? %>
                <% workflow_action_rendered = true %>
                <%= button_to "Recommit batch",
                      recommit_admin_grade_import_batch_path(@batch),
                      method: :post,
                      class: button_classes(:primary),
                      title: button_help[:recommit_batch],
                      aria: { label: button_help[:recommit_batch] },
                      form: { data: { turbo_confirm: "Restore this rolled-back batch so its competency data is visible in the app again?" } } %>
              <% end %>
              <% if @batch.grade_competency_evidences.exists? && !@batch.finalized? %>
                <% workflow_action_rendered = true %>
                <%= button_to "Rebuild ratings",
                      rebuild_ratings_admin_grade_import_batch_path(@batch),
                      method: :post,
                      class: button_classes(:secondary),
                      title: button_help[:rebuild_ratings],
                      aria: { label: button_help[:rebuild_ratings] },
                      form: { data: { turbo_confirm: "Rebuild derived competency ratings from the current imported evidence rows?" } } %>
              <% end %>
              <% if @batch.finalizable? %>
                <% workflow_action_rendered = true %>
                <%= button_to "Finalize batch",
                      finalize_admin_grade_import_batch_path(@batch),
                      method: :post,
                      class: button_classes(:primary),
                      title: button_help[:finalize_batch],
                      aria: { label: button_help[:finalize_batch] },
                      form: { data: { turbo_confirm: "Finalize and lock this committed batch after review? Rows, ratings, semester, rollback, and delete actions will be protected." } } %>
              <% end %>
              <% unless workflow_action_rendered %>
                <span class="c-help">No review action is currently available.</span>
              <% end %>
            </div>
          </section>

          <% if @batch.dry_run? && !@batch.finalized? %>
            <section class="u-stack u-stack--sm">
              <div>
                <p class="c-table__title">Correct Uploads</p>
                <p class="c-help">Re-upload the corrected CSV or workbook before approval or commit.</p>
              </div>
              <%= form_with url: reupload_admin_grade_import_batch_path(@batch),
                    method: :post,
                    local: true,
                    multipart: true,
                    data: { turbo: false },
                    class: "u-stack u-stack--sm" do %>
                <div class="c-field">
                  <label class="c-label" for="batch_reupload_files">Corrected file</label>
                  <%= file_field_tag "files[]",
                        id: "batch_reupload_files",
                        multiple: true,
                        accept: ".xlsx,.xlsm,.csv",
                        class: "c-input" %>
                  <span class="c-help">Use the same filename to replace that file's previous rows in this batch.</span>
                </div>
                <div class="u-actions u-actions--start">
                  <%= submit_tag "Re-upload files",
                        class: button_classes(:secondary),
                        title: button_help[:reupload_files],
                        aria: { label: button_help[:reupload_files] },
                        data: { turbo_confirm: "Re-upload corrected files into this preview? Files with matching names will replace prior rows in this batch." } %>
                </div>
              <% end %>
            </section>
          <% end %>

          <section class="u-stack u-stack--sm">
            <div>
              <p class="c-table__title">Exports</p>
              <p class="c-help">Download the row-level student data or a correction file for rows that need attention.</p>
            </div>
            <div class="u-actions u-actions--start">
              <%= link_to "Export rows CSV",
                    export_evidence_admin_grade_import_batch_path(@batch, format: :csv),
                    class: button_classes(:secondary),
                    title: button_help[:export_evidence_csv],
                    aria: { label: button_help[:export_evidence_csv] },
                    data: { turbo_confirm: ferpa_export_confirmation("row-level student competency data") } %>
              <%= link_to "Correction file",
                    correction_file_admin_grade_import_batch_path(@batch, format: :csv),
                    class: button_classes(:secondary),
                    title: button_help[:correction_file],
                    aria: { label: button_help[:correction_file] },
                    data: { turbo_confirm: ferpa_export_confirmation("student identifiers and course data") } %>
            </div>
          </section>

          <section class="u-stack u-stack--sm">
            <div>
              <p class="c-table__title">Batch Management</p>
              <p class="c-help">Destructive or visibility-changing actions.</p>
            </div>
            <div class="u-actions u-actions--start">
              <% management_action_rendered = false %>
              <% unless @batch.rolled_back? || @batch.dry_run? || @batch.finalized? %>
                <% management_action_rendered = true %>
                <%= button_to "Rollback batch",
                      rollback_admin_grade_import_batch_path(@batch),
                      method: :post,
                      class: button_classes(:danger),
                      title: button_help[:rollback_batch],
                      aria: { label: button_help[:rollback_batch] },
                      form: { data: { turbo_confirm: "Roll back this committed batch? Its imported rows will be hidden from competencies, reports, and downstream views." } } %>
              <% end %>
              <% unless @batch.finalized? %>
                <% management_action_rendered = true %>
                <%= button_to "Delete batch",
                      admin_grade_import_batch_path(@batch),
                      method: :delete,
                      class: button_classes(:danger),
                      title: button_help[:delete_batch],
                      aria: { label: button_help[:delete_batch] },
                      form: { data: { turbo_confirm: "Permanently delete this batch and all imported rows? This also removes duplicate fingerprints, so the same files can be uploaded again." } } %>
              <% end %>
              <% unless management_action_rendered %>
                <span class="c-help">This batch is locked.</span>
              <% end %>
            </div>
          </section>
        </div>
      </section>

      <% if target_review_required %>
        <details class="c-card c-card--flush c-section-group" open>
          <summary class="c-section-group__header">
            <h2 class="c-section-title">Target Warnings Before Commit</h2>
            <span>
              <%= pluralize(@target_warning_summary.dig(:counts, :missing_course_targets).to_i, "missing uploaded target") %>
            </span>
          </summary>

          <div class="u-stack u-stack--md u-p-md">
            <div class="c-callout c-callout--warning">
              Review these rows before committing. Uploaded course targets are separate from end-of-program target levels.
            </div>

            <% warning_groups = [
              ["Missing Uploaded Course Targets", @target_warning_summary[:missing_course_targets]]
            ] %>
            <% warning_groups.each do |title, rows| %>
              <% next if rows.blank? %>
              <section class="u-stack u-stack--sm">
                <h3 class="c-h3 c-heading-inline"><%= title %></h3>
                <div class="c-table-wrapper">
                  <table class="c-table c-table--sm">
                    <thead>
                      <tr>
                        <th>Student</th>
                        <th>Course</th>
                        <th>Competency</th>
                        <th>Uploaded Target</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% rows.each do |row| %>
                        <tr>
                          <td>
                            <span class="c-table__title"><%= row[:student] %></span>
                            <span class="c-table__meta"><%= [row[:track], row[:class_of].present? ? "Class of #{row[:class_of]}" : nil].compact.join(" / ") %></span>
                          </td>
                          <td><%= row[:course_code] %></td>
                          <td class="c-table__title"><%= row[:competency] %></td>
                          <td><%= row[:course_target].presence || "Missing" %></td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </section>
            <% end %>

            <% if @target_warning_summary[:target_coverage].present? %>
              <section class="u-stack u-stack--sm">
                <h3 class="c-h3 c-heading-inline">Target Coverage</h3>
                <div class="c-table-wrapper">
                  <table class="c-table c-table--sm">
                    <thead>
                      <tr>
                        <th>Course</th>
                        <th>Competency</th>
                        <th>Targets Present</th>
                        <th>Missing</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% @target_warning_summary[:target_coverage].first(50).each do |coverage| %>
                        <tr>
                          <td><%= coverage[:course_code] %></td>
                          <td class="c-table__title"><%= coverage[:competency] %></td>
                          <td><%= "#{coverage[:present_count]} / #{coverage[:total_count]}" %></td>
                          <td><%= coverage[:missing_count] %></td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </section>
            <% end %>
          </div>
        </details>
      <% end %>

      <section class="c-card c-card--tight">
        <%= form_with url: semester_admin_grade_import_batch_path(@batch), method: :patch, local: true, data: { turbo: false }, class: "c-filter-bar" do %>
          <div class="c-filter-bar__field">
            <label class="c-label" for="program_semester_id">Batch semester</label>
            <%= select_tag :program_semester_id,
                  options_from_collection_for_select(ProgramSemester.ordered, :id, :name, @batch.program_semester_id),
                  include_blank: "No semester",
                  class: "c-select" %>
          </div>
          <%= submit_tag "Update semester",
                class: button_classes(:secondary),
                title: button_help[:update_semester],
                aria: { label: button_help[:update_semester] } %>
          <span class="c-help">Use this to repair legacy imports so semester-filtered competency views include the batch.</span>
        <% end %>
      </section>

      <section class="c-stats-grid c-stats-grid--batch-summary">
        <div class="c-card c-card--tight c-stat">
          <span class="c-eyebrow">Status</span>
          <strong class="c-value c-value--xl"><%= @batch.status.humanize %></strong>
        </div>
        <div class="c-card c-card--tight c-stat">
          <span class="c-eyebrow">Processed Rows</span>
          <strong class="c-value c-value--xl"><%= @processed_row_count %></strong>
        </div>
        <div class="c-card c-card--tight c-stat">
          <span class="c-eyebrow">Failed Rows</span>
          <strong class="c-value c-value--xl"><%= @failed_row_count %></strong>
        </div>
        <div class="c-card c-card--tight c-stat">
          <span class="c-eyebrow">Pending Matches</span>
          <strong class="c-value c-value--xl"><%= @pending_row_count %></strong>
        </div>
        <div class="c-card c-card--tight c-stat">
          <span class="c-eyebrow">Match Rate</span>
          <strong class="c-value c-value--xl"><%= @match_rate ? "#{@match_rate}%" : "—" %></strong>
        </div>
        <div class="c-card c-card--tight c-stat">
          <span class="c-eyebrow">Derived Ratings</span>
          <strong class="c-value c-value--xl"><%= @batch.rating_count %></strong>
          <p class="c-help"><%= pluralize(@duplicate_warnings, "duplicate suppressed row") %></p>
        </div>
        <div class="c-card c-card--tight c-stat">
          <span class="c-eyebrow">Duplicate Files</span>
          <strong class="c-value c-value--xl"><%= @duplicate_upload_warnings %></strong>
          <p class="c-help">Prior uploads with the same checksum</p>
        </div>
      </section>

      <% if @target_attainment_by_course.any? %>
        <section class="c-card c-card--tight u-stack u-stack--md">
          <div class="u-responsive-split">
            <div>
              <p class="c-eyebrow">Course target attainment</p>
              <h2 class="c-section-title c-heading-inline">Target Performance by Course</h2>
              <p class="c-help">Met rate uses rows that have both an assessed level and a course target.</p>
            </div>
          </div>
          <div class="c-table-wrapper">
            <table class="c-table c-table--sm">
              <thead>
                <tr>
                  <th>Course</th>
                  <th>Processed rows</th>
                  <th>Met</th>
                  <th>Below target</th>
                  <th>No target</th>
                  <th>Met rate</th>
                </tr>
              </thead>
              <tbody>
                <% @target_attainment_by_course.each do |course_summary| %>
                  <tr>
                    <td class="c-table__title"><%= course_summary[:course_code] %></td>
                    <td><%= course_summary[:total_count] %></td>
                    <td><span class="c-score-pill c-score-pill--met"><%= course_summary[:met_count] %></span></td>
                    <td><span class="c-score-pill c-score-pill--below"><%= course_summary[:below_count] %></span></td>
                    <td><span class="c-score-pill c-score-pill--no-target c-score-pill--empty"><%= course_summary[:no_target_count] %></span></td>
                    <td><%= course_summary[:met_rate] ? "#{course_summary[:met_rate]}%" : "—" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>

      <% if @target_attainment_by_course_and_competency.any? %>
        <section class="c-card c-card--tight u-stack u-stack--md">
          <div>
            <p class="c-eyebrow">Course competency review</p>
            <h2 class="c-section-title c-heading-inline">Actual vs Course Target by Competency</h2>
            <p class="c-help">Use this to review what each course contributed and whether assessed levels met the uploaded course targets.</p>
          </div>
          <div class="c-table-wrapper">
            <table class="c-table c-table--sm">
              <thead>
                <tr>
                  <th>Course</th>
                  <th>Competency</th>
                  <th>Rows</th>
                  <th>Actual avg</th>
                  <th>Actual range</th>
                  <th>Course target avg</th>
                  <th>Target range</th>
                  <th>Met</th>
                  <th>Below target</th>
                  <th>No target</th>
                  <th>Met rate</th>
                </tr>
              </thead>
              <tbody>
                <% @target_attainment_by_course_and_competency.each do |summary| %>
                  <tr>
                    <td class="c-table__title"><%= summary[:course_code] %></td>
                    <td><%= summary[:competency_title] %></td>
                    <td><%= summary[:total_count] %></td>
                    <td><%= summary[:assessed_average] ? number_with_precision(summary[:assessed_average], precision: 2, strip_insignificant_zeros: true) : "—" %></td>
                    <td>
                      <% if summary[:assessed_min] && summary[:assessed_max] %>
                        <%= number_with_precision(summary[:assessed_min], precision: 2, strip_insignificant_zeros: true) %>-<%= number_with_precision(summary[:assessed_max], precision: 2, strip_insignificant_zeros: true) %>
                      <% else %>
                        —
                      <% end %>
                    </td>
                    <td><%= summary[:course_target_average] ? number_with_precision(summary[:course_target_average], precision: 2, strip_insignificant_zeros: true) : "—" %></td>
                    <td>
                      <% if summary[:course_target_min] && summary[:course_target_max] %>
                        <%= number_with_precision(summary[:course_target_min], precision: 2, strip_insignificant_zeros: true) %>-<%= number_with_precision(summary[:course_target_max], precision: 2, strip_insignificant_zeros: true) %>
                      <% else %>
                        —
                      <% end %>
                    </td>
                    <td><span class="c-score-pill c-score-pill--met"><%= summary[:met_count] %></span></td>
                    <td><span class="c-score-pill c-score-pill--below"><%= summary[:below_count] %></span></td>
                    <td><span class="c-score-pill c-score-pill--no-target c-score-pill--empty"><%= summary[:no_target_count] %></span></td>
                    <td><%= summary[:met_rate] ? "#{summary[:met_rate]}%" : "—" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>

      <section class="c-card c-card--tight u-stack u-stack--md">
        <div>
          <p class="c-eyebrow">Import review checklist</p>
          <h2 class="c-section-title c-heading-inline">Review in this order</h2>
          <p class="c-help">Use this page from top to bottom. Fix failed values first, match pending students next, then review the evidence rows before approving or committing.</p>
        </div>
        <div class="u-grid" style="--u-grid-min: 220px">
          <div class="c-review-step">
            <p class="c-table__title">1. File summary</p>
            <p class="c-help">Confirm each uploaded file was recognized and see the high-level row counts.</p>
          </div>
          <div class="c-review-step">
            <p class="c-table__title">2. File diagnostics</p>
            <p class="c-help">Check detected columns, course codes, competency mappings, duplicate warnings, and parse errors.</p>
          </div>
          <div class="c-review-step">
            <p class="c-table__title">3. Pending student matches</p>
            <p class="c-help">These rows imported, but do not count until they are matched to a student record.</p>
          </div>
          <div class="c-review-step">
            <p class="c-table__title">4. Student processed</p>
            <p class="c-help">These rows are already matched to students and ready for final review before commit.</p>
          </div>
        </div>
      </section>

      <details class="c-card c-card--flush c-section-group" open>
        <summary class="c-section-group__header">
          <h2 class="c-section-title">1. File Summary</h2>
          <span><%= pluralize(@files.size, "uploaded file") %></span>
        </summary>
        <div class="c-callout c-callout--info u-m-md">
          Start here. This table tells you whether each file was processed, how many rows created evidence, how many rows need student matching, and whether parser errors were found.
        </div>
        <div class="c-table-wrapper">
          <table class="c-table">
            <thead>
              <tr>
                <th>File</th>
                <th>Detected Format</th>
                <th>Status</th>
                <th>Rows</th>
                <th>Pending</th>
                <th>Matched</th>
                <th>Duplicates</th>
                <th>Errors</th>
              </tr>
            </thead>
            <tbody>
              <% @files.each do |file| %>
                <% debug = file.parsed_content["grade_sheet_debug"] || {} %>
                <tr>
                  <td class="c-table__title"><%= file.file_name %></td>
                  <td><%= (file.parsed_content["mode"] || debug["mode"] || "unknown").to_s.humanize %></td>
                  <td><%= file.status %></td>
                  <td><%= "#{file.imported_rows}/#{file.total_rows}" %></td>
                  <td><%= file.pending_rows %></td>
                  <td><%= debug["matched_student_count"] || "—" %></td>
                  <td><%= debug["duplicate_warning_count"] || 0 %></td>
                  <td>
                    <% if file.parse_errors.present? %>
                      <details class="c-cell-details">
                        <summary class="c-cell-details__summary"><%= pluralize(file.parse_errors.size, "issue") %></summary>
                        <ul class="u-mt-sm">
                          <% file.parse_errors.first(20).each do |err| %>
                            <li>
                              <% if err["type"].present? %><strong><%= err["type"].to_s.humanize %>:</strong><% end %>
                              Row <%= err["row"] || "—" %>: <%= normalized_approval_error_message(err) %>
                            </li>
                          <% end %>
                        </ul>
                      </details>
                    <% else %>
                      <span class="c-muted">None</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </details>

      <details class="c-card c-card--flush c-section-group" <%= "open" if has_file_issues %>>
        <summary class="c-section-group__header">
          <h2 class="c-section-title">2. File Diagnostics</h2>
          <span>Format, counts, and issues</span>
        </summary>
        <div class="u-stack u-stack--md u-p-md">
          <div class="c-callout c-callout--info">
            Check how each file was read. Fix failed values, missing competency strings, or duplicate uploads before approval when needed.
          </div>
          <% @files.each do |file| %>
            <% parsed = file.parsed_content || {} %>
            <% debug = parsed["grade_sheet_debug"] || {} %>
            <% mode = (parsed["mode"] || debug["mode"] || "unknown").to_s %>
            <% format_label = case mode
              when "direct_competency" then "Direct competency file"
              when "canvas" then "Canvas gradebook with mapping rules"
              when "narrow" then "Narrow grade rows with mapping rules"
              else mode.humanize
            end %>
            <% mappings = Array(parsed["mapping_rows_preview"]) %>
            <% direct_competencies = Array(parsed["direct_competencies_preview"] || debug["direct_competencies_preview"]) %>
            <% mapping_course_codes = mappings.filter_map { |mapping| mapping["course_code"] || mapping[:course_code] }.compact_blank.uniq.sort %>
            <% course_label = parsed["direct_course_code"].presence || file.course_offering&.course_code || (mapping_course_codes.one? ? mapping_course_codes.first : nil) || (mapping_course_codes.any? ? mapping_course_codes.to_sentence : "Detected from file, section, or mapping rows") %>
            <% identifier_column = debug["student_identifier_column"] %>
            <% student_identifier_label = if mode == "direct_competency"
              "Student SIS ID, Student ID, then student name"
            elsif identifier_column.present? && identifier_column.to_s.match?(/\A\d+\z/)
              "Column #{identifier_column.to_i + 1}"
            elsif identifier_column.present?
              identifier_column
            else
              "Detected from Student ID / SIS fields"
            end %>
            <% pending_student_count = debug["pending_student_count"].presence || @pending_student_counts_by_file[file.id] || file.pending_rows.to_i %>
            <% pending_competency_count = @pending_competency_counts_by_file.fetch(file.id, file.pending_rows.to_i) %>
            <% review_items = [] %>
            <% Array(file.parse_errors).each do |error| %>
              <% review_items << {
                type: error["type"].presence&.to_s&.humanize || "Error",
                row: error["row"].presence || "-",
                message: normalized_approval_error_message(error)
              } %>
            <% end %>
            <% Array(debug["mapping_warnings_preview"]).each do |warning| %>
              <% review_items << {
                type: "Mapping warning",
                row: warning["row"].presence || "-",
                message: warning["message"] || warning
              } %>
            <% end %>
            <% Array(debug["duplicate_warnings_preview"]).each do |warning| %>
              <% review_items << {
                type: "Duplicate suppressed",
                row: warning["row"].presence || "-",
                message: warning["message"] || warning
              } %>
            <% end %>
            <details class="c-accordion">
              <summary class="c-accordion__summary">
                <span class="c-accordion__title"><%= file.file_name %></span>
                <span class="c-accordion__meta">
                  <%= format_label %>
                  · <%= course_label %>
                  · <%= review_items.any? ? pluralize(review_items.size, "review item") : "No review items" %>
                </span>
              </summary>

              <% if parsed["duplicate_file_uploads"].present? %>
                <div class="c-callout c-callout--warning u-mt-sm">
                  This file appears to match a file previously uploaded in
                  <%= parsed["duplicate_file_uploads"].map { |upload| "batch ##{upload['batch_id'] || upload[:batch_id]}" }.join(", ") %>.
                </div>
              <% end %>

              <div class="u-grid u-mt-sm" style="--u-grid-min: 180px">
                <div class="c-review-step">
                  <p class="c-eyebrow">Detected format</p>
                  <p class="c-table__title"><%= format_label %></p>
                </div>
                <div class="c-review-step">
                  <p class="c-eyebrow">Course detected</p>
                  <p class="c-table__title"><%= course_label %></p>
                </div>
                <div class="c-review-step">
                  <p class="c-eyebrow">Student matching uses</p>
                  <p class="c-table__title"><%= student_identifier_label %></p>
                </div>
                <div class="c-review-step">
                  <p class="c-eyebrow">Student rows scanned</p>
                  <p class="c-table__title"><%= debug["rows_scanned"].presence || file.total_rows %></p>
                </div>
                <div class="c-review-step">
                  <p class="c-eyebrow">Students matched</p>
                  <p class="c-table__title"><%= debug["matched_student_count"].presence || "—" %></p>
                </div>
                <div class="c-review-step">
                  <p class="c-eyebrow">Students needing match</p>
                  <p class="c-table__title"><%= pending_student_count %></p>
                </div>
                <div class="c-review-step">
                  <p class="c-eyebrow">Matched competency values</p>
                  <p class="c-table__title"><%= file.imported_rows %></p>
                </div>
                <div class="c-review-step">
                  <p class="c-eyebrow">Competency values needing match</p>
                  <p class="c-table__title"><%= pending_competency_count %></p>
                </div>
                <div class="c-review-step">
                  <p class="c-eyebrow">Failed rows</p>
                  <p class="c-table__title"><%= file.error_rows %></p>
                </div>
                <div class="c-review-step">
                  <p class="c-eyebrow">Duplicate values suppressed</p>
                  <p class="c-table__title"><%= debug["duplicate_warning_count"].presence || 0 %></p>
                </div>
              </div>

              <% if mappings.any? %>
                <div class="u-mt-md">
                  <h3 class="c-h3 c-heading-inline">Competency Source</h3>
                  <p class="c-help">Assignment mapping rules were used to convert Canvas scores into competency levels.</p>
                  <div class="c-table-wrapper">
                    <table class="c-table c-table--sm">
                      <thead>
                        <tr>
                          <th>Assignment</th>
                          <th>Course</th>
                          <th>Competency</th>
                          <th>Result level</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% mappings.first(30).each do |mapping| %>
                          <tr>
                            <td><%= [mapping["assignment_match_type"] || mapping[:assignment_match_type], mapping["assignment_match_value"] || mapping[:assignment_match_value]].compact.join(": ") %></td>
                            <td><%= (mapping["course_code"] || mapping[:course_code]).presence || "Any course" %></td>
                            <td class="c-table__title"><%= mapping["competency_title"] || mapping[:competency_title] %></td>
                            <td><%= mapping["competency_level"] || mapping[:competency_level] %></td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                </div>
              <% elsif direct_competencies.any? %>
                <div class="u-mt-md">
                  <h3 class="c-h3 c-heading-inline">Competency Source</h3>
                  <p class="c-help">Competency columns were read directly from the uploaded file.</p>
                  <div class="c-table-wrapper">
                    <table class="c-table c-table--sm">
                      <thead>
                        <tr>
                          <th>Competency</th>
                          <th>Assessed level column</th>
                          <th>Course target column</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% direct_competencies.first(30).each do |column| %>
                          <tr>
                            <td class="c-table__title"><%= column["competency_title"] || column[:competency_title] %></td>
                            <td><%= (column["mastery_points_header"] || column[:mastery_points_header]).presence || "No score column" %></td>
                            <td><%= column["result_header"] || column[:result_header] %></td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                </div>
              <% else %>
                <div class="c-callout c-callout--warning u-mt-md">
                  No competency columns or mapping rules were detected for this file. Review the upload format before committing the batch.
                </div>
              <% end %>

              <% if review_items.any? %>
                <div class="u-mt-md">
                  <h3 class="c-h3 c-heading-inline">Review Items</h3>
                  <ul class="c-modal__review-list">
                    <% review_items.each do |item| %>
                      <li>
                        <strong><%= item[:type] %></strong>
                        <% if item[:row].present? && item[:row] != "-" %>
                          · Row <%= item[:row] %>
                        <% end %>
                        <br>
                        <%= item[:message] %>
                      </li>
                    <% end %>
                  </ul>
                </div>
              <% else %>
                <p class="c-help u-mt-md">No file-level mapping, type, duplicate, or parsing issues were detected.</p>
              <% end %>
            </details>
          <% end %>
        </div>
      </details>

      <details class="c-card c-card--flush c-section-group" <%= "open" if has_pending_matches %>>
        <summary class="c-section-group__header">
          <h2 class="c-section-title">3. Pending Student Matching</h2>
          <span><%= pluralize(@pending_rows.size, "competency row") %> needing a student</span>
        </summary>
        <% if @pending_rows.empty? %>
          <div class="c-empty-state">
            <p class="c-empty-state__body">No pending student matches were created for this batch.</p>
          </div>
        <% else %>
          <div class="c-callout c-callout--warning u-m-md">
            These competency values were read from the file, but the importer could not confidently match them to a student. Review the imported data, then use the Edit tab to correct the UIN, email, or name, or choose the matching student.
          </div>
          <% pending_student_groups = @pending_rows.group_by do |row|
            identity = row.student_uin.presence ||
                       row.student_email.presence ||
                       row.student_identifier.presence ||
                       row.student_name.presence ||
                       "pending-row-#{row.id}"
            [row.student_identifier_type.presence || "student", identity.to_s.downcase.strip]
          end %>
          <div class="u-stack u-stack--sm u-p-md">
            <% pending_student_groups.values.each_with_index do |rows, group_index| %>
              <% primary_row = rows.first %>
              <% imported_student_label = primary_row.student_name.presence || primary_row.student_identifier.presence || "Unknown Student" %>
              <% imported_student_meta = [primary_row.student_uin.presence && "UIN #{primary_row.student_uin}", primary_row.student_email].compact_blank.join(" / ") %>
              <% course_codes = rows.map(&:course_code).compact_blank.uniq.sort %>
              <% edit_tab_id = "pending-#{group_index}-edit" %>
              <% values_tab_id = "pending-#{group_index}-values" %>
              <details class="c-accordion">
                <summary class="c-accordion__summary">
                  <span class="c-accordion__title"><%= imported_student_label %></span>
                  <span class="c-accordion__meta">
                    <%= pluralize(rows.size, "pending row") %>
                    <% if course_codes.any? %>· <%= course_codes.to_sentence %><% end %>
                  </span>
                </summary>

                <div class="u-stack u-stack--md u-p-md" data-controller="survey-tabs" data-survey-tabs-default-tab-value="<%= values_tab_id %>">
                  <div class="u-responsive-split">
                    <div class="u-stack u-stack--xs">
                      <div class="c-table__title"><%= imported_student_label %></div>
                      <div class="c-table__meta"><%= imported_student_meta.presence || "No UIN or email provided" %></div>
                    </div>
                    <div class="c-tabs" role="tablist" aria-label="Pending student match tools">
                      <button type="button"
                              class="c-tab"
                              role="tab"
                              data-survey-tabs-target="tab"
                              data-tab-id="<%= edit_tab_id %>"
                              data-action="click->survey-tabs#switchTab keydown->survey-tabs#handleKeydown">
                        Edit
                      </button>
                      <button type="button"
                              class="c-tab is-active"
                              role="tab"
                              data-survey-tabs-target="tab"
                              data-tab-id="<%= values_tab_id %>"
                              data-action="click->survey-tabs#switchTab keydown->survey-tabs#handleKeydown">
                        Processed values
                      </button>
                    </div>
                  </div>

                  <div class="hidden" data-survey-tabs-target="panel" data-tab-panel="<%= edit_tab_id %>" role="tabpanel">
                    <% if @batch.finalized? %>
                      <div class="c-callout c-callout--info">This batch is finalized and locked.</div>
                    <% else %>
                      <%= form_with url: pending_row_group_admin_grade_import_batch_path(@batch),
                          method: :patch,
                          local: true,
                          data: { turbo: false },
                          class: "u-stack u-stack--md" do %>
                        <% rows.each do |row| %>
                          <%= hidden_field_tag "pending_row_ids[]", row.id %>
                        <% end %>

                        <div class="c-callout c-callout--info">
                          Choosing a matched student applies to every pending competency row in this group. Row-level assessed levels and course targets remain editable below.
                        </div>

                        <div class="u-grid" style="--u-grid-min: 220px">
                          <div class="c-field">
                            <%= label_tag "grade_import_pending_row_group_#{group_index}_matched_student_id", "Match all rows to student", class: "c-label" %>
                            <%= select_tag "grade_import_pending_row_group[matched_student_id]",
                                  options_for_select(
                                    [["Keep pending", ""]] + @student_match_options.map { |student| ["#{student.user&.display_name || student.student_id} (UIN #{student.uin.presence || 'missing'})", student.student_id] },
                                    primary_row.matched_student_id
                                  ),
                                  id: "grade_import_pending_row_group_#{group_index}_matched_student_id",
                                  class: "c-select u-w-full" %>
                          </div>
                          <div class="c-field">
                            <%= label_tag "grade_import_pending_row_group_#{group_index}_student_uin", "Student UIN", class: "c-label" %>
                            <%= text_field_tag "grade_import_pending_row_group[student_uin]", primary_row.student_uin, id: "grade_import_pending_row_group_#{group_index}_student_uin", class: "c-input" %>
                          </div>
                          <div class="c-field">
                            <%= label_tag "grade_import_pending_row_group_#{group_index}_student_email", "Student email", class: "c-label" %>
                            <%= email_field_tag "grade_import_pending_row_group[student_email]", primary_row.student_email, id: "grade_import_pending_row_group_#{group_index}_student_email", class: "c-input" %>
                          </div>
                          <div class="c-field">
                            <%= label_tag "grade_import_pending_row_group_#{group_index}_student_name", "Student name", class: "c-label" %>
                            <%= text_field_tag "grade_import_pending_row_group[student_name]", primary_row.student_name, id: "grade_import_pending_row_group_#{group_index}_student_name", class: "c-input" %>
                          </div>
                        </div>

                        <div class="c-table-wrapper">
                          <table class="c-table c-table--sm">
                            <thead>
                              <tr>
                                <th>Course</th>
                                <th>Assignment</th>
                                <th>Competency</th>
                                <th>Raw</th>
                                  <th>Assessed level</th>
                                  <th>Course target</th>
                              </tr>
                            </thead>
                            <tbody>
                              <% rows.each do |row| %>
                                <tr>
                                  <td><%= text_field_tag "pending_rows[#{row.id}][course_code]", row.course_code, class: "c-input" %></td>
                                  <td><%= text_field_tag "pending_rows[#{row.id}][assignment_name]", row.assignment_name, class: "c-input" %></td>
                                  <td>
                                    <%= select_tag "pending_rows[#{row.id}][competency_title]",
                                          options_for_select(Reports::DataAggregator::COMPETENCY_TITLES, row.competency_title),
                                          class: "c-select u-w-full" %>
                                  </td>
                                  <td><%= text_field_tag "pending_rows[#{row.id}][raw_grade]", row.raw_grade, class: "c-input" %></td>
                                  <td><%= number_field_tag "pending_rows[#{row.id}][mapped_level]", row.mapped_level, class: "c-input", min: 1, max: 5 %></td>
                                  <td><%= number_field_tag "pending_rows[#{row.id}][course_target_level]", row.course_target_level, class: "c-input", min: 1, max: 5 %></td>
                                </tr>
                              <% end %>
                            </tbody>
                          </table>
                        </div>

                        <div class="u-actions u-actions--start">
                          <%= submit_tag "Save grouped correction", class: button_classes(:secondary) %>
                        </div>
                      <% end %>
                    <% end %>
                  </div>

                  <div data-survey-tabs-target="panel" data-tab-panel="<%= values_tab_id %>" role="tabpanel">
                    <div class="c-table-wrapper">
                      <table class="c-table c-table--sm">
                        <thead>
                          <tr>
                            <th>File</th>
                            <th>Status</th>
                            <th>Identifier Type</th>
                            <th>UIN</th>
                            <th>Email</th>
                            <th>Course</th>
                            <th>Competency</th>
                            <th>Raw</th>
                            <th>Assessed level</th>
                            <th>Course target</th>
                            <th>Target status</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% rows.each do |row| %>
                            <tr>
                              <td><%= row.grade_import_file&.file_name %></td>
                              <td><%= row.status.to_s.humanize %></td>
                              <td><%= row.student_identifier_type.presence || "—" %></td>
                              <td><%= row.student_uin.presence || "—" %></td>
                              <td><%= row.student_email.presence || "—" %></td>
                              <td><%= row.course_code.presence || "—" %></td>
                              <td class="c-table__title"><%= row.competency_title %></td>
                              <td><%= row.raw_grade %></td>
                              <td><span class="c-score-pill c-score-pill--course"><%= row.mapped_level %></span></td>
                              <td><span class="c-score-pill c-score-pill--program <%= 'c-score-pill--empty' if row.course_target_level.blank? %>"><%= row.course_target_level.presence || "—" %></span></td>
                              <td>
                                <% target_status = target_met_label(row.mapped_level, row.course_target_level) %>
                                <span class="c-score-pill <%= target_status == 'Met' ? 'c-score-pill--met' : target_status == 'Below target' ? 'c-score-pill--below' : 'c-score-pill--no-target c-score-pill--empty' %>"><%= target_status %></span>
                              </td>
                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </details>
            <% end %>
          </div>
        <% end %>
      </details>

      <details class="c-card c-card--flush c-section-group" <%= "open" if has_evidence_rows && !has_pending_matches && !has_file_issues %>>
        <summary class="c-section-group__header">
          <h2 class="c-section-title">4. Student Processed</h2>
          <span><%= pluralize(@evidences.size, "matched competency row") %> ready for review</span>
        </summary>
        <div class="c-callout c-callout--info u-m-md">
          These rows are already matched to students. Review the processed values, then use the Edit tab if course, competency, assessed level, or course target values need correction.
        </div>
        <% grouped_evidences = @evidences.group_by { |evidence| [evidence.student&.user&.name || "Unknown Student", evidence.student&.uin.presence || "No UIN"] } %>
        <% if grouped_evidences.empty? %>
          <div class="c-empty-state">
            <p class="c-empty-state__body">No student processed rows were created for this batch.</p>
          </div>
        <% else %>
          <div class="u-stack u-stack--sm u-p-md">
            <% grouped_evidences.each_with_index do |((student_name, student_uin), evidences), group_index| %>
              <% course_codes = evidences.map(&:course_code).compact_blank.uniq.sort %>
              <% edit_tab_id = "processed-#{group_index}-edit" %>
              <% values_tab_id = "processed-#{group_index}-values" %>
              <details class="c-accordion">
                <summary class="c-accordion__summary">
                  <span class="c-accordion__title"><%= student_name %></span>
                  <span class="c-accordion__meta">
                    UIN <%= student_uin %> · <%= pluralize(evidences.size, "processed row") %>
                    <% if course_codes.any? %>· <%= course_codes.to_sentence %><% end %>
                  </span>
                </summary>

                <div class="u-stack u-stack--md u-p-md" data-controller="survey-tabs" data-survey-tabs-default-tab-value="<%= values_tab_id %>">
                  <div class="u-responsive-split">
                    <div class="u-stack u-stack--xs">
                      <div class="c-table__title"><%= student_name %></div>
                      <div class="c-table__meta">UIN <%= student_uin %></div>
                    </div>
                    <div class="c-tabs" role="tablist" aria-label="Processed student row tools">
                      <button type="button"
                              class="c-tab"
                              role="tab"
                              data-survey-tabs-target="tab"
                              data-tab-id="<%= edit_tab_id %>"
                              data-action="click->survey-tabs#switchTab keydown->survey-tabs#handleKeydown">
                        Edit
                      </button>
                      <button type="button"
                              class="c-tab is-active"
                              role="tab"
                              data-survey-tabs-target="tab"
                              data-tab-id="<%= values_tab_id %>"
                              data-action="click->survey-tabs#switchTab keydown->survey-tabs#handleKeydown">
                        Processed values
                      </button>
                    </div>
                  </div>

                  <div class="hidden" data-survey-tabs-target="panel" data-tab-panel="<%= edit_tab_id %>" role="tabpanel">
                    <% if @batch.finalized? %>
                      <div class="c-callout c-callout--info">This batch is finalized and locked.</div>
                    <% else %>
                      <div class="u-stack u-stack--sm">
                        <% evidences.each do |evidence| %>
                          <%= form_with url: evidence_admin_grade_import_batch_path(@batch, evidence),
                                method: :patch,
                                local: true,
                                data: { turbo: false },
                                class: "c-review-step u-stack u-stack--sm" do %>
                            <div class="u-responsive-split">
                              <div>
                                <div class="c-table__title"><%= evidence.competency_title %></div>
                                <div class="c-table__meta">
                                  Row <%= evidence.row_number.presence || "—" %> · <%= evidence.grade_import_file&.file_name || "Unknown file" %>
                                </div>
                              </div>
                              <%= submit_tag "Save row", class: button_classes(:secondary, extra_classes: "btn-sm") %>
                            </div>
                            <div class="u-grid" style="--u-grid-min: 180px">
                              <div class="c-field">
                                <%= label_tag "grade_competency_evidence_#{evidence.id}_course_code", "Course", class: "c-label" %>
                                <%= text_field_tag "grade_competency_evidence[course_code]", evidence.course_code, id: "grade_competency_evidence_#{evidence.id}_course_code", class: "c-input" %>
                              </div>
                              <div class="c-field">
                                <%= label_tag "grade_competency_evidence_#{evidence.id}_assignment_name", "Assignment", class: "c-label" %>
                                <%= text_field_tag "grade_competency_evidence[assignment_name]", evidence.assignment_name, id: "grade_competency_evidence_#{evidence.id}_assignment_name", class: "c-input" %>
                              </div>
                              <div class="c-field">
                                <%= label_tag "grade_competency_evidence_#{evidence.id}_competency_title", "Competency", class: "c-label" %>
                                <%= select_tag "grade_competency_evidence[competency_title]",
                                      options_for_select(Reports::DataAggregator::COMPETENCY_TITLES, evidence.competency_title),
                                      id: "grade_competency_evidence_#{evidence.id}_competency_title",
                                      class: "c-select u-w-full" %>
                              </div>
                              <div class="c-field">
                                <%= label_tag "grade_competency_evidence_#{evidence.id}_mapped_level", "Assessed level", class: "c-label" %>
                                <%= number_field_tag "grade_competency_evidence[mapped_level]", evidence.mapped_level, id: "grade_competency_evidence_#{evidence.id}_mapped_level", class: "c-input", min: 1, max: 5 %>
                              </div>
                              <div class="c-field">
                                <%= label_tag "grade_competency_evidence_#{evidence.id}_course_target_level", "Course target", class: "c-label" %>
                                <%= number_field_tag "grade_competency_evidence[course_target_level]", evidence.course_target_level, id: "grade_competency_evidence_#{evidence.id}_course_target_level", class: "c-input", min: 1, max: 5 %>
                              </div>
                            </div>
                            <%= hidden_field_tag "grade_competency_evidence[raw_grade]", evidence.raw_grade %>
                          <% end %>
                        <% end %>
                      </div>
                    <% end %>
                  </div>

                  <div data-survey-tabs-target="panel" data-tab-panel="<%= values_tab_id %>" role="tabpanel">
                    <div class="c-table-wrapper">
                      <table class="c-table c-table--sm">
                        <thead>
                          <tr>
                            <th>File</th>
                            <th>Status</th>
                            <th>Identifier Type</th>
                            <th>UIN</th>
                            <th>Email</th>
                            <th>Course</th>
                            <th>Competency</th>
                            <th>Raw</th>
                            <th>Assessed level</th>
                            <th>Course target</th>
                            <th>Target status</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% evidences.each do |evidence| %>
                            <tr>
                              <td><%= evidence.grade_import_file&.file_name %></td>
                              <td>Processed</td>
                              <td>Matched student</td>
                              <td><%= evidence.student&.uin.presence || student_uin.presence || "—" %></td>
                              <td><%= evidence.student&.user&.email.presence || "—" %></td>
                              <td><%= evidence.course_code.presence || "—" %></td>
                              <td class="c-table__title"><%= evidence.competency_title %></td>
                              <td><%= evidence.raw_grade %></td>
                              <td><span class="c-score-pill c-score-pill--course"><%= evidence.mapped_level %></span></td>
                              <td><span class="c-score-pill c-score-pill--program <%= 'c-score-pill--empty' if evidence.course_target_level.blank? %>"><%= evidence.course_target_level.presence || "—" %></span></td>
                              <td>
                                <% target_status = target_met_label(evidence.mapped_level, evidence.course_target_level) %>
                                <span class="c-score-pill <%= target_status == 'Met' ? 'c-score-pill--met' : target_status == 'Below target' ? 'c-score-pill--below' : 'c-score-pill--no-target c-score-pill--empty' %>"><%= target_status %></span>
                              </td>
                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </details>
            <% end %>
          </div>
        <% end %>
      </details>

      <div class="u-actions u-actions--start">
        <%= link_to "Back to batches",
              admin_grade_import_batches_path,
              class: button_classes(:secondary),
              title: button_help[:back_to_batches],
              aria: { label: button_help[:back_to_batches] } %>
        <%= link_to "New batch",
              new_admin_grade_import_batch_path,
              class: button_classes(:primary),
              title: button_help[:new_batch],
              aria: { label: button_help[:new_batch] } %>
      </div>
    </section>
  </div>
</main>
