<main class="c-main c-main--dashboard">
  <div class="c-page">
    <section class="c-card c-card--brand">
      <header class="c-page-header">
        <div>
          <p class="c-eyebrow">Survey admin</p>
          <h1 class="c-page-title c-page-title--brand">Survey Change Log</h1>
          <p class="c-page-subtitle">Review recent admin activity across surveys. Filter by action type to focus on specific updates.</p>
        </div>
        <%= link_to "Back to Surveys", admin_surveys_path, class: button_classes(:secondary) %>
      </header>
    </section>

    <section class="c-card u-stack u-stack--xl">
      <section class="u-stack u-stack--md">
        <div>
          <h2 class="c-section-title c-heading-inline">Recent activity</h2>
          <p class="c-lede">Use the action filter to focus on one type of survey update at a time.</p>
        </div>

        <div class="c-card c-card--flush">
          <div class="c-panel-header c-panel-header--with-border">
            <div class="c-callout">
              <%= form_with url: admin_survey_change_logs_path, method: :get, local: true, class: "c-toolbar__row c-toolbar__row--airy u-w-full u-flex-nowrap" do %>
                <div class="c-toolbar__item u-flex u-items-center u-gap-sm">
                  <label for="action_type" class="c-label">Filter by action</label>
                  <%= select_tag :action_type,
                                 options_for_select([["All actions", ""]] + @available_actions.map { |action| [action.titleize, action] }, @action_filter),
                                 class: "c-select u-w-full" %>
                </div>
                <div class="c-toolbar__item u-flex u-items-center u-gap-sm">
                  <%= submit_tag "Apply", class: button_classes(:primary) %>
                  <% if @action_filter.present? %>
                    <%= link_to "Reset", admin_survey_change_logs_path, class: button_classes(:subtle) %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <% if @logs.blank? %>
            <div class="c-empty-state">
              <p class="c-empty-state__body">No survey activity has been recorded yet.</p>
            </div>
          <% else %>
            <div class="c-table-wrapper">
              <table class="c-table">
                <thead>
                  <tr>
                    <th scope="col">Timestamp</th>
                    <th scope="col">Action</th>
                    <th scope="col">Admin</th>
                    <th scope="col">Survey</th>
                    <th scope="col">Description</th>
                  </tr>
                </thead>
                <tbody>
                  <% @logs.each do |log| %>
                    <tr>
                      <td class="u-whitespace-nowrap"><%= l(log.created_at, format: :long) %></td>
                      <td class="u-whitespace-nowrap c-table__title"><%= log.action.titleize %></td>
                      <td class="u-whitespace-nowrap"><%= log.admin&.display_name || "Unknown" %></td>
                      <td class="u-whitespace-nowrap">
                        <% display_title = log.survey_title_snapshot.presence || log.survey&.title.presence || "Survey ##{log.survey_id}" %>
                        <% if log.survey.present? %>
                          <%= link_to display_title, edit_admin_survey_path(log.survey), class: "u-link" %>
                        <% else %>
                          <span class="c-muted"><%= display_title %></span>
                        <% end %>
                      </td>
                      <td>
                        <%= log.description.presence || "No additional details recorded." %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
        </div>
      </section>
    </section>
  </div>
</main>
