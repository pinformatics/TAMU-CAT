<%= form_with(model: [:admin, question], class: "survey-form", data: { controller: "markdown-editor" }) do |form| %>
  <% if question.errors.any? %>
    <div class="form-errors">
      <h2 class="c-panel-title"><%= pluralize(question.errors.count, "error") %> prevented the question from being saved:</h2>
      <ul>
        <% question.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="c-form-layout">
    <div class="u-stack u-stack--2xl">
      <section class="c-card c-form-card">
        <header class="c-form-card__header">
          <span class="c-step-pill">Question Details</span>
          <div>
            <h2 class="c-section-title">Prompt content</h2>
            <p class="c-help">Define the prompt, type, and ordering so it appears correctly in surveys.</p>
          </div>
        </header>

        <div class="u-grid">
          <div class="c-field">
            <%= form.label :question, "Question text", class: "c-label" %>
            <%= form.text_area :question,
                               rows: 4,
                               class: "c-input input",
                               required: true,
                               placeholder: "Describe the question you want to ask" %>
          </div>

          <div class="c-field">
            <%= form.label :description, "Question description (optional)", class: "c-label" %>
            <%= form.text_area :description,
                               rows: 3,
                               class: "c-input input",
                               placeholder: "Provide context or competency definition students should always see." %>
            <p class="c-help field-hint">Displayed directly beneath the question prompt to give everyone constant context.</p>
          </div>

          <div class="c-field">
            <%= form.label :tooltip_text, "Tooltip text (optional)", class: "c-label" %>
            <%= form.text_area :tooltip_text,
                               rows: 3,
                               class: "c-input input",
                               placeholder: "Short guidance that appears in the tooltip icon." %>
            <p class="c-help field-hint">Use for hover/click tooltips. Ideal for scales or advisor-only nudges you do not want inline.</p>
          </div>

          <div class="c-field">
            <%= form.label :question_type, "Question type", class: "c-label" %>
            <%= form.select :question_type, Question.question_types.keys.map { |type| [type.humanize, type] }, {}, class: "c-select u-w-full", required: true %>
          </div>

          <div class="c-field">
            <%= form.label :prompt_format, "Prompt format", class: "c-label" %>
            <%= form.select :prompt_format,
                            [["Plain text", "plain_text"], ["Rich text", "rich_text"]],
                            {},
                            class: "c-select u-w-full" %>
            <p class="c-help field-hint">Rich text uses Markdown syntax (for example: **bold**, *italic*, [link](https://example.com)).</p>
          </div>

          <div class="c-field">
            <%= form.label :question_order, "Display order", class: "c-label" %>
            <%= form.number_field :question_order, class: "c-input input", min: 1, required: true %>
            <p class="c-help field-hint">Controls where this question appears relative to other prompts.</p>
          </div>

          <div class="c-field">
            <%= form.label :integer_min, "Integer minimum", class: "c-label" %>
            <%= form.number_field :integer_min, class: "c-input input", min: 0, step: 1, placeholder: 1 %>
          </div>

          <div class="c-field">
            <%= form.label :integer_max, "Integer maximum", class: "c-label" %>
            <%= form.number_field :integer_max, class: "c-input input", min: 0, step: 1, placeholder: "Optional" %>
          </div>
        </div>
      </section>

      <section class="c-card c-form-card">
        <header class="c-form-card__header">
          <span class="c-step-pill">Configuration</span>
          <div>
            <h2 class="c-section-title">Answer options & tags</h2>
            <p class="c-help">Add category tags and optional predefined answers for multiple choice prompts.</p>
          </div>
        </header>

        <div class="u-grid u-grid--2">
          <div class="c-field">
            <label class="c-label" for="question_category_ids">Categories</label>
            <p class="c-help field-hint">Tagged categories help advisors filter and find related prompts.</p>
            <%= form.collection_select :category_ids, @categories, :id, :name, { include_hidden: false }, { multiple: true, size: 8, class: "c-select u-w-full multi-select" } %>
          </div>

          <div class="c-field">
            <%= form.label :answer_options, "Answer options", class: "c-label" %>
            <%= form.text_area :answer_options, rows: 6, class: "c-input input", placeholder: "Provide comma separated options or JSON array (used for multiple choice)." %>
            <p class="c-help field-hint">Leave blank for free-form answers. Example: [\"Strongly Agree\", \"Agree\", \"Neutral\", \"Disagree\", \"Strongly Disagree\"].</p>
          </div>
        </div>
      </section>

      <div class="c-form-actions u-actions">
        <%= form.submit(question.persisted? ? "Update Question" : "Create Question", class: button_classes(:primary)) %>
        <%= link_to "Cancel", admin_questions_path, class: button_classes(:secondary) %>
      </div>
    </div>
  </div>
<% end %>
