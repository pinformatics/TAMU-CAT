<main class="c-main c-main--dashboard">
  <div class="c-page">
    <section class="c-card c-card--brand">
      <header class="c-page-header">
        <div>
          <p class="c-eyebrow">Survey admin</p>
          <h1 class="c-page-title c-page-title--brand">Question Bank</h1>
          <p class="c-page-subtitle">Manage reusable prompts, question types, and their survey assignments from one place.</p>
        </div>

        <div class="u-actions">
          <%= link_to "Back to Surveys", admin_surveys_path, class: button_classes(:secondary) %>
          <%= link_to "New Question", new_admin_question_path, class: button_classes(:primary) %>
        </div>
      </header>
    </section>

    <section class="c-card c-card--flush u-overflow-hidden">
      <div class="c-panel-header c-panel-header--with-border">
        <div class="u-responsive-split u-w-full">
          <div class="u-stack u-stack--sm">
            <h2 class="c-panel-title">Questions</h2>
            <p class="c-panel-subtitle">Review prompts by order, type, category, and survey assignment.</p>
          </div>
          <span class="c-status-badge c-status-badge--muted"><%= pluralize(@questions.size, "question") %></span>
        </div>
      </div>

      <% if @questions.blank? %>
        <div class="c-empty-state">
          <p class="c-empty-state__body">No questions have been created yet.</p>
        </div>
      <% else %>
        <div class="c-table-wrapper">
          <table class="c-table c-table--zebra">
            <thead>
              <tr>
                <th>Order</th>
                <th>Question</th>
                <th>Type</th>
                <th>Categories</th>
                <th>Surveys</th>
                <th class="u-text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @questions.each do |question| %>
                <% category = question.category %>
                <% survey = category&.survey %>
                <tr>
                  <td class="c-table__meta"><%= question.question_order %></td>
                  <td><div class="c-table__title"><%= question.question %></div></td>
                  <td class="c-table__meta"><%= question.question_type.humanize %></td>
                  <td>
                    <% if category.present? %>
                      <span class="c-pill c-pill--muted"><%= category.name %></span>
                    <% else %>
                      <span class="c-pill c-pill--muted">Unassigned</span>
                    <% end %>
                  </td>
                  <td>
                    <% if survey.present? %>
                      <span class="c-pill c-pill--muted"><%= survey.title %></span>
                    <% else %>
                      <span class="c-pill c-pill--muted">Unassigned</span>
                    <% end %>
                  </td>
                  <td>
                    <div class="u-actions u-actions--nowrap">
                      <%= link_to "Edit", edit_admin_question_path(question), class: button_classes(:secondary) %>
                      <%= link_to "Delete", admin_question_path(question),
                        data: { turbo_method: :delete, turbo_confirm: "Delete this question? It will be removed from any surveys it's assigned to." },
                        class: button_classes(:danger) %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>
  </div>
</main>
