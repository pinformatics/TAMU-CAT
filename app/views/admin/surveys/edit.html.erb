<% tracks = @survey.track_list %>
<% status_label, status_classes = admin_survey_status_meta(@survey) %>

<main class="c-main c-main--dashboard" data-survey-scroll-scope>
  <div class="c-page">
  <section class="c-card c-card--brand">
    <header class="c-page-header">
      <div>
        <div class="u-actions u-actions--start u-gap-sm">
          <span class="<%= status_classes %>"><%= status_label %></span>
          <span class="c-muted-meta">Last updated <%= time_ago_in_words(@survey.updated_at) %> ago</span>
        </div>
        <h1 class="c-page-title c-page-title--brand"><%= @survey.title %></h1>
        <p class="c-page-subtitle">Fine-tune survey details, track assignments, and question prompts before publishing to advisors.</p>
      </div>
      <div class="u-actions">
        <%= link_to "Back", admin_surveys_path, class: button_classes(:secondary) %>
        <%= link_to "Preview as student", preview_admin_survey_path(@survey), class: button_classes(:subtle) %>
        <% if @survey.is_active? %>
          <%= button_to "Archive survey", archive_admin_survey_path(@survey), method: :patch, data: { turbo_confirm: "Archive '#{@survey.title}' and remove it from advisors?" }, class: button_classes(:subtle) %>
        <% else %>
          <%= button_to "Activate survey", activate_admin_survey_path(@survey), method: :patch, data: { turbo_confirm: "Make '#{@survey.title}' active for advisors?" }, class: button_classes(:primary) %>
        <% end %>
      </div>
    </header>

    <dl class="c-key-value-grid">
      <div class="c-key-value"><dt>Semester</dt><dd><%= @survey.semester.presence || "Unscheduled" %></dd></div>
      <div class="c-key-value"><dt>Available From</dt><dd><%= admin_survey_datetime(@survey.available_from, fallback: "No start") %></dd></div>
      <div class="c-key-value"><dt>Available Until</dt><dd><%= admin_survey_datetime(@survey.available_until, fallback: "No end") %></dd></div>
      <div class="c-key-value"><dt>Created</dt><dd><%= admin_survey_datetime(@survey.created_at, fallback: "-") %></dd></div>
    </dl>

    <div class="u-actions u-actions--start u-gap-xs">
      <% if tracks.present? %>
        <% tracks.each do |track| %>
          <span class="c-pill c-pill--muted"><%= track %></span>
        <% end %>
      <% else %>
        <span class="c-status-pill c-status-pill--warning">Unassigned to tracks</span>
      <% end %>
    </div>
  </section>

  <%= render "form", survey: @survey %>
  </div>
</main>
