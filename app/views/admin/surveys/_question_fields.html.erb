<% question = question_fields.object %>
<% question_uid = question.persisted? ? "question-#{question.id}" : "question-temp-#{question.object_id}" %>
<% supports_sub_questions = question.respond_to?(:parent_question_id) && question.respond_to?(:sub_question_order) %>
<% is_sub_question = supports_sub_questions && question.parent_question_id.present? %>
<% can_add_sub_questions = supports_sub_questions && !is_sub_question %>
<% wrapper_classes = ["c-question-card", "c-card", "c-card--tight", "u-stack", "u-stack--md", "c-builder-question", "c-builder-question-card"] %>
<% wrapper_classes << "c-nested-rail" if is_sub_question %>
<% option_pairs = question.respond_to?(:answer_option_pairs) ? question.answer_option_pairs : [] %>
<% if option_pairs.blank? && question.respond_to?(:answer_options_list) %>
  <% option_pairs = question.answer_options_list.map { |opt| [opt.to_s, opt.to_s] } %>
<% end %>
<% required_input_id = "#{question_uid}-required" %>
<% evidence_input_id = "#{question_uid}-evidence" %>
<% feedback_input_id = "#{question_uid}-feedback" %>
<% survey_context = question.respond_to?(:category) ? question.category&.survey : nil %>
<% target_level_value = if question.respond_to?(:program_target_level)
     resolved_builder_target_level(question: question, survey: survey_context)
   end %>
<% selected_target_level = target_level_value.to_s.presence %>

<%= content_tag :div,
  id: question_uid,
  class: wrapper_classes.join(' '),
  data: {
    question_fields_target: "item",
    controller: "survey-item question-preview markdown-editor",
    action: "focusin->survey-item#expand click->survey-item#expand focusin->question-preview#activate click->question-preview#activate",
    question_preview_initial_option_pairs_value: option_pairs.to_json,
    builder_kind: "question",
    builder_label: question.question_text.to_s.strip.presence || "Untitled question"
  } do %>
  <%= question_fields.hidden_field :id %>
  <%= question_fields.hidden_field :_destroy, value: 0 %>
  <%= question_fields.hidden_field :question_order %>
  <%= question_fields.hidden_field :sub_question_order if supports_sub_questions %>

  <div class="c-builder-question-card__summary c-builder-question__summary u-flex u-items-center u-gap-md">
    <span class="js-drag-handle c-builder-sort-handle" aria-label="Drag to reorder">
      ⋮⋮
    </span>

    <span class="question-type-badge c-pill c-pill--muted" data-question-preview-target="typeBadge">
      <%= question.question_type.to_s.humanize.presence || "Question" %>
    </span>

    <span class="c-level-badge c-level-badge--success hidden" data-question-preview-target="targetLevelBadge"></span>

    <p class="c-builder-question-card__summary-text c-builder-question__summary-text u-min-w-0 u-flex-1 u-text-ellipsis c-table__title" data-question-preview-target="summaryPromptText">
      <%= question.question_text.to_s.strip.presence || "Untitled question" %>
    </p>

    <% if question.respond_to?(:program_target_level) %>
      <label class="sr-only" for="<%= "#{question_uid}-target-level" %>">Target level</label>
      <%= question_fields.select :program_target_level,
        options_for_select([["Target: None", ""]] + (1..5).map { |level| ["Target: #{level}/5", level.to_s] }, selected_target_level),
            {},
            id: "#{question_uid}-target-level",
            class: "c-select c-input--compact",
        data: { question_preview_target: "targetLevelInput", action: "change->question-preview#update" } %>
    <% end %>

    <details class="c-chip-picker" data-question-preview-target="questionTypeDropdown">
      <summary class="c-chip c-chip--inactive c-chip-picker__summary">
        Type: <span data-question-preview-target="questionTypeButtonLabel"><%= question.question_type.to_s.humanize.presence || "Question" %></span>
      </summary>
      <div class="c-chip-picker__menu">
        <% @question_types.each do |type| %>
          <button type="button"
                  class="c-chip-picker__item"
                  data-question-type="<%= type %>"
                  data-action="question-preview#setQuestionType">
            <%= type.humanize %>
          </button>
        <% end %>
      </div>
    </details>

    <% if supports_sub_questions %>
      <button type="button"
              class="<%= button_classes(:subtle, extra_classes: 'btn-sm') %>"
              title="Re-parent"
              data-action="survey-item#toggleReparent"
              data-survey-item-target="reparentToggle">
        Re-parent
      </button>
    <% end %>

    <% if can_add_sub_questions %>
      <% if question.persisted? %>
        <button type="button"
                class="<%= button_classes(:subtle, extra_classes: 'btn-sm') %>"
                data-action="survey-builder#addSubQuestion"
                data-parent-question-id="<%= question.id %>">
          Add sub-question
        </button>
      <% else %>
        <button type="button"
                class="<%= button_classes(:subtle, extra_classes: 'btn-sm u-disabled') %>"
                aria-disabled="true"
                title="Save the survey first to add sub-questions.">
          Add sub-question
        </button>
      <% end %>
    <% end %>

    <button type="button"
            class="<%= button_classes(:danger, extra_classes: 'btn-sm') %>"
            title="Remove question"
            data-action="question-fields#remove">
      Remove
    </button>
  </div>

  <div class="c-builder-question-card__expanded c-builder-question__expanded u-stack u-stack--lg" data-survey-item-target="expanded">
    <div class="u-stack u-stack--lg">
      <div class="u-stack u-stack--lg">
        <div class="c-field">
          <%= question_fields.label :question_text, "Prompt", class: "c-label" %>
          <%= question_fields.text_area :question_text,
                class: "#{input_classes} c-input c-builder-input c-builder-textarea form-control u-w-full",
                rows: 3,
                data: {
                  question_preview_target: "promptInput"
                },
                placeholder: "Ask a clear question advisors can answer." %>
        </div>

        <div class="c-field">
          <%= question_fields.label :description, "Description (optional)", class: "c-label" %>
          <%= question_fields.text_area :description,
                class: "#{input_classes} c-input c-builder-input c-builder-textarea form-control u-w-full",
                rows: 2,
                data: {
                  question_preview_target: "descriptionInput"
                },
                placeholder: "Optional helper text shown under the prompt." %>
        </div>
      </div>

    </div>

    <div class="c-field">
      <p class="c-label">Preview</p>
      <div class="c-card c-card--tight c-builder-preview-card u-stack u-stack--sm">
        <div class="c-table__title" data-question-preview-target="promptText"><%= render_question_prompt(question) %></div>
        <div data-question-preview-target="response"></div>
      </div>
    </div>

    <div class="c-chip-tray">
      <div class="u-actions u-actions--start">
        <%= question_fields.select :question_type,
              options_for_select(@question_types.map { |type| [type.humanize, type] }, question_fields.object.question_type),
              {},
              class: "sr-only",
              data: { question_preview_target: "typeSelect" } %>

        <%= question_fields.check_box :is_required, id: required_input_id, class: "c-chip-toggle__input sr-only", data: { question_preview_target: "requiredInput" } %>
        <%= question_fields.label :is_required,
          "Required",
          for: required_input_id,
          class: "c-chip c-chip--inactive" %>

        <%= question_fields.check_box :has_evidence_field, id: evidence_input_id, class: "c-chip-toggle__input sr-only", data: { question_preview_target: "evidenceInput" } %>
        <%= question_fields.label :has_evidence_field,
          "Evidence",
          for: evidence_input_id,
          class: "c-chip c-chip--inactive" %>

        <% if question.respond_to?(:has_feedback) %>
          <%= question_fields.check_box :has_feedback, id: feedback_input_id, class: "c-chip-toggle__input sr-only", data: { question_preview_target: "feedbackInput" } %>
          <%= question_fields.label :has_feedback,
            "Advisor Feedback Required",
            for: feedback_input_id,
            class: "c-chip c-chip--inactive" %>
        <% end %>

        <% if supports_sub_questions %>
          <button type="button"
                  class="c-chip c-chip--inactive"
                  data-action="survey-item#toggleReparent"
                  data-survey-item-target="reparentToggle">
            Re-parent
          </button>
        <% end %>
      </div>
    </div>

    <% if supports_sub_questions %>
      <% category = question.category %>
      <% persisted_parent_candidates = if category.present?
        category.questions.to_a.select do |candidate|
          candidate != question &&
            candidate.id.present? &&
            (!candidate.respond_to?(:parent_question_id) || candidate.parent_question_id.blank?)
        end
      else
        []
      end %>
      <% parent_options = [["(No parent — this is a parent question)", ""]] + persisted_parent_candidates.map { |candidate| [candidate.question_text.to_s.truncate(80), candidate.id] } %>

      <div class="hidden c-card c-card--tight u-stack u-stack--sm c-builder-inline-panel" data-survey-item-target="reparentPanel">
        <%= question_fields.label :parent_question_id, "Parent", class: "c-label" %>
        <%= question_fields.select :parent_question_id,
                                   options_for_select(parent_options, question.parent_question_id),
                                   {},
                                   class: "#{input_classes} c-select u-w-full form-select",
                                   disabled: persisted_parent_candidates.empty? %>
        <% if persisted_parent_candidates.empty? %>
          <p class="c-help">Save first, then re-parent using this selector.</p>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="c-drawer-backdrop hidden" data-question-preview-target="optionsDrawerBackdrop" data-action="click->question-preview#closeOptionsDrawer"></div>
  <aside class="c-drawer hidden" data-question-preview-target="optionsDrawerPanel" aria-hidden="true" role="dialog" aria-modal="true" tabindex="-1">
    <div class="c-drawer__header">
      <h4 class="c-panel-title">Edit options</h4>
      <button type="button" class="<%= button_classes(:secondary, extra_classes: 'btn-sm') %>" data-action="question-preview#closeOptionsDrawer">Close</button>
    </div>
    <div class="c-drawer__body">
      <%= question_fields.hidden_field :answer_options, data: { question_preview_target: "answerOptionsInput" } %>
      <div class="u-stack u-stack--md" data-question-preview-target="optionsEditorSection">
        <div class="u-actions u-actions--split">
          <label class="c-label">Options</label>
          <button type="button"
                  class="<%= button_classes(:secondary, extra_classes: 'btn-sm') %>"
                  data-action="question-preview#addOptionRow">
            Add option
          </button>
        </div>

        <div class="u-stack u-stack--sm" data-question-preview-target="optionsList"></div>
        <p class="c-help">Edit labels directly. Reorder or remove options as needed.</p>
      </div>

      <div class="u-section-divider u-stack u-stack--md">
        <h5 class="c-builder-panel__title">Advanced settings</h5>

        <div class="c-field">
          <%= question_fields.label :prompt_format, "Prompt format", class: "c-label" %>
          <%= question_fields.select :prompt_format,
            options_for_select([["Plain text", "plain_text"], ["Rich text", "rich_text"]], question.prompt_format.presence || "plain_text"),
            {},
            class: "#{input_classes} c-select u-w-full form-select",
            data: { question_preview_target: "promptFormatSelect" } %>
        </div>

        <div class="u-grid u-grid--2" data-question-preview-target="integerRulesBlock">
          <div class="c-field">
            <%= question_fields.label :integer_min, "Integer min", class: "c-label" %>
            <%= question_fields.number_field :integer_min,
                  class: "#{input_classes} c-input form-control",
                  min: 0,
                  step: 1,
                  placeholder: "No minimum",
                  data: { question_preview_target: "integerMinInput" } %>
          </div>
          <div class="c-field">
            <%= question_fields.label :integer_max, "Integer max", class: "c-label" %>
            <%= question_fields.number_field :integer_max,
                  class: "#{input_classes} c-input form-control",
                  min: 0,
                  step: 1,
                  placeholder: "No maximum",
                  data: { question_preview_target: "integerMaxInput" } %>
          </div>
          <p class="u-col-span-all c-help">Set either bound to enforce integer rules (for example: min 0, max 100).</p>
        </div>

      </div>
    </div>
  </aside>
<% end %>
