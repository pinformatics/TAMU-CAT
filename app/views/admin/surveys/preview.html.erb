<main class="c-main c-main--dashboard" data-survey-scroll-scope>
  <div class="c-page">
    <section class="c-card c-card--brand">
      <header class="c-page-header">
        <div>
          <p class="c-eyebrow">Survey preview</p>
          <h1 class="c-page-title c-page-title--brand"><%= @survey.title %></h1>
          <p class="c-page-subtitle">Read-only preview of the survey layout.</p>
        </div>

        <div class="u-actions">
          <%= link_to "Back", admin_surveys_path, class: button_classes(:secondary) %>
          <%= link_to "Edit Survey", edit_admin_survey_path(@survey), class: button_classes(:primary) %>
        </div>
      </header>
    </section>

    <div class="c-two-column-layout">
      <div class="u-stack u-stack--xl u-min-w-0">
        <div class="c-callout c-callout--info">
          Interactive preview. You can click through fields and submit the preview. No responses are saved.
        </div>

        <%= form_with url: "#", method: :post, local: true, data: { preview_survey_form: true }, class: "survey-form u-stack u-stack--xl" do %>
          <%= render partial: "survey_responses/survey_response",
                     locals: {
                       survey_response: @preview_survey_response,
                       editable: true,
                       existing_answers: {},
                       other_answers: {},
                       viewer_is_student_owner: true
                     } %>

          <div class="c-form-actions-bar">
            <div class="u-actions u-actions--end u-w-full">
              <%= submit_tag "Submit Preview", class: button_classes(:primary) %>
            </div>
          </div>
        <% end %>
      </div>

      <%= render ::SurveyLegendComponent.new(legend: @survey.legend) %>
    </div>
  </div>
</main>
