<main class="c-main c-main--dashboard">
  <div class="c-page">
    <section class="c-card c-card--brand">
      <header class="c-page-header">
        <div>
          <p class="c-eyebrow">Survey admin</p>
          <h1 class="c-page-title c-page-title--brand">Create Survey</h1>
          <p class="c-page-subtitle">Configure a new survey with questions, tracks, and advisor visibility.</p>
        </div>
        <%= link_to "Back to Surveys", admin_surveys_path, class: button_classes(:secondary) %>
      </header>
    </section>

    <section class="c-card u-stack u-stack--xl">
      <%= render "form", survey: @survey %>
    </section>
  </div>
</main>
