<% content_for :title, "Copy Survey" %>
<% tracks = @survey.track_list %>

<main class="c-main c-main--dashboard">
  <div class="c-page">
    <section class="c-card c-card--brand">
      <header class="c-page-header">
        <div>
          <p class="c-eyebrow">Survey admin</p>
          <h1 class="c-page-title c-page-title--brand">Copy Survey</h1>
          <p class="c-page-subtitle">Create a new semester copy of the survey structure without assigning students.</p>
        </div>
        <div class="u-actions">
          <%= link_to "Back to Surveys", admin_surveys_path, class: button_classes(:secondary) %>
          <%= link_to "Edit Source", edit_admin_survey_path(@survey), class: button_classes(:subtle) %>
        </div>
      </header>

      <dl class="c-key-value-grid">
        <div class="c-key-value"><dt>Source</dt><dd><%= @survey.title %></dd></div>
        <div class="c-key-value"><dt>Semester</dt><dd><%= @survey.semester.presence || "Unscheduled" %></dd></div>
        <div class="c-key-value"><dt>Sections</dt><dd><%= @survey.sections.size %></dd></div>
        <div class="c-key-value"><dt>Categories</dt><dd><%= @survey.categories.size %></dd></div>
        <div class="c-key-value"><dt>Questions</dt><dd><%= @survey.questions.size %></dd></div>
      </dl>

      <div class="u-actions u-actions--start u-gap-xs">
        <% if tracks.present? %>
          <% tracks.each do |track| %>
            <span class="c-pill c-pill--muted"><%= track %></span>
          <% end %>
        <% else %>
          <span class="c-status-pill c-status-pill--warning">Unassigned to tracks</span>
        <% end %>
      </div>
    </section>

    <section class="c-card c-card--flush u-overflow-hidden">
      <div class="c-panel-header c-panel-header--with-border">
        <h2 class="c-panel-title">Destination</h2>
        <p class="c-panel-subtitle">The copy keeps the survey setup, question builder content, legend, tracks, and offering rules.</p>
      </div>

      <div class="c-panel-body">
        <% if @copy_target_semesters.blank? %>
          <div class="c-empty-state">
            <p class="c-empty-state__body">Add another semester in Program Setup before copying this survey.</p>
          </div>
        <% else %>
          <%= form_with url: copy_to_semester_admin_survey_path(@survey), method: :post, local: true, class: "u-stack u-stack--lg" do %>
            <div class="u-grid u-grid--2">
              <div class="c-field">
                <%= label_tag "survey_copy_target_program_semester_id", "Copy into semester", class: "c-label" %>
                <div class="c-select-wrapper">
                  <%= select_tag "survey_copy[target_program_semester_id]",
                                 options_from_collection_for_select(@copy_target_semesters, :id, :name, @target_program_semester_id),
                                 id: "survey_copy_target_program_semester_id",
                                 class: "c-select u-w-full" %>
                </div>
                <p class="c-help">Choose the semester that should receive a new survey copy.</p>
              </div>

              <div class="c-callout c-callout--info">
                <p class="c-callout__title">No students will be assigned.</p>
                <p>The copy creates a reusable survey definition only. Faculty can review it first, then assign students from the assignment controls when ready.</p>
              </div>
            </div>

            <div class="u-actions">
              <%= submit_tag "Copy Survey", class: button_classes(:primary) %>
              <%= link_to "Cancel", admin_surveys_path, class: button_classes(:secondary) %>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>
  </div>
</main>
