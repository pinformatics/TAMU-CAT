<main class="c-main c-main--dashboard">
  <div class="c-page">
    <section class="c-card c-card--brand">
      <header class="c-page-header">
        <div>
          <p class="c-eyebrow">Survey admin</p>
          <h1 class="c-page-title c-page-title--brand">Survey Builder</h1>
          <p class="c-page-subtitle">Build surveys, assign them to students, monitor what is live, and review recent changes.</p>
        </div>
        <div class="u-actions">
          <%= link_to "Back", admin_dashboard_path, class: button_classes(:secondary), data: { turbo: false } %>
          <%= link_to "Change Log", admin_survey_change_logs_path, class: button_classes(:secondary) %>
          <%= link_to "Create Survey", new_admin_survey_path, class: button_classes(:primary) %>
        </div>
      </header>
    </section>

    <section id="active-surveys" class="c-card c-card--flush u-overflow-hidden">
      <div class="c-panel-header c-panel-header--with-border">
        <div class="u-responsive-split u-w-full">
          <div class="u-stack u-stack--sm">
            <h2 class="c-section-title c-heading-inline">Active surveys</h2>
            <p class="c-lede">Search, filter, edit, preview, and open student assignment controls for active surveys.</p>
          </div>
          <% if @active_surveys.present? %>
            <span class="c-status-badge c-status-badge--success"><%= pluralize(@active_surveys.size, "active survey") %></span>
          <% end %>
        </div>
      </div>

      <div class="c-panel-header c-panel-header--with-border">
        <div class="u-stack u-stack--sm u-w-full">
          <%= form_with url: admin_surveys_path, method: :get, local: true, class: "c-filter-bar u-w-full" do %>
            <%= hidden_field_tag :sort, @sort_column %>
            <%= hidden_field_tag :direction, @sort_direction %>

            <div class="c-filter-bar__field c-filter-bar__field--wide">
              <%= label_tag :q, "Search", class: "c-label" %>
              <%= text_field_tag :q, @search_query, placeholder: "Title, semester, or description", class: "c-input c-search-input u-w-full" %>
            </div>

            <div class="c-filter-bar__field">
              <%= label_tag :track, "Track", class: "c-label" %>
              <%= select_tag :track,
                             options_for_select([
                               ["All tracks", ""],
                               ["Unassigned", @unassigned_track_token]
                             ] + @track_filter_options.map { |track| [track, track] }, @selected_track),
                             class: "c-select u-w-full" %>
            </div>

            <div class="u-actions u-actions--start">
              <%= submit_tag "Apply", class: button_classes(:primary) %>
              <% if @search_query.present? || @selected_track.present? %>
                <%= link_to "Reset", admin_surveys_path(sort: @sort_column, direction: @sort_direction), class: button_classes(:subtle) %>
              <% end %>
            </div>
          <% end %>

          <% if @search_query.present? || @selected_track.present? %>
            <div class="u-actions u-actions--start">
              <% if @search_query.present? %>
                <span class="c-pill c-pill--muted">Search: "<%= @search_query %>"</span>
              <% end %>
              <% if @selected_track.present? %>
                <% track_label = @selected_track == @unassigned_track_token ? "Unassigned" : @selected_track %>
                <span class="c-pill c-pill--muted">Track: <%= track_label %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <% if @active_surveys.blank? %>
        <div class="c-empty-state"><p class="c-empty-state__body">No surveys match the current search or filter criteria.</p></div>
      <% else %>
        <div class="c-panel-body u-stack u-stack--sm">
          <% @active_survey_groups.each do |semester_name, surveys| %>
            <details class="c-accordion">
              <summary class="c-accordion__summary c-accordion__summary--wrap">
                <span class="c-accordion__title"><%= semester_name %></span>
                <span class="c-accordion__meta c-accordion__meta--wrap">
                  <span><%= pluralize(surveys.size, "survey") %></span>
                  <span><%= pluralize(surveys.sum { |survey| survey.respond_to?(:question_count) ? survey.question_count.to_i : survey.questions.size }, "question") %></span>
                </span>
                <span class="c-accordion__action" aria-hidden="true">
                  <span class="c-accordion__action-closed">Show</span>
                  <span class="c-accordion__action-open">Hide</span>
                </span>
              </summary>
              <%= render "survey_group_table", surveys: surveys, show_assign: true, archived: false, sortable: true %>
            </details>
          <% end %>
        </div>
      <% end %>
    </section>

    <section class="c-card c-card--flush u-overflow-hidden">
      <div class="c-panel-header c-panel-header--with-border">
        <div class="u-responsive-split u-w-full">
          <div class="u-stack u-stack--sm">
            <h2 class="c-section-title c-heading-inline">Archived surveys</h2>
            <p class="c-lede">Re-activate an archived survey to make it available for new assignments.</p>
          </div>
          <% if @archived_surveys.present? %>
            <span class="c-status-badge c-status-badge--muted"><%= pluralize(@archived_surveys.size, "archived survey") %></span>
          <% end %>
        </div>
      </div>

      <% if @archived_surveys.blank? %>
        <div class="c-empty-state"><p class="c-empty-state__body">No archived surveys yet.</p></div>
      <% else %>
        <div class="c-panel-body u-stack u-stack--sm">
          <% @archived_survey_groups.each do |semester_name, surveys| %>
            <details class="c-accordion">
              <summary class="c-accordion__summary c-accordion__summary--wrap">
                <span class="c-accordion__title"><%= semester_name %></span>
                <span class="c-accordion__meta c-accordion__meta--wrap">
                  <span><%= pluralize(surveys.size, "survey") %></span>
                </span>
                <span class="c-accordion__action" aria-hidden="true">
                  <span class="c-accordion__action-closed">Show</span>
                  <span class="c-accordion__action-open">Hide</span>
                </span>
              </summary>
              <%= render "survey_group_table", surveys: surveys, show_assign: false, archived: true, sortable: false %>
            </details>
          <% end %>
        </div>
      <% end %>
    </section>
  </div>
</main>
