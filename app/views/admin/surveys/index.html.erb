<main class="c-main c-main--dashboard">
  <div class="c-page">
    <section class="c-card c-card--brand">
      <header class="c-page-header">
        <div>
          <p class="c-eyebrow">Survey admin</p>
          <h1 class="c-page-title c-page-title--brand">Survey Builder</h1>
          <p class="c-page-subtitle">Build surveys, assign them to students, monitor what is live, and review recent changes.</p>
        </div>
        <div class="u-actions">
          <%= link_to "Back", admin_dashboard_path, class: button_classes(:secondary), data: { turbo: false } %>
          <%= link_to "Change Log", admin_survey_change_logs_path, class: button_classes(:secondary) %>
          <%= link_to "Create Survey", new_admin_survey_path, class: button_classes(:primary) %>
        </div>
      </header>
    </section>

    <% active_count = @active_surveys.size %>
    <% archived_count = @archived_surveys.size %>
    <% total_questions = @active_surveys.sum { |survey| survey.respond_to?(:question_count) ? survey.question_count.to_i : survey.questions.size } %>
    <% latest_activity_at = (@recent_logs.first&.created_at || @active_surveys.map(&:updated_at).compact.max) %>

    <section class="c-stats-grid">
      <div class="c-stat c-stat--info">
        <p class="c-stat__label">Active surveys</p>
        <p class="c-stat__value c-stat__value--lg"><%= active_count %></p>
        <p class="c-stat__subtext">Currently visible to advisors</p>
      </div>
      <div class="c-stat c-stat--success">
        <p class="c-stat__label">Question inventory</p>
        <p class="c-stat__value c-stat__value--lg"><%= number_with_delimiter(total_questions) %></p>
        <p class="c-stat__subtext">Across all active surveys</p>
      </div>
      <div class="c-stat c-stat--warning">
        <p class="c-stat__label">Archived surveys</p>
        <p class="c-stat__value c-stat__value--lg"><%= archived_count %></p>
        <p class="c-stat__subtext">Ready to reactivate when needed</p>
      </div>
      <div class="c-stat c-stat--muted">
        <p class="c-stat__label">Last change</p>
        <% if latest_activity_at.present? %>
          <p class="c-stat__value c-stat__value--md"><%= time_ago_in_words(latest_activity_at) %></p>
          <p class="c-stat__subtext">ago via admin activity</p>
        <% else %>
          <p class="c-stat__value c-stat__value--md">—</p>
          <p class="c-stat__subtext">No edits recorded yet</p>
        <% end %>
      </div>
    </section>

    <section id="active-surveys" class="c-card c-card--flush u-overflow-hidden">
      <div class="c-panel-header c-panel-header--with-border">
        <div class="u-responsive-split u-w-full">
          <div class="u-stack u-stack--sm">
            <h2 class="c-section-title c-heading-inline">Active surveys</h2>
            <p class="c-lede">Search, filter, edit, preview, and open student assignment controls for active surveys.</p>
          </div>
          <% if @active_surveys.present? %>
            <span class="c-status-badge c-status-badge--success"><%= pluralize(@active_surveys.size, "active survey") %></span>
          <% end %>
        </div>
      </div>

      <div class="c-panel-header c-panel-header--with-border">
        <div class="u-stack u-stack--sm u-w-full">
          <div class="c-callout u-w-full">
              <%= form_with url: admin_surveys_path, method: :get, local: true, class: "c-toolbar__row c-toolbar__row--airy u-w-full u-flex-nowrap" do %>
                <%= hidden_field_tag :sort, @sort_column %>
                <%= hidden_field_tag :direction, @sort_direction %>

                <div class="c-toolbar__item u-relative u-flex-1 u-min-w-sm">
                  <%= text_field_tag :q, @search_query, placeholder: "Search by title, semester, or description", class: "c-input c-search-input u-w-full" %>
                </div>

                <div class="c-toolbar__item u-min-w-md">
                  <%= select_tag :track,
                                 options_for_select([
                                   ["All tracks", ""],
                                   ["Unassigned", @unassigned_track_token]
                                 ] + @track_filter_options.map { |track| [track, track] }, @selected_track),
                                 class: "c-select u-w-full" %>
                </div>

                <div class="c-toolbar__item u-flex u-items-center u-gap-md u-shrink-0 u-ml-auto">
                  <%= submit_tag "Apply", class: button_classes(:primary) %>
                  <% if @search_query.present? || @selected_track.present? %>
                    <%= link_to "Reset", admin_surveys_path(sort: @sort_column, direction: @sort_direction), class: button_classes(:subtle) %>
                  <% end %>
                </div>
              <% end %>
          </div>

          <% if @search_query.present? || @selected_track.present? %>
            <div class="u-actions u-actions--start">
              <% if @search_query.present? %>
                <span class="c-pill c-pill--muted">Search: "<%= @search_query %>"</span>
              <% end %>
              <% if @selected_track.present? %>
                <% track_label = @selected_track == @unassigned_track_token ? "Unassigned" : @selected_track %>
                <span class="c-pill c-pill--muted">Track: <%= track_label %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

          <% if @active_surveys.blank? %>
            <div class="c-empty-state"><p class="c-empty-state__body">No surveys match the current search or filter criteria.</p></div>
          <% else %>
            <div class="c-table-wrapper">
              <table class="c-table c-table--zebra">
                <thead>
                  <tr>
                    <th scope="col"><%= sortable_header("Survey", "title") %></th>
                    <th scope="col"><%= sortable_header("Semester", "semester") %></th>
                    <th scope="col">Available Date / Due Date</th>
                    <th scope="col">Tracks</th>
                    <th scope="col" class="u-text-right"><%= sortable_header("Updated", "updated_at") %></th>
                    <th scope="col" class="u-text-right">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @active_surveys.each do |survey| %>
                    <% tracks = survey.track_list %>
                    <tr>
                      <td>
                        <div class="c-table__title"><%= survey.title %></div>
                        <div class="c-table__meta"><%= survey.description.presence || "No description provided." %></div>
                      </td>
                      <td class="u-whitespace-nowrap"><%= survey.semester.presence || "Unscheduled" %></td>
                      <td>
                        <div class="u-stack u-stack--xs">
                          <span><strong>Available:</strong> <%= survey.available_from.present? ? format_calendar_date(survey.available_from) : "No start date" %></span>
                          <span><strong>Due:</strong> <%= survey.available_until.present? ? format_calendar_date(survey.available_until) : "No due date" %></span>
                        </div>
                      </td>
                      <td>
                        <% if tracks.present? %>
                          <div class="u-actions u-actions--start u-gap-xs">
                            <% tracks.each do |track| %>
                              <span class="c-pill c-pill--muted"><%= track %></span>
                            <% end %>
                          </div>
                        <% else %>
                          <span class="c-status-pill c-status-pill--warning">Unassigned</span>
                        <% end %>
                      </td>
                      <td class="u-whitespace-nowrap u-text-right"><%= time_ago_in_words(survey.updated_at) %> ago</td>
                      <td class="u-whitespace-nowrap">
                        <div class="u-actions u-actions--nowrap">
                          <%= link_to "Assign", assignments_survey_path(survey), class: button_classes(:primary, extra_classes: "btn-sm"), data: { turbo: false } %>
                          <%= link_to "Preview", preview_admin_survey_path(survey), class: button_classes(:subtle, extra_classes: "btn-sm") %>
                          <%= link_to "Edit", edit_admin_survey_path(survey), class: button_classes(:subtle, extra_classes: "btn-sm") %>
                          <%= button_to "Archive", archive_admin_survey_path(survey), method: :patch, data: { turbo_confirm: "Archive '#{survey.title}' and remove it from advisors?" }, class: button_classes(:secondary) %>
                          <%= button_to "Delete", admin_survey_path(survey), method: :delete, data: { turbo_confirm: "Delete '#{survey.title}' permanently?" }, class: button_classes(:danger) %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
    </section>

    <section class="c-card c-card--flush u-overflow-hidden">
      <div class="c-panel-header c-panel-header--with-border">
        <div class="u-responsive-split u-w-full">
          <div class="u-stack u-stack--sm">
            <h2 class="c-section-title c-heading-inline">Archived surveys</h2>
            <p class="c-lede">Re-activate an archived survey to make it available for new assignments.</p>
          </div>
          <% if @archived_surveys.present? %>
            <span class="c-status-badge c-status-badge--muted"><%= pluralize(@archived_surveys.size, "archived survey") %></span>
          <% end %>
        </div>
      </div>

        <% if @archived_surveys.blank? %>
          <div class="c-empty-state"><p class="c-empty-state__body">No archived surveys yet.</p></div>
        <% else %>
            <div class="c-table-wrapper">
              <table class="c-table c-table--zebra">
                <thead>
                  <tr>
                    <th scope="col">Title</th>
                    <th scope="col">Semester</th>
                    <th scope="col">Available Date / Due Date</th>
                    <th scope="col">Tracks</th>
                    <th scope="col" class="u-text-right">Updated</th>
                    <th scope="col" class="u-text-right">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @archived_surveys.each do |survey| %>
                    <% tracks = survey.track_list %>
                    <tr>
                      <td>
                        <div class="c-table__title"><%= survey.title %></div>
                        <div class="c-table__meta"><%= survey.description.presence || "No description provided." %></div>
                      </td>
                      <td class="u-whitespace-nowrap"><%= survey.semester.presence || "Unscheduled" %></td>
                      <td>
                        <div class="u-stack u-stack--xs">
                          <span><strong>Available:</strong> <%= survey.available_from.present? ? format_calendar_date(survey.available_from) : "No start date" %></span>
                          <span><strong>Due:</strong> <%= survey.available_until.present? ? format_calendar_date(survey.available_until) : "No due date" %></span>
                        </div>
                      </td>
                      <td>
                        <% if tracks.present? %>
                          <div class="u-actions u-actions--start u-gap-xs">
                            <% tracks.each do |track| %>
                              <span class="c-pill c-pill--muted"><%= track %></span>
                            <% end %>
                          </div>
                        <% else %>
                          <span class="c-status-pill c-status-pill--warning">Unassigned</span>
                        <% end %>
                      </td>
                      <td class="u-whitespace-nowrap u-text-right"><%= time_ago_in_words(survey.updated_at) %> ago</td>
                      <td class="u-whitespace-nowrap">
                        <div class="u-actions u-actions--nowrap">
                          <%= link_to "Preview", preview_admin_survey_path(survey), class: button_classes(:subtle, extra_classes: "btn-sm") %>
                          <%= button_to "Activate", activate_admin_survey_path(survey), method: :patch, data: { turbo_confirm: "Activate '#{survey.title}' for advisors?" }, class: button_classes(:primary) %>
                          <%= button_to "Delete", admin_survey_path(survey), method: :delete, data: { turbo_confirm: "Delete '#{survey.title}' permanently?" }, class: button_classes(:danger) %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
        <% end %>
    </section>
  </div>
</main>
