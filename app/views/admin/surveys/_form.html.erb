<% track_options = (@available_tracks + survey.track_list).uniq.compact.sort %>
<% input_classes = "c-input" %>
<% textarea_classes = "#{input_classes} c-textarea" %>
<% checkbox_classes = "c-choice" %>

<%= form_with(model: [:admin, survey],
              local: true,
              class: "survey-form u-w-full u-stack u-stack--xl",
              data: { controller: "survey-tabs" }) do |form| %>
  <% if survey.errors.any? %>
    <div class="c-callout c-callout--danger">
      <h2 class="c-panel-title"><%= pluralize(survey.errors.count, "error") %> prevented this survey from being saved:</h2>
      <ul>
        <% survey.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <header class="c-card c-card--brand">
    <div class="c-page-header">
      <div class="u-stack u-stack--md">
        <h2 class="c-section-title">Survey Setup</h2>
        <p class="c-page-subtitle">This builder mirrors the student survey layout. Use the sidebar to add and navigate sections, categories, and questions.</p>
      </div>

      <div class="c-muted-meta" aria-live="polite">
        <span>Autosave disabled</span>
      </div>
    </div>
  </header>

  <%= render "admin/surveys/survey_tabs" %>

  <section id="panel-settings" role="tabpanel" aria-labelledby="tab-settings" data-survey-tabs-target="panel" data-tab-panel="settings" aria-hidden="false" class="u-stack u-stack--xl">
    <%= render "admin/surveys/survey_settings_form",
               form: form,
               survey: survey,
               track_options: track_options,
               input_classes: input_classes,
               textarea_classes: textarea_classes,
               checkbox_classes: checkbox_classes %>

    <div class="u-sticky-action-bar">
      <div class="c-form-actions u-actions">
        <%= link_to "Cancel", admin_surveys_path, class: button_classes(:secondary) %>
        <% if survey.persisted? %>
          <%= button_tag "Change Deadline for Everyone",
                         type: "submit",
                         name: "force_deadline_for_everyone",
                         value: "1",
                         data: { turbo_confirm: "Clear all individual assignment deadlines and make everyone follow the survey due date, including completed responses?" },
                         class: button_classes(:secondary) %>
        <% end %>
        <%= form.submit(survey.persisted? ? "Update survey" : "Create survey", class: button_classes(:primary)) %>
      </div>
    </div>
  </section>

  <section id="panel-builder" role="tabpanel" aria-labelledby="tab-builder" data-survey-tabs-target="panel" data-tab-panel="builder" aria-hidden="true" class="hidden">
    <%= render "admin/surveys/survey_builder_workspace",
               form: form,
               survey: survey,
               input_classes: input_classes,
               textarea_classes: textarea_classes,
               checkbox_classes: checkbox_classes %>
  </section>

  <section id="panel-legend" role="tabpanel" aria-labelledby="tab-legend" data-survey-tabs-target="panel" data-tab-panel="legend" aria-hidden="true" class="hidden u-stack u-stack--xl">
    <%= render "admin/surveys/survey_legend_form",
               form: form,
               survey: survey %>

    <div class="u-sticky-action-bar">
      <div class="c-toolbar__row u-justify-end u-w-full">
        <div class="u-actions">
          <%= link_to "Cancel", admin_surveys_path, class: button_classes(:secondary) %>
          <%= form.submit(survey.persisted? ? "Update survey" : "Create survey", class: button_classes(:primary)) %>
        </div>
      </div>
    </div>
  </section>
<% end %>
