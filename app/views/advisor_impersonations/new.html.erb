<main class="c-main c-main--dashboard">
  <div class="c-page">
    <section class="c-card c-card--brand">
      <header class="c-page-header">
        <div>
          <p class="c-eyebrow">Admin tools</p>
          <h1 class="c-page-title c-page-title--brand">View as advisor</h1>
          <p class="c-page-subtitle">Read-only preview of the advisor experience.</p>
        </div>

        <%= link_to "Back", admin_dashboard_path, class: button_classes(:secondary), data: { turbo: false } %>
      </header>
    </section>

    <section class="c-card c-card--spacious u-stack u-stack--md u-mx-auto u-max-w-xl">
      <% if @advisors.present? %>
        <%= form_with scope: :advisor_impersonation, url: advisor_impersonation_path, method: :post, class: "u-stack u-stack--md" do %>
          <%= render SearchableSelectComponent.new(
            id: "advisor-impersonation-user-id",
            name: "advisor_impersonation[user_id]",
            label: "Advisor",
            placeholder: "Search by name or email...",
            options: @advisors.map { |u| { value: u.id, label: u.full_name, description: u.email } }
          ) %>

          <div class="u-actions u-actions--start">
            <%= submit_tag "View as", class: button_classes(:primary) %>
          </div>
        <% end %>
      <% else %>
        <div class="c-empty-state">
          <p class="c-empty-state__body">No advisors found.</p>
        </div>
      <% end %>
    </section>
  </div>
</main>
