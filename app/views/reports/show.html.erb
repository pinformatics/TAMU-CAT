<main class="c-main">
  <div class="c-toolbar c-toolbar--spaced">
    <div class="c-toolbar__row">
      <% if current_user&.respond_to?(:role_admin?) && current_user.role_admin? %>
        <%= link_to "← Back", admin_dashboard_path, class: button_classes(:secondary), data: { turbo: false } %>
      <% else %>
        <%= link_to "← Back", advisor_dashboard_path, class: button_classes(:secondary), data: { turbo: false } %>
      <% end %>
    </div>
  </div>

  <section class="c-card c-card--spacious u-stack u-stack--xl">
    <header class="c-page-header">
      <div>
        <p class="c-eyebrow">Reports</p>
        <h1 class="c-page-title c-page-title--brand">Program Reports</h1>
        <p class="c-page-subtitle">Monitor cohort progress, advisor alignment, and competency trends in real time.</p>
      </div>
    </header>

    <div
      class="c-analytics-root c-card c-card--flush"
      data-controller="reports"
      data-reports-pdf-url-value="<%= export_reports_pdf_path("dashboard") %>"
      data-reports-excel-url-value="<%= export_reports_excel_path %>"
    ></div>

    <noscript>
      <p class="c-callout c-callout--warning">Analytics require JavaScript. Please enable it to view the interactive dashboard.</p>
    </noscript>
  </section>
</main>
