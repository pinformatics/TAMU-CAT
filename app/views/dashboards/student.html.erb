<!-- app/views/dashboards/student.html.erb -->
<main class="c-main c-main--dashboard u-stack u-stack--md">
  <%= render "shared/role_switcher" %>

  <section class="c-card c-card--compact c-card--brand">
    <header class="c-page-header c-page-header--compact">
      <div>
        <p class="c-eyebrow">Student workspace</p>
        <h1 class="c-page-title c-page-title--brand">Student Dashboard</h1>
        <p class="c-page-subtitle">Review surveys, notifications, and competency progress.</p>
      </div>
      <%= link_to "My Competencies", student_competencies_path, class: button_classes(:secondary), data: { turbo: false } %>
    </header>
  </section>

  <div class="c-dashboard-grid c-dashboard-grid--2">
    <div class="c-dashboard-column">
      <!-- To-Do Section -->
      <section class="c-card c-card--compact c-card--hover">
        <h2 class="c-section-title c-heading-inline">
          <div class="c-icon--survey" aria-hidden="true"></div>
          To-do
        </h2>
        
        <div class="u-stack u-stack--md">
          <% if @pending_surveys.present? %>
            <% @pending_surveys.each do |entry| %>
              <% survey = entry[:survey] %>
              <% offering = @offerings_by_survey_id[survey.id] %>
              <%= render "dashboards/student_survey_card", entry: entry, offering: offering, mode: :pending %>
            <% end %>
          <% else %>
            <div class="c-list-item c-list-item--empty">No pending surveys</div>
          <% end %>
        </div>
      </section>

      <!-- Completed Surveys Section -->
      <section class="c-card c-card--compact c-card--hover">
        <h2 class="c-section-title c-heading-inline">
          <div class="c-icon--survey" aria-hidden="true"></div>
          Completed Surveys
        </h2>

        <div class="u-stack u-stack--md">
          <% if @completed_surveys.present? %>
            <% @completed_surveys.each do |entry| %>
              <% survey = entry[:survey] %>
              <% offering = @offerings_by_survey_id[survey.id] %>
              <%= render "dashboards/student_survey_card", entry: entry, offering: offering, mode: :completed %>
            <% end %>
          <% else %>
            <div class="c-list-item c-list-item--empty">No completed surveys</div>
          <% end %>
        </div>
      </section>
    </div>

    <%= render "dashboards/dashboard_notifications",
               notifications: @dashboard_notifications,
               empty_message: "No unread notifications.",
               card_classes: "c-card c-card--compact c-card--hover u-self-start",
               list_classes: "u-stack u-stack--sm u-max-h-md u-scroll-y",
               compact: true %>

  </div>
  
  
</main>
