<!-- app/views/dashboards/student.html.erb -->
<main class="c-main">
  <%= render "shared/role_switcher" %>
  
  <div class="c-dashboard-grid c-dashboard-grid--2">
    <div class="c-dashboard-column">
      <!-- To-Do Section -->
      <section class="c-card c-card--hover">
        <h2 class="c-section-title c-heading-inline">
          <div class="c-icon--survey" aria-hidden="true"></div>
          To-do
        </h2>
        
        <div class="u-stack u-stack--md">
          <% if @pending_surveys.present? %>
            <% @pending_surveys.each do |entry| %>
              <% survey = entry[:survey] %>
              <% offering = @offerings_by_survey_id[survey.id] %>
              <div class="c-list-item">
                <div class="c-item-title u-actions u-actions--start">
                  <span><%= survey.title %></span>
                  <span class="<%= survey_status_badge_classes(survey.is_active? ? 'Active' : 'Archived') %>"><%= survey.is_active? ? "Active" : "Archived" %></span>
                </div>
                <% if survey.semester.present? %>
                  <div class="c-meta-list">
                    <%= survey.semester %>
                  </div>
                <% end %>
                <% if (review_note = review_meetings_note(offering)).present? %>
                  <div class="c-meta-list">
                    Review meetings: <%= review_note %>
                  </div>
                <% end %>
                <% progress = entry[:progress] || {} %>
                <% completion_status = if entry[:completed_at].present?
                    "Completed"
                  elsif progress[:answered_total].to_i.positive?
                    "In Progress"
                  else
                    "Not Started"
                  end %>
                <div class="c-meta-list">
                  <% if entry[:available_from].present? %>
                    Available from: <%= l(entry[:available_from].in_time_zone, format: :long) %>
                  <% else %>
                    Available from: Not set
                  <% end %>
                </div>
                <div class="c-meta-list">
                  <% if entry[:available_until].present? %>
                    Due: <%= l(entry[:available_until].in_time_zone, format: :long) %>
                  <% else %>
                    Due: Not set
                  <% end %>
                </div>
                <div class="c-meta-list">
                  <% total_required = progress[:total_required].to_i %>
                  <% answered_required = progress[:answered_required].to_i %>
                  <% if total_required.positive? %>
                    <span class="survey-progress">
                      <%= answered_required %> of <%= total_required %> required questions answered
                    </span>
                  <% end %>
                </div>
                <div class="c-meta-list u-actions u-actions--start">
                  <span class="<%= survey_status_badge_classes(completion_status) %>"><%= completion_status %></span>
                </div>
                <div class="c-action-stack">
                  <div class="u-actions">
                    <%= link_to 'Open', survey_path(survey), class: button_classes(:primary) %>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="c-list-item c-list-item--empty">No pending surveys</div>
          <% end %>
        </div>
      </section>

      <!-- Completed Surveys Section -->
      <section class="c-card c-card--hover">
        <h2 class="c-section-title c-heading-inline">
          <div class="c-icon--survey" aria-hidden="true"></div>
          Completed Surveys
        </h2>

        <div class="completed-list">
          <% if @completed_surveys.present? %>
            <% @completed_surveys.each do |entry| %>
              <% survey = entry[:survey] %>
              <% offering = @offerings_by_survey_id[survey.id] %>
              <% survey_response = entry[:survey_response] %>
              <% download_token = entry[:download_token] %>
              <% available_from = entry[:available_from] %>
              <% available_until = entry[:available_until] %>
              <% can_edit = survey.is_active? && (available_until.blank? || available_until >= Time.current) %>
              <% edit_disabled_hint = survey.is_active? ? "Edit disabled: deadline has passed." : "Edit disabled: this survey is archived." %>
              <div class="completed-item">
                <div class="c-item-title u-actions u-actions--start">
                  <span><%= survey.title %></span>
                  <span class="<%= survey_status_badge_classes(survey.is_active? ? 'Active' : 'Archived') %>"><%= survey.is_active? ? "Active" : "Archived" %></span>
                </div>
                <% if survey.semester.present? %>
                  <div class="c-meta-list">
                    <%= survey.semester %>
                  </div>
                <% end %>
                <% if (review_note = review_meetings_note(offering)).present? %>
                  <div class="c-meta-list">
                    Review meetings: <%= review_note %>
                  </div>
                <% end %>
                <% progress = entry[:progress] || {} %>
                <% completion_status = if entry[:completed_at].present?
                    "Completed"
                  elsif progress[:answered_total].to_i.positive?
                    "In Progress"
                  else
                    "Not Started"
                  end %>
                <div class="c-meta-list">
                  <% if available_from.present? %>
                    Available from: <%= l(available_from.in_time_zone, format: :long) %>
                  <% else %>
                    Available from: Not set
                  <% end %>
                </div>
                <div class="c-meta-list">
                  <% if available_until.present? %>
                    Due: <%= l(available_until.in_time_zone, format: :long) %>
                  <% else %>
                    Due: Not set
                  <% end %>
                </div>

                <div class="c-meta-list">
                  <% total_required = progress[:total_required].to_i %>
                  <% answered_required = progress[:answered_required].to_i %>
                  <% if total_required.positive? %>
                    <span class="survey-progress">
                      <%= answered_required %> of <%= total_required %> required questions answered
                    </span>
                  <% end %>
                </div>

                <div class="c-meta-list u-actions u-actions--start">
                  <span class="<%= survey_status_badge_classes(completion_status) %>"><%= completion_status %></span>
                </div>
                <div class="c-action-stack">
                  <div class="u-actions">
                    <%= link_to 'Review', survey_response_path(survey_response), class: button_classes(:secondary) %>
                    <% if can_edit %>
                      <%= link_to 'Edit', survey_path(survey), class: button_classes(:secondary) %>
                    <% else %>
                        <span
                          class="<%= button_classes(:secondary) %> u-disabled"
                          role="button"
                          aria-disabled="true"
                          tabindex="0"
                          aria-describedby="edit-disabled-hint-completed<%= survey.id %>">
                          Edit
                        </span>
                        <span id="edit-disabled-hint-completed<%= survey.id %>" class="sr-only"><%= edit_disabled_hint %></span>
                    <% end %>
                    <%= link_to 'Download PDF', download_survey_response_path(survey_response, token: download_token), class: button_classes(:primary), target: "_blank", rel: "noopener noreferrer" %>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="completed-item empty">No completed surveys</div>
          <% end %>
        </div>
      </section>
    </div>

    <!-- Notifications Section -->
    <section class="c-card c-card--hover">
      <h2 class="c-section-title c-heading-inline">
        <div class="c-section-icon"></div>
        Notifications
      </h2>
      
      <div class="u-stack u-stack--md u-max-h-70vh u-scroll-y">
        <% if @dashboard_notifications.present? %>
          <% @dashboard_notifications.each do |notification| %>
            <div class="c-list-item c-media<%= notification.read? ? '' : ' is-unread' %>">
              <div class="u-flex u-items-center u-justify-center u-size-lg u-rounded-full c-icon-circle" aria-hidden="true">
                <span class="c-icon-button__icon">
                  <span class="sr-only">Notification</span>
                  <%= image_tag "notification-icon.png", alt: "", class: "c-notification-icon", aria: { hidden: true } %>
                </span>
              </div>
              <div class="c-media__content">
                <%= link_to notification.title, notification_path(notification), class: "c-media__title-link" %>

                <p class="c-help">
                  <%= truncate(notification.message, length: 120) %>
                </p>

                <time class="c-help" datetime="<%= notification.created_at.iso8601 %>">
                  <%= time_ago_in_words(notification.created_at) %> ago
                </time>

                <% if (target = notification.target_path_for(current_user)).present? %>
                  <div class="mt-lg">
                    <%= link_to "Open related record", target, class: button_classes(:subtle) %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
          <div class="u-actions">
            <%= link_to "View all notifications", notifications_path, class: button_classes(:secondary) %>
          </div>
        <% else %>
          <div class="c-list-item c-media">
            <div class="u-flex u-items-center u-justify-center u-size-lg u-rounded-full c-icon-circle" aria-hidden="true">
              <span class="c-icon-button__icon">
                <span class="sr-only">Notification</span>
                <%= image_tag "notification-icon.png", alt: "", class: "c-notification-icon", aria: { hidden: true } %>
              </span>
            </div>
            <div class="c-media__content">
              <p class="c-help">You're all caught up! New notifications will appear here.</p>
            </div>
          </div>
        <% end %>
      </div>
    </section>

  </div>
  
  
</main>
