<!-- Main Content for Advisor Dashboard - layout provides html/head/body and navbar -->
<main class="c-main c-main--dashboard c-main--viewport u-stack u-stack--md">
  <%= render "shared/role_switcher" %>

  <section class="c-card c-card--compact c-card--brand">
    <header class="c-page-header c-page-header--compact">
      <div>
        <p class="c-eyebrow">Advisor workspace</p>
        <h1 class="c-page-title c-page-title--brand">Advisor Dashboard</h1>
        <p class="c-page-subtitle">Review advisees, reports, and competency progress.</p>
      </div>
    </header>
  </section>

  <section class="c-card c-card--compact u-stack u-stack--md">
    <header class="c-page-header c-page-header--compact">
      <div>
        <p class="c-eyebrow">Navigation</p>
        <h2 class="c-section-title">Advisor Tools</h2>
      </div>
    </header>

    <div class="c-dashboard-grid c-dashboard-grid--dense">
      <div class="c-card c-card--interactive c-card--hover c-card--lift c-tile c-tile--compact">
        <%= link_to reports_path, class: "c-tile__link" do %>
          <div class="c-tile__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img" focusable="false">
              <path d="M4 19h16" />
              <path d="M7 16V9" />
              <path d="M12 16V5" />
              <path d="M17 16v-4" />
            </svg>
          </div>
          <div class="c-tile__title">Reports</div>
          <div class="c-tile__description"><%= @total_reports || 0 %> generated</div>
        <% end %>
      </div>

      <div class="c-card c-card--interactive c-card--hover c-card--lift c-tile c-tile--compact">
        <%= link_to student_records_path, class: "c-tile__link" do %>
          <div class="c-tile__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img" focusable="false">
              <path d="M16 3h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3" />
              <path d="M9 3h6v4H9z" />
              <path d="M8 13h8" />
              <path d="M8 17h5" />
            </svg>
          </div>
          <div class="c-tile__title">Records</div>
          <div class="c-tile__description"><%= pluralize(@advisee_count, "assigned student") %></div>
        <% end %>
      </div>

      <div class="c-card c-card--interactive c-card--hover c-card--lift c-tile c-tile--compact">
        <%= link_to admin_competencies_path, class: "c-tile__link" do %>
          <div class="c-tile__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img" focusable="false">
              <circle cx="12" cy="12" r="8" />
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v4" />
              <path d="M12 18v4" />
              <path d="M2 12h4" />
              <path d="M18 12h4" />
            </svg>
          </div>
          <div class="c-tile__title">Competencies</div>
          <div class="c-tile__description">Compare self, advisor, and course competency scores.</div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="c-card c-card--compact u-stack u-stack--md">
    <header class="c-page-header c-page-header--compact">
      <div>
        <p class="c-eyebrow">Competency follow-up</p>
        <h2 class="c-section-title">Students Needing Attention</h2>
        <p class="c-help">Students appear here when they have incomplete surveys or self/course ratings below their configured target.</p>
      </div>
      <%= link_to "Open competency matrix", admin_competencies_path, class: button_classes(:secondary), data: { turbo: false } %>
    </header>

    <% if @students_needing_attention.present? %>
      <div class="c-table-wrapper">
        <table class="c-table">
          <thead>
            <tr>
              <th>Student</th>
              <th>Semester</th>
              <th>Incomplete Surveys</th>
              <th>Below Target</th>
              <th class="u-text-right">Action</th>
            </tr>
          </thead>
          <tbody>
            <% @students_needing_attention.each do |row| %>
              <tr>
                <td>
                  <span class="c-table__title"><%= row[:student_name] %></span>
                  <% if row[:email].present? %>
                    <span class="c-table__meta"><%= row[:email] %></span>
                  <% end %>
                </td>
                <td><%= row[:semester] %></td>
                <td><%= row[:missing_survey_count] %></td>
                <td>
                  <% if row[:below_target_competencies].present? %>
                    <%= pluralize(row[:below_target_competencies].size, "competency") %>
                    <span class="c-table__meta"><%= row[:below_target_competencies].first(2).map { |item| item[:title] }.join(", ") %></span>
                  <% else %>
                    <span class="c-muted">None</span>
                  <% end %>
                </td>
                <td class="u-text-right">
                  <%= link_to "Detailed competencies",
                        admin_competency_path(row[:student_id], row[:detail_path_params]),
                        class: button_classes(:secondary),
                        data: { turbo: false } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="c-empty-state">
        <p class="c-empty-state__body">No assigned students need competency follow-up right now.</p>
      </div>
    <% end %>
  </section>
</main>
