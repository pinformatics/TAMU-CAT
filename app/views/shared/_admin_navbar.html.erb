<!-- Admin Navigation Header -->
<header class="c-app-header" role="banner">
  <div class="c-app-header__content">
    <div class="c-app-header__left c-app-header__left--brand-only">
      <%= link_to admin_dashboard_path, class: "c-brand-link", aria: { label: "Texas A&M University home" } do %>
        <div class="c-brand-logo" aria-hidden="true"></div>
        <span class="sr-only">Texas A&amp;M University</span>
      <% end %>

      <button type="button"
              class="c-mobile-menu-button"
              data-mobile-nav-toggle
              aria-label="Open navigation menu"
              aria-controls="admin-mobile-nav"
              aria-expanded="false">
        <span class="c-mobile-menu-button__bar" aria-hidden="true"></span>
        <span class="c-mobile-menu-button__bar" aria-hidden="true"></span>
        <span class="c-mobile-menu-button__bar" aria-hidden="true"></span>
      </button>
    </div>

    <div id="admin-mobile-nav" class="c-nav-drawer" data-mobile-nav-drawer aria-label="Admin navigation">
      <div class="c-nav-drawer__header">
        <span class="c-nav-drawer__title">Admin Menu</span>
        <button type="button" class="c-nav-drawer__close" data-mobile-nav-close aria-label="Close navigation menu">&times;</button>
      </div>

      <nav class="c-nav-links" aria-label="Primary">
        <a href="<%= admin_dashboard_path %>"
           class="c-nav-link <%= 'active' if local_assigns[:active_page] == 'home' %>">
          Home
        </a>

        <%= link_to "Reports",
                    reports_path,
                    class: "c-nav-link #{'active' if local_assigns[:active_page] == 'reports'}" %>

        <%= link_to "Survey Records",
                    survey_records_path,
                    class: "c-nav-link #{'active' if local_assigns[:active_page] == 'students'}" %>

        <%= link_to "Student Overview",
                    student_overviews_path,
                    class: "c-nav-link #{'active' if local_assigns[:active_page] == 'student_overviews'}" %>

        <%= link_to "Surveys",
                    admin_surveys_path,
                    class: "c-nav-link #{'active' if local_assigns[:active_page] == 'surveys'}" %>

        <%= link_to "FAQ",
                    faq_path,
                    class: "c-nav-link #{'active' if current_page?(faq_path)}" %>
      </nav>

      <div class="c-user-section">
      <%= render ToggleSwitchComponent.new(
        id: "high-contrast-toggle",
        checked: false,
        label: "High Contrast",
        data: { high_contrast_toggle: true }
      ) %>

      <%= render ToggleSwitchComponent.new(
        id: "tts-toggle",
        checked: false,
        label: "Read Aloud",
        data: { tts_toggle: true }
      ) %>

      <%= render "shared/translate_toggle" %>

      <span class="c-role-badge c-role-badge--admin">ADMIN</span>
      <div>
        <%= render "shared/notification_menu" %>
      </div>

      <% avatar_url = current_user&.avatar_url.presence %>
      <div class="c-user-profile">
        <div class="c-user-avatar" title="<%= current_user&.full_name %>">
          <% if avatar_url %>
            <img src="<%= avatar_url %>" alt="<%= avatar_aria_label(current_user) %>" loading="lazy">
          <% else %>
            <span aria-hidden="true">👤</span>
            <span class="sr-only"><%= avatar_aria_label(current_user) %></span>
          <% end %>
        </div>

        <div class="c-profile-popover">
          <div class="c-profile-summary">
            <div class="c-user-avatar">
              <% if avatar_url %>
                <img src="<%= avatar_url %>" alt="<%= avatar_aria_label(current_user) %>" loading="lazy">
              <% else %>
                <span aria-hidden="true">👤</span>
                <span class="sr-only"><%= avatar_aria_label(current_user) %></span>
              <% end %>
            </div>
            <div class="c-profile-info">
              <h3 class="c-h3"><%= current_user&.full_name || "Admin User" %></h3>
              <p><%= current_user&.email %></p>
            </div>
          </div>

          <div class="c-profile-actions">
            <%= link_to account_path, class: "c-profile-action" do %>
            <div class="c-profile-action__icon" aria-hidden="true">👤</div>
            <span>Account Information</span>
          <% end %>
            <%= link_to settings_path, class: "c-profile-action" do %>
              <div class="c-profile-action__icon" aria-hidden="true">⚙️</div>
              <span>Settings</span>
            <% end %>
            <%= link_to destroy_user_session_path,
                        method: :delete,
                        class: "c-profile-action danger" do %>
              <div class="c-profile-action__icon" aria-hidden="true">🚪</div>
              <span>Sign Out</span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    </div>

    <div class="c-nav-drawer-backdrop" data-mobile-nav-backdrop hidden></div>
  </div>
</header>
