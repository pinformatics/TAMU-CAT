# TAMU CAT environment template
# Copy this file to .env for local development. Never commit real secrets.

# Local Rails / Docker defaults
RAILS_ENV=development
APP_TIME_ZONE="Central Time (US & Canada)"
PORT=3000
RAILS_MAX_THREADS=3

# Local PostgreSQL
# Docker Compose overrides these inside the web/css containers.
# Use localhost:5433 when running Rails directly on the host against the Docker DB.
PGHOST=localhost
PGPORT=5433
PGUSER=dev_user
PGPASSWORD=dev_pass
DATABASE=tamu_cat_development
CACHE_DATABASE=tamu_cat_cache
QUEUE_DATABASE=tamu_cat_queue
CABLE_DATABASE=tamu_cat_cable
TEST_DATABASE=tamu_cat_test

# Alternate DB aliases supported by config/database.yml.
# Prefer PGHOST/PGPORT/PGUSER/PGPASSWORD unless you need these names.
# DATABASE_HOST=localhost
# DATABASE_PORT=5433
# DATABASE_USER=dev_user
# DATABASE_PASSWORD=dev_pass
# POSTGRES_USER=dev_user
# POSTGRES_PASSWORD=dev_pass

# Production / Heroku database
# Heroku sets DATABASE_URL when Heroku Postgres is attached.
# DATABASE_URL=postgres://user:password@host:5432/database

# Rails credentials
# Local development normally reads config/master.key if present.
# Heroku production/review apps need this set as a config var.
# RAILS_MASTER_KEY=

# Google OAuth / TAMU sign-in
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/users/auth/google_oauth2/callback

# App host for generated links
# Production should set APP_HOST explicitly, e.g. tamu-cat.herokuapp.com.
APP_HOST=localhost:3000
APP_PROTOCOL=http

# Email notifications
# Keep false until APP_HOST, MAILER_FROM, and SMTP settings are confirmed.
EMAIL_NOTIFICATIONS_ENABLED=false
MAILER_FROM=noreply@tamu.edu
SMTP_ADDRESS=smtp-relay.tamu.edu
SMTP_PORT=587
SMTP_DOMAIN=tamu.edu
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Background jobs / Solid Queue
# Set SOLID_QUEUE_IN_PUMA=true on Heroku when jobs should run inside the web dyno.
# SOLID_QUEUE_IN_PUMA=true
JOB_CONCURRENCY=1

# Heroku/runtime tuning
RAILS_LOG_LEVEL=info
# WEB_CONCURRENCY=2
# PIDFILE=tmp/pids/server.pid
# DISABLE_BOOTSNAP=1

# Heroku CLI helpers
# Prefer entering this when prompted or storing it in your shell, not in .env.
# HEROKU_API_KEY=

# Grade import memory guard
# Default is 800 MB. Set 0 to disable only for controlled debugging.
GRADE_IMPORT_MEMORY_LIMIT_MB=800

# PDF and composite report tuning
# WKHTMLTOPDF_PATH=/usr/local/bin/wkhtmltopdf
WKHTMLTOPDF_ZOOM=1.0
WKHTMLTOPDF_DPI=192
COMPOSITE_REPORT_MAX_EVIDENCE_HISTORY=5
COMPOSITE_REPORT_CACHE_MAX_ENTRIES=50
COMPOSITE_REPORT_CACHE_MAX_BYTES=262144000

# Local/QA feature flags
# ENABLE_ROLE_SWITCH should stay off in production unless a temporary QA session needs it.
# ENABLE_ROLE_SWITCH=1

# Seeding and test helpers
# SEED_DEMO_DATA defaults on outside production and off in production.
# SEED_DEMO_DATA=0
# QUIET_SEEDS=1
# COVERAGE=1
# LOAD_SEEDS=true
# SKIP_TEST_DB_CLEAN=1
# SKIP_TAILWIND_BUILD=1
# PARALLEL_WORKERS=1
