# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Local Docker overrides.
/docker-compose.override.yml

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
/db/*.sqlite3
/db/*.sqlite3-*

# Additional tmp artifacts created by tests or tooling.
/tmp/cache
/tmp/screenshots/
*.tmp
*.bak
*.orig

# Rails asset pipeline output (generated during deployment)
/public/assets

# Heroku build artifacts
/Aptfile.lock
/slugignore.generated

# Local bundler installs (should not be committed)
/vendor/bundle/
/vendor/cache/

# Front-end build outputs
/app/assets/builds/*
!/app/assets/builds/
!/app/assets/builds/.keep
/app/javascript/packs/
/node_modules/

# Build pack / deployment helpers
/.apt

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore test coverage reports
/coverage/
doc/
.yardoc/

# Editor and OS cruft
.DS_Store
Thumbs.db
desktop.ini
/.idea/
/.vscode/
/.ruby-lsp/
/.byebug_history

# Local AI assistant state. Repo skills are intentionally commit-able.
/.codex/*
!/.codex/skills/
!/.codex/skills/**
/.claude/*
!/.claude/skills/
!/.claude/skills/**
/.cursor/
/.windsurf/

# Development CA certificates (environment-specific)
mkcert_development_CA_*.crt
!mkcert_development_CA_placeholder.crt

.copilot-instructions.md

MHA-Survey-Portal.wiki/

# Generated grade import sample runs; keep canonical sample files only.
/local_import_samples/folder_run_samples/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_*.xlsx
